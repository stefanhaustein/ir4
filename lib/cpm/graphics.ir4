\ cpm/graphics.ir4 - CP/M VT52 ASCII brightness graphics (80x24, 8 shades)

require "memory.ir4"
require "terminal.ir4"

data __cpm_ramp
  " .:+*%#@"
end

var __cpm_modes :bytes 8
var __cpm_fb :bytes 2048
var __cpm_w :i
var __cpm_h :i
var __cpm_col :i

init
  7 -> __cpm_col
end

fn gfxmodes ( -> :a :i )
  0 __cpm_modes i16!
  termwidth __cpm_modes 2 a+ i16!
  termheight __cpm_modes 4 a+ i16!
  3 __cpm_modes 6 a+ i16!
  __cpm_modes 1
end

fn gfxwidth ( -> :i ) __cpm_w end
fn gfxheight ( -> :i ) __cpm_h end
fn gfxdepth ( -> :i ) 3 end

fn gfxmode ( mode :i )
  mode drop
  termwidth -> __cpm_w
  termheight -> __cpm_h
  __cpm_fb 2048 0 memfill
  7 -> __cpm_col
  termclear
end

fn gfxdone ( )
  0 __cpm_h 1 - termgoto
  cr
end

fn gfxrgb ( r :i g :i b :i -> :i )
  r 1 << g 5 * + b + 8 u>> -> var lum :i
  lum 7 > if 7 -> lum then
  lum
end

fn gfxcolor ( c :i )
  c 7 and -> __cpm_col
end

fn gfxpx ( x :i y :i )
  x 0 < x __cpm_w >= or y 0 < y __cpm_h >= or or if return then
  y __cpm_w * x + -> var idx :i
  idx 2048 < if __cpm_col __cpm_fb idx a+ i8! then
  x y termgoto
  __cpm_ramp __cpm_col a+ u8@ emit
end

fn gfxgetpx ( x :i y :i -> :i )
  x 0 < x __cpm_w >= or y 0 < y __cpm_h >= or or if -1 return then
  y __cpm_w * x + -> var idx :i
  idx 2048 >= if -1 return then
  __cpm_fb idx a+ u8@
end

fn gfxhline ( x :i y :i w :i )
  y 0 < y __cpm_h >= or if return then
  x 0 < if x +-> w 0 -> x then
  x w + __cpm_w > if __cpm_w x - -> w then
  w 0 <= if return then
  y __cpm_w * x + -> var idx :i
  idx w + 2048 <= if __cpm_fb idx a+ w __cpm_col memfill then
  __cpm_ramp __cpm_col a+ u8@ -> var ch :i
  x y termgoto
  begin w 0 > while
    ch emit
    -1 +-> w
  repeat
end

fn gfxclear ( )
  __cpm_fb 2048 0 memfill
  termclear
end

fn gfxcharw ( -> :i ) 1 end
fn gfxcharh ( -> :i ) 1 end

\ Snaps (*x*, *y*) to VT52 character cell (`x, y`) via `type`.
fn gfxtext ( x :i y :i s :a len :i )
  x y termgoto
  s len type
end
