\ memory.ir4 - Portable byte-slice memory operations

\ Fill *len* bytes starting at *dst* with byte value *val*
default fn memfill ( dst :a len :i val :i )
  begin
    len 0 >
  while
    val dst i8!
    1 +-> dst
    -1 +-> len
  repeat
end

\ Copy *len* bytes from *src* to *dst* (overlap-safe)
default fn memcpy ( dst :a src :a len :i )
  dst src a> if
    len +-> dst
    len +-> src
    begin
      len 0 >
    while
      src 1 a- -> src
      dst 1 a- -> dst
      src u8@ dst i8!
      -1 +-> len
    repeat
    return
  then
  begin
    len 0 >
  while
    src u8@ dst i8!
    1 +-> src
    1 +-> dst
    -1 +-> len
  repeat
end

\ Compare *len* bytes at *a* and *b*; returns first nonzero (*a*[i] - *b*[i]) or 0 if equal
default fn memcmp ( a :a b :a len :i -> :i )
  begin
    len 0 >
  while
    a u8@ b u8@ - -> var d :i
    d 0 <> if d return then
    1 +-> a
    1 +-> b
    -1 +-> len
  repeat
  0
end
