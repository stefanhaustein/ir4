\ graphics.ir4 - Pixel graphics (default: ANSI 16-color VGA / 256-color UTF-8 half-block backend)
\ Platform overrides implement the `default fn` entries below.

require "terminal.ir4"
require "memory.ir4"
require "heap.ir4"

var __gfx_def_modes :bytes 16
var __gfx_w :i
var __gfx_h :i
var __gfx_col :i
var __gfx_depth :i
var __gfx_fb :a

init
  0 -> __gfx_w
  0 -> __gfx_h
  15 -> __gfx_col
  4 -> __gfx_depth
  0 i>a -> __gfx_fb
end

\ Returns (addr, count) of :i16 4-tuples: (mode, width, height, depth_bpp)
default fn gfxmodes ( -> :a :i )
  0 __gfx_def_modes i16!
  termwidth __gfx_def_modes 2 a+ i16!
  termheight 1 << __gfx_def_modes 4 a+ i16!
  4 __gfx_def_modes 6 a+ i16!
  1 __gfx_def_modes 8 a+ i16!
  termwidth __gfx_def_modes 10 a+ i16!
  termheight 1 << __gfx_def_modes 12 a+ i16!
  8 __gfx_def_modes 14 a+ i16!
  __gfx_def_modes 2
end

\ Current graphics screen width in pixels
default fn gfxwidth ( -> :i ) __gfx_w end

\ Current graphics screen height in pixels
default fn gfxheight ( -> :i ) __gfx_h end

\ Per-pixel color depth in bits (1 on attribute-cell targets like C64/Spectrum, where gfxrgb may still return palette colors per cell)
default fn gfxdepth ( -> :i ) __gfx_depth end

\ Wait for vertical blank / next frame sync (default: no-op)
default fn gfxvsync ( ) end

\ Return platform tick counter (wraps monotonically; default: 0)
default fn gfxticks ( -> :i ) 0 end

\ Switch to graphics mode index *mode* (default: 0 = 16-color ANSI/VGA, 1 = 256-color xterm half-block)
default fn gfxmode ( mode :i )
  mode 1 = if 8 else 4 then -> __gfx_depth
  termwidth -> __gfx_w
  termheight 1 << -> __gfx_h
  __gfx_fb 0 i>a a<> if __gfx_fb heapfree then
  __gfx_w termheight * -> var cells :i
  __gfx_depth 8 = if
    cells 1 << heapalloc -> __gfx_fb
    __gfx_fb cells 1 << 16 memfill
    231 -> __gfx_col
  else
    cells heapalloc -> __gfx_fb
    __gfx_fb cells 0 memfill
    15 -> __gfx_col
  then
  termclear
end

\ Restore text mode and release graphics resources
default fn gfxdone ( )
  __gfx_fb 0 i>a a<> if
    __gfx_fb heapfree
    0 i>a -> __gfx_fb
  then
  27 emit 91 emit 48 emit 109 emit
  0 termheight 1 - termgoto
  cr
end

\ Enter best-matching mode from gfxmodes for (*w*, *h*, *depth*); (0, 0, 0) selects entry 0
default fn gfxinit ( w :i h :i depth :i )
  gfxmodes -> var cnt :i -> var tbl :a
  cnt 0 <= if 0 gfxmode return then
  tbl i16@ -> var best_mode :i
  w 0 = h 0 = and depth 0 = and if best_mode gfxmode return then
  32767 -> var best_score :i
  tbl -> var p :a
  begin cnt 0 > while
    p 2 a+ i16@ -> var mw :i
    p 4 a+ i16@ -> var mh :i
    p 6 a+ i16@ -> var md :i
    mw w - -> var dw :i  dw 0 < if 0 dw - -> dw then
    mh h - -> var dh :i  dh 0 < if 0 dh - -> dh then
    md depth - -> var dd :i  dd 0 < if 0 dd - -> dd then
    dw dh + dd 5 << + -> var score :i
    score best_score < if
      score -> best_score
      p i16@ -> best_mode
    then
    8 +-> p
    -1 +-> cnt
  repeat
  best_mode gfxmode
end

fn __gfx_cube6 ( v :i -> :i )
  v 48 < if 0 return then
  v 115 < if 1 return then
  v 35 - 40 /
end

\ Map 8-bit RGB (*r*, *g*, *b* in 0..255) to the platform's native color value for gfxcolor.
\ On attribute-cell targets (gfxdepth = 1), non-zero colors may still set per-cell attributes.
default fn gfxrgb ( r :i g :i b :i -> :i )
  r -> var mx :i  g mx > if g -> mx then  b mx > if b -> mx then
  r -> var mn :i  g mn < if g -> mn then  b mn < if b -> mn then
  __gfx_depth 8 = if
    mx mn - 16 < if
      r g + b + 3 / -> var v :i
      v 4 < if 16 return then
      v 246 > if 231 return then
      v 3 - 10 / 232 + return
    then
    16 r __gfx_cube6 36 * + g __gfx_cube6 6 * + b __gfx_cube6 + return
  then
  mx mn - 40 < if
    mx 42 < if 0 return then
    mx 110 < if 8 return then
    mx 224 < if 7 return then
    15 return
  then
  0 -> var c :i
  mx 1 u>> -> var thr :i
  r thr >= if c 1 or -> c then
  g thr >= if c 2 or -> c then
  b thr >= if c 4 or -> c then
  mx 192 >= if c 8 or -> c then
  c
end

\ Set current drawing color *c* (value returned by gfxrgb)
default fn gfxcolor ( c :i )
  __gfx_depth 8 = if c 255 and else c 15 and then -> __gfx_col
end

\ Set hardware border/overscan color *c* (value returned by gfxrgb; no-op if unsupported)
default fn gfxborder ( c :i ) end

fn __gfx_sgr_fg ( c :i )
  __gfx_depth 8 = if
    27 emit 91 emit 51 emit 56 emit 59 emit 53 emit 59 emit c typeu 109 emit
  else
    c termfg
  then
end

fn __gfx_sgr_bg ( c :i )
  __gfx_depth 8 = if
    27 emit 91 emit 52 emit 56 emit 59 emit 53 emit 59 emit c typeu 109 emit
  else
    c termbg
  then
end

fn __gfx_emit_cell ( cx :i cy :i top :i bot :i )
  cx cy termgoto
  top __gfx_sgr_fg
  bot __gfx_sgr_bg
  226 emit 150 emit 128 emit
end

\ Plot a pixel at (*x*, *y*) in the current drawing color
default fn gfxpx ( x :i y :i )
  x 0 < x __gfx_w >= or y 0 < y __gfx_h >= or or if return then
  y 1 u>> -> var row :i
  __gfx_depth 8 = if
    __gfx_fb row __gfx_w * x + 1 << a+ -> var cell :a
    y 1 and 0 = if __gfx_col cell i8! else __gfx_col cell 1 a+ i8! then
    x row cell u8@ cell 1 a+ u8@ __gfx_emit_cell
    return
  then
  __gfx_fb row __gfx_w * x + a+ -> cell
  cell u8@ -> var old :i
  0 -> var val :i
  y 1 and 0 = if
    old 15 and __gfx_col 4 << or -> val
  else
    old 240 and __gfx_col or -> val
  then
  val cell i8!
  x row val 4 u>> val 15 and __gfx_emit_cell
end

\ Read pixel color index at (*x*, *y*), or < 0 if out of bounds or unsupported
default fn gfxgetpx ( x :i y :i -> :i )
  x 0 < x __gfx_w >= or y 0 < y __gfx_h >= or or if -1 return then
  __gfx_fb 0 i>a a= if -1 return then
  y 1 u>> -> var row :i
  __gfx_depth 8 = if
    __gfx_fb row __gfx_w * x + 1 << a+ -> var cell :a
    y 1 and 0 = if cell u8@ else cell 1 a+ u8@ then
    return
  then
  __gfx_fb row __gfx_w * x + a+ u8@ -> var val :i
  y 1 and 0 = if val 4 u>> else val 15 and then
end

\ Draw a horizontal line of width *w* starting at (*x*, *y*) (default: gfxpx loop)
default fn gfxhline ( x :i y :i w :i )
  begin w 0 > while
    x y gfxpx
    1 +-> x
    -1 +-> w
  repeat
end

\ Draw a vertical line of height *h* starting at (*x*, *y*) (default: gfxpx loop)
default fn gfxvline ( x :i y :i h :i )
  begin h 0 > while
    x y gfxpx
    1 +-> y
    -1 +-> h
  repeat
end

\ Draw a line from (*x1*, *y1*) to (*x2*, *y2*) (default: Bresenham via gfxhline/gfxvline/gfxpx)
default fn gfxline ( x1 :i y1 :i x2 :i y2 :i )
  y1 y2 = if
    x1 x2 > if x2 y1 x1 x2 - 1 + else x1 y1 x2 x1 - 1 + then gfxhline return
  then
  x1 x2 = if
    y1 y2 > if x1 y2 y1 y2 - 1 + else x1 y1 y2 y1 - 1 + then gfxvline return
  then
  x2 x1 - -> var dx :i
  dx 0 < if 0 dx - -> dx then
  y2 y1 - -> var dy :i
  dy 0 < if 0 dy - -> dy then
  dx dy >= if
    x1 x2 > if
      x1 -> var tmp :i x2 -> x1 tmp -> x2
      y1 -> tmp y2 -> y1 tmp -> y2
    then
    y2 y1 < if -1 else 1 then -> var s :i
    dx 1 >> -> var err :i
    x1 -> var r :i
    x1 -> var p :i
    begin p x2 <= while
      err dy - -> err
      err 0 < if
        r y1 p r - 1 + gfxhline
        p 1 + -> r
        s +-> y1
        dx +-> err
      then
      1 +-> p
    repeat
    r x2 <= if r y1 x2 r - 1 + gfxhline then
  else
    y1 y2 > if
      x1 -> tmp x2 -> x1 tmp -> x2
      y1 -> tmp y2 -> y1 tmp -> y2
    then
    x2 x1 < if -1 else 1 then -> s
    dy 1 >> -> err
    y1 -> r
    y1 -> p
    begin p y2 <= while
      err dx - -> err
      err 0 < if
        x1 r p r - 1 + gfxvline
        p 1 + -> r
        s +-> x1
        dy +-> err
      then
      1 +-> p
    repeat
    r y2 <= if x1 r y2 r - 1 + gfxvline then
  then
end

\ Draw a rectangle outline at (*x*, *y*) with size *w* x *h*
default fn gfxrect ( x :i y :i w :i h :i )
  w 0 <= h 0 <= or if return then
  x y w gfxhline
  x y h + 1 - w gfxhline
  x y h gfxvline
  x w + 1 - y h gfxvline
end

\ Draw a filled rectangle at (*x*, *y*) with size *w* x *h* (default: gfxhline loop)
default fn gfxfillrect ( x :i y :i w :i h :i )
  w 0 <= h 0 <= or if return then
  y h + -> var ye :i
  begin y ye < while
    x y w gfxhline
    1 +-> y
  repeat
end

\ Clear the graphics screen to the current drawing color
default fn gfxclear ( )
  __gfx_w termheight * -> var cells :i
  __gfx_depth 8 = if
    __gfx_fb cells 1 << __gfx_col memfill
  else
    __gfx_fb cells __gfx_col 4 << __gfx_col or memfill
  then
  __gfx_col __gfx_sgr_bg
  termclear
end

\ Draw a circle outline of radius *r* centered at (*cx*, *cy*) using the midpoint algorithm
default fn gfxcircle ( cx :i cy :i r :i )
  r 0 < if return then
  r -> var x :i
  0 -> var y :i
  1 r - -> var err :i
  begin x y >= while
    cx x + cy y + gfxpx
    cx y + cy x + gfxpx
    cx y - cy x + gfxpx
    cx x - cy y + gfxpx
    cx x - cy y - gfxpx
    cx y - cy x - gfxpx
    cx y + cy x - gfxpx
    cx x + cy y - gfxpx
    1 +-> y
    err 0 < if
      err y 1 << + 1 + -> err
    else
      -1 +-> x
      err y x - 1 << + 1 + -> err
    then
  repeat
end

\ Character cell width in pixels (default: 1 in ANSI half-block mode)
default fn gfxcharw ( -> :i ) 1 end

\ Character cell height in pixels (default: 2 in ANSI half-block mode)
default fn gfxcharh ( -> :i ) 2 end

\ Draw *len* normalized-ASCII bytes starting at *s* with top-left at pixel (*x*, *y*) in the current drawing color.
\ Text-cell targets snap (*x*, *y*) to the nearest character cell (default: ANSI `x, y/2`).
default fn gfxtext ( x :i y :i s :a len :i )
  y 1 u>> -> var row :i
  row 0 < row termheight >= or if return then
  __gfx_col __gfx_sgr_fg
  -1 -> var last_bg :i
  0 -> var i :i
  begin i len < while
    x i + -> var cx :i
    cx 0 >= cx __gfx_w < and if
      __gfx_depth 8 = if
        __gfx_fb row __gfx_w * cx + 1 << y 1 and + a+ u8@
      else
        __gfx_fb row __gfx_w * cx + a+ u8@ y 1 and 0 = if 4 u>> else 15 and then
      then -> var bg :i
      bg last_bg <> if
        bg __gfx_sgr_bg
        bg -> last_bg
      then
      cx row termgoto
      s i a+ u8@ emit
    then
    1 +-> i
  repeat
end
