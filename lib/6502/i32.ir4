code 6502 i32<< ( a :i32 cnt :i -> :i32 )
  0xBD :i8 0 :as                \\   LDA STACK+0,X
  0xE8 :i8                      \\   INX
  0xE8 :i8                      \\   INX
  0x29 :i8 0x1F :i8             \\   AND #31
  0xF0 :i8 0x1C :i8             \\   BEQ done
  0xA8 :i8                      \\   TAY
                                \\ loop:
  0x1E :i8 0 :as                \\   ASL STACK+0,X
  0xBD :i8 1 :as                \\   LDA STACK+1,X
  0x2A :i8                      \\   ROL A
  0x9D :i8 1 :as                \\   STA STACK+1,X
  0xBD :i8 2 :as                \\   LDA STACK+2,X
  0x2A :i8                      \\   ROL A
  0x9D :i8 2 :as                \\   STA STACK+2,X
  0xBD :i8 3 :as                \\   LDA STACK+3,X
  0x2A :i8                      \\   ROL A
  0x9D :i8 3 :as                \\   STA STACK+3,X
  0x88 :i8                      \\   DEY
  0xD0 :i8 0xE5 :i8             \\   BNE loop
                                \\ done:
end \\ f4fb

