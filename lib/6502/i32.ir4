  0x29 :i8 0x1F :i8             \\   AND #31
  0xF0 :i8 0x10 :i8             \\   BEQ done
  0xA8 :i8                      \\   TAY
                                \\ loop:
  0x5E :i8 3 :as                \\   LSR STACK+3,X
  0x7E :i8 2 :as                \\   ROR STACK+2,X
  0x7E :i8 1 :as                \\   ROR STACK+1,X
  0x7E :i8 0 :as                \\   ROR STACK+0,X
  0x88 :i8                      \\   DEY
  0xD0 :i8 0xF1 :i8             \\   BNE loop
                                \\ done:
end \\ b028

