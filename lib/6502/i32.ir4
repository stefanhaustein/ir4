\ 6502 32-bit integer primitives for IR4th.
\ Preserves X (IR4th data stack pointer). Uses ZP $02..$10.

\\ A0 = $02
\\ A1 = $03
\\ A2 = $04
\\ A3 = $05
\\ B0 = $06
\\ B1 = $07
\\ B2 = $08
\\ B3 = $09
\\ R0 = $0A
\\ R1 = $0B
\\ R2 = $0C
\\ R3 = $0D
\\ T0 = $0E
\\ T1 = $0F
\\ T2 = $10

code 6502 i32* ( a :i32 b :i32 -> :i32 )
  0xBD :i8 0 :as                \\   LDA STACK+0,X
  0x85 :i8 0x06 :i8             \\   STA B0
  0xBD :i8 1 :as                \\   LDA STACK+1,X
  0x85 :i8 0x07 :i8             \\   STA B1
  0xBD :i8 2 :as                \\   LDA STACK+2,X
  0x85 :i8 0x08 :i8             \\   STA B2
  0xBD :i8 3 :as                \\   LDA STACK+3,X
  0x85 :i8 0x09 :i8             \\   STA B3
  0xE8 :i8                      \\   INX
  0xE8 :i8                      \\   INX
  0xE8 :i8                      \\   INX
  0xE8 :i8                      \\   INX
  0xBD :i8 0 :as                \\   LDA STACK+0,X
  0x85 :i8 0x02 :i8             \\   STA A0
  0xBD :i8 1 :as                \\   LDA STACK+1,X
  0x85 :i8 0x03 :i8             \\   STA A1
  0xBD :i8 2 :as                \\   LDA STACK+2,X
  0x85 :i8 0x04 :i8             \\   STA A2
  0xBD :i8 3 :as                \\   LDA STACK+3,X
  0x85 :i8 0x05 :i8             \\   STA A3
  0xA9 :i8 0x00 :i8             \\   LDA #0
  0x85 :i8 0x0A :i8             \\   STA R0
  0x85 :i8 0x0B :i8             \\   STA R1
  0x85 :i8 0x0C :i8             \\   STA R2
  0x85 :i8 0x0D :i8             \\   STA R3
  0xA0 :i8 0x20 :i8             \\   LDY #32
                                \\ loop:
  0x46 :i8 0x09 :i8             \\   LSR B3
  0x66 :i8 0x08 :i8             \\   ROR B2
  0x66 :i8 0x07 :i8             \\   ROR B1
  0x66 :i8 0x06 :i8             \\   ROR B0
  0x90 :i8 0x19 :i8             \\   BCC noadd
  0x18 :i8                      \\   CLC
  0xA5 :i8 0x0A :i8             \\   LDA R0
  0x65 :i8 0x02 :i8             \\   ADC A0
  0x85 :i8 0x0A :i8             \\   STA R0
  0xA5 :i8 0x0B :i8             \\   LDA R1
  0x65 :i8 0x03 :i8             \\   ADC A1
  0x85 :i8 0x0B :i8             \\   STA R1
  0xA5 :i8 0x0C :i8             \\   LDA R2
  0x65 :i8 0x04 :i8             \\   ADC A2
  0x85 :i8 0x0C :i8             \\   STA R2
  0xA5 :i8 0x0D :i8             \\   LDA R3
  0x65 :i8 0x05 :i8             \\   ADC A3
  0x85 :i8 0x0D :i8             \\   STA R3
                                \\ noadd:
  0x06 :i8 0x02 :i8             \\   ASL A0
  0x26 :i8 0x03 :i8             \\   ROL A1
  0x26 :i8 0x04 :i8             \\   ROL A2
  0x26 :i8 0x05 :i8             \\   ROL A3
  0x88 :i8                      \\   DEY
  0xD0 :i8 0xD2 :i8             \\   BNE loop
  0xA5 :i8 0x0A :i8             \\   LDA R0
  0x9D :i8 0 :as                \\   STA STACK+0,X
  0xA5 :i8 0x0B :i8             \\   LDA R1
  0x9D :i8 1 :as                \\   STA STACK+1,X
  0xA5 :i8 0x0C :i8             \\   LDA R2
  0x9D :i8 2 :as                \\   STA STACK+2,X
  0xA5 :i8 0x0D :i8             \\   LDA R3
  0x9D :i8 3 :as                \\   STA STACK+3,X
end \\ 4c22

