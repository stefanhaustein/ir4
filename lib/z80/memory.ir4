\ Z80 memory primitives for IR4th.
\ Uses IY for return address; zero relocations.

code z80 memfill ( dst :a len :i val :i )
  0xFD :i8 0xE1 :i8             \\   POP IY
  0xD1 :i8                      \\   POP DE              ; E = val
  0xC1 :i8                      \\   POP BC              ; BC = len
  0xE1 :i8                      \\   POP HL              ; HL = dst
  0xCB :i8 0x78 :i8             \\   BIT 7, B
  0x20 :i8 0x0F :i8             \\   JR NZ, fill_done
  0x78 :i8                      \\   LD A, B
  0xB1 :i8                      \\   OR C
  0x28 :i8 0x0B :i8             \\   JR Z, fill_done
  0x73 :i8                      \\   LD (HL), E
  0x0B :i8                      \\   DEC BC
  0x78 :i8                      \\   LD A, B
  0xB1 :i8                      \\   OR C
  0x28 :i8 0x05 :i8             \\   JR Z, fill_done
  0x54 :i8                      \\   LD D, H
  0x5D :i8                      \\   LD E, L
  0x13 :i8                      \\   INC DE
  0xED :i8 0xB0 :i8             \\   LDIR
                                \\ fill_done:
  0xFD :i8 0xE9 :i8             \\   JP (IY)
end \\ 5f51

code z80 memcpy ( dst :a src :a len :i )
  0xFD :i8 0xE1 :i8             \\   POP IY
  0xC1 :i8                      \\   POP BC              ; BC = len
  0xE1 :i8                      \\   POP HL              ; HL = src
  0xD1 :i8                      \\   POP DE              ; DE = dst
  0xCB :i8 0x78 :i8             \\   BIT 7, B
  0x20 :i8 0x17 :i8             \\   JR NZ, copy_done
  0x78 :i8                      \\   LD A, B
  0xB1 :i8                      \\   OR C
  0x28 :i8 0x13 :i8             \\   JR Z, copy_done
  0xB7 :i8                      \\   OR A
  0xE5 :i8                      \\   PUSH HL
  0xED :i8 0x52 :i8             \\   SBC HL, DE          ; src - dst; C set if dst > src
  0xE1 :i8                      \\   POP HL
  0x30 :i8 0x0A :i8             \\   JR NC, copy_fwd
  0x09 :i8                      \\   ADD HL, BC
  0x2B :i8                      \\   DEC HL
  0xEB :i8                      \\   EX DE, HL
  0x09 :i8                      \\   ADD HL, BC
  0x2B :i8                      \\   DEC HL
  0xEB :i8                      \\   EX DE, HL
  0xED :i8 0xB8 :i8             \\   LDDR
  0xFD :i8 0xE9 :i8             \\   JP (IY)
                                \\ copy_fwd:
  0xED :i8 0xB0 :i8             \\   LDIR
                                \\ copy_done:
  0xFD :i8 0xE9 :i8             \\   JP (IY)
end \\ 282f

code z80 memcmp ( a :a b :a len :i -> :i )
  0xFD :i8 0xE1 :i8             \\   POP IY
  0xC1 :i8                      \\   POP BC              ; BC = len
  0xD1 :i8                      \\   POP DE              ; DE = b
  0xE1 :i8                      \\   POP HL              ; HL = a
  0xCB :i8 0x78 :i8             \\   BIT 7, B
  0x20 :i8 0x0F :i8             \\   JR NZ, cmp_zero
  0x78 :i8                      \\   LD A, B
  0xB1 :i8                      \\   OR C
  0x28 :i8 0x0B :i8             \\   JR Z, cmp_zero
                                \\ cmp_loop:
  0x1A :i8                      \\   LD A, (DE)
  0xBE :i8                      \\   CP (HL)
  0x20 :i8 0x0D :i8             \\   JR NZ, cmp_diff
  0x23 :i8                      \\   INC HL
  0x13 :i8                      \\   INC DE
  0x0B :i8                      \\   DEC BC
  0x78 :i8                      \\   LD A, B
  0xB1 :i8                      \\   OR C
  0x20 :i8 0xF5 :i8             \\   JR NZ, cmp_loop
                                \\ cmp_zero:
  0x21 :i8 0x00 :i8 0x00 :i8    \\   LD HL, 0
  0xE5 :i8                      \\   PUSH HL
  0xFD :i8 0xE9 :i8             \\   JP (IY)
                                \\ cmp_diff:
  0x7E :i8                      \\   LD A, (HL)
  0xEB :i8                      \\   EX DE, HL
  0x96 :i8                      \\   SUB (HL)            ; A = *a - *b, C set if *a < *b
  0x6F :i8                      \\   LD L, A
  0x9F :i8                      \\   SBC A, A            ; 0xFF if *a < *b, else 0x00
  0x67 :i8                      \\   LD H, A
  0xE5 :i8                      \\   PUSH HL
  0xFD :i8 0xE9 :i8             \\   JP (IY)
end \\ 20e9
