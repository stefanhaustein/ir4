\ Z80 32-bit integer primitives for IR4th.
\ Uses SP/IX/IY stack scratch (zero relocations).

code z80 i32* ( a :i32 b :i32 -> :i32 )
  0xFD :i8 0xE1 :i8                    \\   POP IY
  0x21 :i8 0x00 :i8 0x00 :i8           \\   LD HL, 0
  0xE5 :i8                             \\   PUSH HL
  0xE5 :i8                             \\   PUSH HL
  0xDD :i8 0x21 :i8 0x00 :i8 0x00 :i8  \\   LD IX, 0
  0xDD :i8 0x39 :i8                    \\   ADD IX, SP
  0x06 :i8 0x20 :i8                    \\   LD B, 32
                                       \\ mul_loop:
  0xDD :i8 0xCB :i8 0x07 :i8 0x3E :i8  \\   SRL (IX+7)
  0xDD :i8 0xCB :i8 0x06 :i8 0x1E :i8  \\   RR (IX+6)
  0xDD :i8 0xCB :i8 0x05 :i8 0x1E :i8  \\   RR (IX+5)
  0xDD :i8 0xCB :i8 0x04 :i8 0x1E :i8  \\   RR (IX+4)
  0x30 :i8 0x24 :i8                    \\   JR NC, mul_noadd
  0xDD :i8 0x7E :i8 0x00 :i8           \\   LD A, (IX+0)
  0xDD :i8 0x86 :i8 0x08 :i8           \\   ADD A, (IX+8)
  0xDD :i8 0x77 :i8 0x00 :i8           \\   LD (IX+0), A
  0xDD :i8 0x7E :i8 0x01 :i8           \\   LD A, (IX+1)
  0xDD :i8 0x8E :i8 0x09 :i8           \\   ADC A, (IX+9)
  0xDD :i8 0x77 :i8 0x01 :i8           \\   LD (IX+1), A
  0xDD :i8 0x7E :i8 0x02 :i8           \\   LD A, (IX+2)
  0xDD :i8 0x8E :i8 0x0A :i8           \\   ADC A, (IX+10)
  0xDD :i8 0x77 :i8 0x02 :i8           \\   LD (IX+2), A
  0xDD :i8 0x7E :i8 0x03 :i8           \\   LD A, (IX+3)
  0xDD :i8 0x8E :i8 0x0B :i8           \\   ADC A, (IX+11)
  0xDD :i8 0x77 :i8 0x03 :i8           \\   LD (IX+3), A
                                       \\ mul_noadd:
  0xDD :i8 0xCB :i8 0x08 :i8 0x26 :i8  \\   SLA (IX+8)
  0xDD :i8 0xCB :i8 0x09 :i8 0x16 :i8  \\   RL (IX+9)
  0xDD :i8 0xCB :i8 0x0A :i8 0x16 :i8  \\   RL (IX+10)
  0xDD :i8 0xCB :i8 0x0B :i8 0x16 :i8  \\   RL (IX+11)
  0x10 :i8 0xB8 :i8                    \\   DJNZ mul_loop
  0xDD :i8 0x7E :i8 0x00 :i8           \\   LD A, (IX+0)
  0xDD :i8 0x77 :i8 0x08 :i8           \\   LD (IX+8), A
  0xDD :i8 0x7E :i8 0x01 :i8           \\   LD A, (IX+1)
  0xDD :i8 0x77 :i8 0x09 :i8           \\   LD (IX+9), A
  0xDD :i8 0x7E :i8 0x02 :i8           \\   LD A, (IX+2)
  0xDD :i8 0x77 :i8 0x0A :i8           \\   LD (IX+10), A
  0xDD :i8 0x7E :i8 0x03 :i8           \\   LD A, (IX+3)
  0xDD :i8 0x77 :i8 0x0B :i8           \\   LD (IX+11), A
  0x21 :i8 0x08 :i8 0x00 :i8           \\   LD HL, 8
  0x39 :i8                             \\   ADD HL, SP
  0xF9 :i8                             \\   LD SP, HL
  0xFD :i8 0xE9 :i8                    \\   JP (IY)
end \\ 1083

code z80 u32/ ( a :i32 b :i32 -> :i32 )
  0xFD :i8 0xE1 :i8                    \\   POP IY
  0x21 :i8 0x00 :i8 0x00 :i8           \\   LD HL, 0
  0xE5 :i8                             \\   PUSH HL
  0xE5 :i8                             \\   PUSH HL
  0xDD :i8 0x21 :i8 0x00 :i8 0x00 :i8  \\   LD IX, 0
  0xDD :i8 0x39 :i8                    \\   ADD IX, SP
  0x06 :i8 0x20 :i8                    \\   LD B, 32
                                       \\ udiv_loop:
  0xDD :i8 0xCB :i8 0x08 :i8 0x26 :i8  \\   SLA (IX+8)
  0xDD :i8 0xCB :i8 0x09 :i8 0x16 :i8  \\   RL (IX+9)
  0xDD :i8 0xCB :i8 0x0A :i8 0x16 :i8  \\   RL (IX+10)
  0xDD :i8 0xCB :i8 0x0B :i8 0x16 :i8  \\   RL (IX+11)
  0xDD :i8 0xCB :i8 0x00 :i8 0x16 :i8  \\   RL (IX+0)
  0xDD :i8 0xCB :i8 0x01 :i8 0x16 :i8  \\   RL (IX+1)
  0xDD :i8 0xCB :i8 0x02 :i8 0x16 :i8  \\   RL (IX+2)
  0xDD :i8 0xCB :i8 0x03 :i8 0x16 :i8  \\   RL (IX+3)
  0xB7 :i8                             \\   OR A
  0xDD :i8 0x7E :i8 0x00 :i8           \\   LD A, (IX+0)
  0xDD :i8 0x9E :i8 0x04 :i8           \\   SBC A, (IX+4)
  0x5F :i8                             \\   LD E, A
  0xDD :i8 0x7E :i8 0x01 :i8           \\   LD A, (IX+1)
  0xDD :i8 0x9E :i8 0x05 :i8           \\   SBC A, (IX+5)
  0x57 :i8                             \\   LD D, A
  0xDD :i8 0x7E :i8 0x02 :i8           \\   LD A, (IX+2)
  0xDD :i8 0x9E :i8 0x06 :i8           \\   SBC A, (IX+6)
  0x4F :i8                             \\   LD C, A
  0xDD :i8 0x7E :i8 0x03 :i8           \\   LD A, (IX+3)
  0xDD :i8 0x9E :i8 0x07 :i8           \\   SBC A, (IX+7)
  0x38 :i8 0x0F :i8                    \\   JR C, udiv_skip
  0xDD :i8 0x77 :i8 0x03 :i8           \\   LD (IX+3), A
  0xDD :i8 0x71 :i8 0x02 :i8           \\   LD (IX+2), C
  0xDD :i8 0x72 :i8 0x01 :i8           \\   LD (IX+1), D
  0xDD :i8 0x73 :i8 0x00 :i8           \\   LD (IX+0), E
  0xDD :i8 0x34 :i8 0x08 :i8           \\   INC (IX+8)
                                       \\ udiv_skip:
  0x10 :i8 0xB1 :i8                    \\   DJNZ udiv_loop
  0x21 :i8 0x08 :i8 0x00 :i8           \\   LD HL, 8
  0x39 :i8                             \\   ADD HL, SP
  0xF9 :i8                             \\   LD SP, HL
  0xFD :i8 0xE9 :i8                    \\   JP (IY)
end \\ ef58

