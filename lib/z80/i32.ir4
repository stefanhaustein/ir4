code z80 i32<< ( a :i32 cnt :i -> :i32 )
  0xFD :i8 0xE1 :i8                    \\   POP IY
  0xC1 :i8                             \\   POP BC
  0x79 :i8                             \\   LD A, C
  0xE6 :i8 0x1F :i8                    \\   AND 31
  0x28 :i8 0x19 :i8                    \\   JR Z, shl_done
  0x47 :i8                             \\   LD B, A
  0xDD :i8 0x21 :i8 0x00 :i8 0x00 :i8  \\   LD IX, 0
  0xDD :i8 0x39 :i8                    \\   ADD IX, SP
                                       \\ shl_loop:
  0xDD :i8 0xCB :i8 0x00 :i8 0x26 :i8  \\   SLA (IX+0)
  0xDD :i8 0xCB :i8 0x01 :i8 0x16 :i8  \\   RL (IX+1)
  0xDD :i8 0xCB :i8 0x02 :i8 0x16 :i8  \\   RL (IX+2)
  0xDD :i8 0xCB :i8 0x03 :i8 0x16 :i8  \\   RL (IX+3)
  0x10 :i8 0xEE :i8                    \\   DJNZ shl_loop
                                       \\ shl_done:
  0xFD :i8 0xE9 :i8                    \\   JP (IY)
end \\ 555f

