\ heap.ir4 - First-fit dynamic memory allocator starting at __heap_start

var __heap_ptr :a
var __heap_free :a

init
  __heap_start -> __heap_ptr
  0 i>a -> __heap_free
end

\ Reset the heap to empty (invalidates all prior allocations)
default fn heapreset ( )
  __heap_start -> __heap_ptr
  0 i>a -> __heap_free
end

\ Allocate at least *bytes* bytes on the heap; returns block address
default fn heapalloc ( bytes :i -> :a )
  __heap_ptr 0 i>a a= if __heap_start -> __heap_ptr then
  bytes 8 < if 8 -> bytes then
  bytes 7 + -8 and 8 + -> var need :i
  0 i>a -> var prev :a
  __heap_free -> var cur :a
  begin
    cur 0 i>a a<>
  while
    cur @ -> var bsz :i
    bsz need >= if
      cur 8 a+ a@ -> var nxt :a
      bsz need - -> var rem :i
      rem 16 >= if
        cur need a+ -> var split :a
        rem split !
        nxt split 8 a+ a!
        need cur !
        split -> nxt
      then
      prev 0 i>a a= if nxt -> __heap_free else nxt prev 8 a+ a! then
      cur 8 a+ return
    then
    cur -> prev
    cur 8 a+ a@ -> cur
  repeat
  __heap_ptr -> cur
  need cur !
  cur need a+ -> __heap_ptr
  cur 8 a+
end

\ Free block *p* previously returned by heapalloc (coalesces adjacent free blocks)
default fn heapfree ( p :a )
  p 0 i>a a= if return then
  p 8 a- -> var blk :a
  0 i>a -> var prev :a
  __heap_free -> var cur :a
  begin
    cur 0 i>a a<> if cur blk a< else 0 then
  while
    cur -> prev
    cur 8 a+ a@ -> cur
  repeat
  cur blk 8 a+ a!
  prev 0 i>a a= if blk -> __heap_free else blk prev 8 a+ a! then
  cur 0 i>a a<> if
    blk blk @ a+ cur a= if
      blk @ cur @ + blk !
      cur 8 a+ a@ blk 8 a+ a!
    then
  then
  prev 0 i>a a<> if
    prev prev @ a+ blk a= if
      prev @ blk @ + prev !
      blk 8 a+ a@ prev 8 a+ a!
    then
  then
end
