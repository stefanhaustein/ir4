\ c64/gfx.ir4 - Commodore 64 VIC-II Hires Bitmap (320x200) in VIC Bank 3 (`$C000-$FFFF`)
\
\ Memory layout:
\ - `$0801-$CBFF` (~49 KB): Unbroken Code + BSS + Heap + bfp frame stack (`ram_top = $CC00`)
\ - `$CC00-$CFE7` (1000 B): VIC Character RAM (foreground/background 8x8 color attributes)
\ - `$D000-$DFFF`: VIC / SID / CIA I/O
\ - `$E000-$FF3F` (8000 B): VIC Graphics RAM (underneath KERNAL ROM; CPU writes go to RAM,
\   reads use `__c64_peek_under` with `$01=$35` while IRQs are disabled)
\
\ **Color model:** gfxdepth returns 1 (1 bpp pixel density, so B/W-aware apps like mandel avoid clash),
\ while gfxrgb maps RGB to 8 C64 colors. Calling gfxcolor followed by gfxclear sets the
\ screen background color (`__c64_bg`), clears `$E000-$FF3F` to 0, and fills `$CC00-$CFE7`
\ with that background color in the low nibble. Drawing with gfxcolor = bg clears bitmap
\ bits (revealing the cell background without altering its foreground nibble); drawing with
\ gfxcolor <> bg sets bitmap bits and updates the 8x8 cell's foreground (high) nibble in
\ `$CC00` while preserving its background nibble (ZX Spectrum-style attribute clash).

require "mem.ir4"
require "stdio.ir4"

data __c64_modes
  0 :i16 320 :i16 200 :i16 1 :i16
end

data __c64_gfx_pal
  0 :i8 2 :i8 5 :i8 7 :i8 6 :i8 4 :i8 3 :i8 1 :i8
end

var __c64_col :i
var __c64_bg :i

\ Map RAM underneath KERNAL ROM ($E000-$FFFF) with IRQs disabled
hot code __c64_ram_on ( )
  0x78 :i8 0xA9 :i8 0x35 :i8 0x85 :i8 0x01 :i8
end

hot code __c64_ram_off ( )
  0xA9 :i8 0x36 :i8 0x85 :i8 0x01 :i8 0x58 :i8
end

\ Map Character ROM at $D000-$DFFF with IRQs disabled
hot code __c64_char_on ( )
  0x78 :i8 0xA9 :i8 0x32 :i8 0x85 :i8 0x01 :i8
end

fn gfxmodes ( -> :a :i )
  __c64_modes 1
end

fn gfxwidth ( -> :i ) 320 end
fn gfxheight ( -> :i ) 200 end
fn gfxdepth ( -> :i ) 1 end

fn gfxmode ( mode :i )
  mode drop
  1 -> __c64_col
  0 -> __c64_bg
  \ Select VIC bank 3 ($C000-$FFFF): CIA2 $DD00 bits 0..1 = 0
  56576 i>a u8@ 252 and 56576 i>a i8!
  \ Character RAM at $CC00 ($0C00 in bank), Graphics RAM at $E000 ($2000 in bank): $D018 = $38
  56 53272 i>a i8!
  \ Enable bitmap mode: $D011 = $3B
  59 53265 i>a i8!
end

fn gfxdone ( )
  \ Restore VIC bank 0, screen $0400 / char ROM $1000 ($D018 = $15), text mode ($D011 = $1B)
  56576 i>a u8@ 252 and 3 or 56576 i>a i8!
  21 53272 i>a i8!
  27 53265 i>a i8!
end

hot fn gfxvsync ( )
  begin 0xD011 i>a u8@ 128 and 0 <> while repeat
  begin 0xD011 i>a u8@ 128 and 0 = while repeat
end

hot fn gfxticks ( -> :i )
  0xA1 i>a u8@ 8 << 0xA2 i>a u8@ or
end

fn gfxrgb ( r :i g :i b :i -> :i )
  0 -> var idx :i
  r 128 >= if idx 1 or -> idx then
  g 128 >= if idx 2 or -> idx then
  b 128 >= if idx 4 or -> idx then
  idx 7 = r 224 < and g 224 < and b 224 < and if 15 return then
  __c64_gfx_pal idx a+ u8@
end

hot fn gfxcolor ( c :i )
  c 15 and -> __c64_col
end

fn gfxborder ( c :i )
  c 15 and 0xD020 i>a i8!
end

fn gfxclear ( )
  0xE000 i>a 8000 0 fillchar
  __c64_col 15 and -> __c64_bg
  0xCC00 i>a 1000 __c64_bg fillchar
end

hot fn gfxhline ( x :i y :i w :i )
  y 0 < y 200 >= or if return then
  x 0 < if x +-> w 0 -> x then
  x w + 320 > if 320 x - -> w then
  w 0 <= if return then
  y 3 u>> -> var row :i
  x 3 u>> -> var c0 :i
  x w + 1 - -> var x1 :i
  x1 3 u>> -> var c1 :i
  0xE000 i>a row 8 << row 6 << + c0 3 << + y 7 and + a+ -> var p :a
  255 x 7 and u>> -> var lmask :i
  255 7 x1 7 and - << 255 and -> var rmask :i
  __c64_ram_on
  __c64_col __c64_bg = if
    c0 c1 = if
      p u8@ lmask rmask and invert and p i8!
    else
      p u8@ lmask invert and p i8!
      8 +-> p
      c0 1 + -> var c :i
      begin c c1 < while
        0 p i8!
        8 +-> p
        1 +-> c
      repeat
      p u8@ rmask invert and p i8!
    then
  else
    0xCC00 i>a row 5 << row 3 << + c0 + a+ -> var cell :a
    __c64_col 4 << -> var fgnib :i
    c0 c1 = if
      p u8@ lmask rmask and or p i8!
      cell u8@ 15 and fgnib or cell i8!
    else
      p u8@ lmask or p i8!
      cell u8@ 15 and fgnib or cell i8!
      8 +-> p
      1 +-> cell
      c0 1 + -> c
      begin c c1 < while
        255 p i8!
        cell u8@ 15 and fgnib or cell i8!
        8 +-> p
        1 +-> cell
        1 +-> c
      repeat
      p u8@ rmask or p i8!
      cell u8@ 15 and fgnib or cell i8!
    then
  then
  __c64_ram_off
end

hot fn gfxpx ( x :i y :i )
  x 0 < x 320 >= or y 0 < y 200 >= or or if return then
  y 3 u>> -> var row :i
  x 3 u>> -> var col :i
  0xE000 i>a row 8 << row 6 << + col 3 << + y 7 and + a+ -> var p :a
  128 x 7 and u>> -> var mask :i
  __c64_ram_on
  __c64_col __c64_bg = if
    p u8@ mask invert and p i8!
  else
    p u8@ mask or p i8!
    0xCC00 i>a row 5 << row 3 << + col + a+ -> var cell :a
    cell u8@ 15 and __c64_col 4 << or cell i8!
  then
  __c64_ram_off
end

hot fn gfxvline ( x :i y :i h :i )
  x 0 < x 320 >= or if return then
  y 0 < if y +-> h 0 -> y then
  y h + 200 > if 200 y - -> h then
  h 0 <= if return then
  y 3 u>> -> var row :i
  x 3 u>> -> var col :i
  0xE000 i>a row 8 << row 6 << + col 3 << + y 7 and + a+ -> var p :a
  128 x 7 and u>> -> var mask :i
  __c64_ram_on
  __c64_col __c64_bg = if
    mask invert -> var nmask :i
    begin
      p u8@ nmask and p i8!
      -1 +-> h
      h 0 >
    while
      p a>i 7 and 7 = if 313 else 1 then +-> p
    repeat
  else
    0xCC00 i>a row 5 << row 3 << + col + a+ -> var cell :a
    __c64_col 4 << -> var fgnib :i
    cell u8@ 15 and fgnib or cell i8!
    begin
      p u8@ mask or p i8!
      -1 +-> h
      h 0 >
    while
      p a>i 7 and 7 = if
        313 +-> p
        40 +-> cell
        cell u8@ 15 and fgnib or cell i8!
      else
        1 +-> p
      then
    repeat
  then
  __c64_ram_off
end

\ Render 8 horizontal pixels (bits MSB..LSB) at arbitrary (x, y) in current gfxcolor
hot fn __c64_put8 ( x :i y :i bits :i )
  y 0 < y 200 >= or x -7 < or x 320 >= or bits 0 = or if return then
  y 3 u>> -> var row :i
  x 3 >> -> var col :i
  x 7 and -> var sh :i
  0xE000 i>a row 8 << row 6 << + y 7 and + a+ -> var pbase :a
  0xCC00 i>a row 5 << row 3 << + a+ -> var cbase :a
  bits sh u>> -> var b0 :i
  sh 0 > if bits 8 sh - << 255 and else 0 then -> var b1 :i
  __c64_ram_on
  __c64_col __c64_bg = if
    col 0 >= col 40 < and b0 0 <> and if
      pbase col 3 << a+ -> var p :a
      p u8@ b0 invert and p i8!
    then
    col 1 + -> col
    col 0 >= col 40 < and b1 0 <> and if
      pbase col 3 << a+ -> p
      p u8@ b1 invert and p i8!
    then
  else
    __c64_col 4 << -> var fgnib :i
    col 0 >= col 40 < and b0 0 <> and if
      pbase col 3 << a+ -> p
      p u8@ b0 or p i8!
      cbase col a+ -> var cell :a
      cell u8@ 15 and fgnib or cell i8!
    then
    col 1 + -> col
    col 0 >= col 40 < and b1 0 <> and if
      pbase col 3 << a+ -> p
      p u8@ b1 or p i8!
      cbase col a+ -> cell
      cell u8@ 15 and fgnib or cell i8!
    then
  then
  __c64_ram_off
end

fn gfxcharw ( -> :i ) 8 end
fn gfxcharh ( -> :i ) 8 end

fn __c64_ascii_to_sc ( c :i -> :i )
  c __c64_xlat -> var p :i
  p 64 < if p return then
  p 96 < if p 64 - return then
  p 160 >= p 192 < and if p 64 - return then
  p 192 >= p 224 < and if p 128 - return then
  p 31 and
end

\ Pixel-positioned 8x8 text from C64 Char ROM ($D800) using `xemit` ASCII mapping.
fn gfxtext ( x :i y :i s :a len :i )
  var buf :bytes 8
  begin
    len 0 >
  while
    s u8@ __c64_ascii_to_sc -> var sc :i
    0xD800 sc 3 << + -> var rom :i
    __c64_char_on
    0 -> var r :i
    begin r 8 < while
      rom r + i>a u8@ buf r a+ i8!
      1 +-> r
    repeat
    __c64_ram_off
    0 -> r
    begin r 8 < while
      x y r + buf r a+ u8@ __c64_put8
      1 +-> r
    repeat
    8 +-> x
    1 +-> s
    -1 +-> len
  repeat
end
