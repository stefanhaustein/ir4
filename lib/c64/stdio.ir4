\ lib/c64/stdio.ir4 - Commodore 64 KERNAL console I/O (`$FFD2` / `$FFE4`)

extern emit 0xFFD2 ( A :i )
extern __c64_inkey 0xFFE4 ( -> A :i )

fn inkey ( -> :i ) __c64_inkey end

fn key ( -> :i )
  0 -> var c :i
  begin
    inkey -> c
    c 0 =
  while repeat
  c
end

\ Maps PETSCII input (in Lowercase/Uppercase mode) to normalized ASCII (unshifted a-z, shifted A-Z).
fn xinkey ( -> :i )
  inkey -> var c :i
  c 0 = if 0 return then
  c 65 >= c 90 <= and if c 32 + return then
  c 193 >= c 218 <= and if c 128 - return then
  c 20 = if 8 return then
  c
end

\ Blocking read using xinkey.
fn xkey ( -> :i )
  0 -> var c :i
  begin
    xinkey -> c
    c 0 =
  while repeat
  c
end

var __c64_charset :i

init
  0 -> __c64_charset
end

\ Switch between `charset_native` (`0`, `142 emit`) and `charset_text` (`1`, `14 emit`).
fn setcharset ( mode :i )
  mode 1 = if
    1 -> __c64_charset
    14 emit
  else
    0 -> __c64_charset
    142 emit
  then
end

fn getcharset ( -> :i )
  __c64_charset
end

\ Map normalized ASCII to PETSCII (Lowercase/Uppercase mode: A-Z, a-z, _, |).
fn __c64_xlat ( c :i -> :i )
  c 65 >= c 90 <= and if c 128 + return then
  c 97 >= c 122 <= and if c 32 - return then
  c 0x5F = if 0xA4 return then
  c 0x7C = if 0xDD return then
  c
end

\ Maps ASCII to PETSCII (`charset_text`: mixed case; `charset_native`: folds `a..z` to uppercase) and clears quote mode (`$D4`) after `"`.
fn xemit ( c :i )
  c 10 = c 13 = or if 13 emit return then
  c 8 = if 20 emit return then
  c 32 < c 126 > or if return then
  __c64_charset 0 = c 65 >= and c 90 <= and if
    c emit
  else
    c __c64_xlat emit
  then
  c 34 = if 0 212 i>a i8! then
end
