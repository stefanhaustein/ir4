\ lib/c64/sprite.ir4 - Commodore 64 VIC-II hardware sprites (hires 24x21 or multicolor 12x21, 1x scale)

require "gfx.ir4"

var __c64_spr_vis :i
var __c64_img_mc  :bytes 48
var __c64_img_col :bytes 48

data __c64_spr_bit_tbl
  1 :i8 2 :i8 4 :i8 8 :i8 16 :i8 32 :i8 64 :i8 128 :i8
end

data __c64_spr_inv_tbl
  254 :i8 253 :i8 251 :i8 247 :i8 239 :i8 223 :i8 191 :i8 127 :i8
end

const sprcount 8
const sprdepth 2
const sprmaxw  24
const sprmaxh  21

fn __c64_spr_bit ( reg :i bit :i on :i )
  reg i>a -> var r :a
  r u8@ -> var v :i
  on 0 <> if v bit or else v bit 255 xor and then r i8!
end

\ Define sprite image `img` (0..47) in VIC Bank 3 ($C000 + img*64).
\ ncolors = 1 uses hires (24x21); ncolors >= 2 uses multicolor (12x21, 1->$D025, 2->$D027+hw, 3->$D026).
\ Pads any w < 24 or h < 21 with transparent pixels (0).
fn sprimg ( img :i w :i h :i data :a pal :a ncolors :i -> :i )
  img 0 < img 47 > or w 0 <= or h 0 <= or w 24 > or h 21 > or ncolors 0 < or if 0 return then
  0xC000 img 6 << + i>a -> var dst :a
  ncolors 1 = if
    0 __c64_img_mc img a+ i8!
    pal u8@ __c64_img_col img a+ i8!
    0 -> var sy :i
    begin sy 21 < while
      0 -> var b :i
      begin b 3 < while
        0 -> var byte :i
        0 -> var p :i
        begin p 8 < while
          b 3 << p + -> var x :i
          0 -> var pix :i
          x w < sy h < and if
            data sy w * x + a+ u8@ 0 <> if 1 -> pix then
          then
          byte 1 << pix or -> byte
          1 +-> p
        repeat
        byte dst i8!
        1 +-> dst
        1 +-> b
      repeat
      1 +-> sy
    repeat
  else
    1 __c64_img_mc img a+ i8!
    pal u8@ 0xD025 i>a i8!
    pal 1 a+ u8@ __c64_img_col img a+ i8!
    ncolors 3 >= if pal 2 a+ u8@ 0xD026 i>a i8! then
    0 -> sy
    begin sy 21 < while
      0 -> b
      begin b 3 < while
        0 -> byte
        0 -> p
        begin p 4 < while
          b 2 << p + 1 << -> x
          0 -> var code :i
          x w < sy h < and if
            data sy w * x + a+ u8@ -> var c :i
            c 3 > if 3 -> c then
            c -> code
          then
          byte 2 << code or -> byte
          1 +-> p
        repeat
        byte dst i8!
        1 +-> dst
        1 +-> b
      repeat
      1 +-> sy
    repeat
  then
  -1
end

fn sprset ( id :i img :i )
  id 0 < id 7 > or img 0 < or img 47 > or if return then
  __c64_spr_bit_tbl id a+ u8@ -> var bit :i
  0xD01D bit 0 __c64_spr_bit
  0xD017 bit 0 __c64_spr_bit
  0xD01C bit __c64_img_mc img a+ u8@ __c64_spr_bit
  __c64_img_col img a+ u8@ 0xD027 id + i>a i8!
  img 0xCFF8 id + i>a i8!
end

hot fn sprpos ( id :i x :i y :i )
  id 0 < id 7 > or if return then
  0xD000 id 1 << + i>a -> var reg :a
  x 24 + -> var sx :i
  sx reg i8!
  y 50 + reg 1 a+ i8!
  0xD010 i>a -> var msbreg :a
  msbreg u8@ -> var msb :i
  sx 255 > if
    msb __c64_spr_bit_tbl id a+ u8@ or
  else
    msb __c64_spr_inv_tbl id a+ u8@ and
  then
  msbreg i8!
end

fn sprshow ( id :i on :i )
  id 0 < id 7 > or if return then
  on 0 <> if
    __c64_spr_vis __c64_spr_bit_tbl id a+ u8@ or -> __c64_spr_vis
  else
    __c64_spr_vis __c64_spr_inv_tbl id a+ u8@ and -> __c64_spr_vis
  then
  __c64_spr_vis 0xD015 i>a i8!
end
