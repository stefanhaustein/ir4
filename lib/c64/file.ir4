\ __c64_open ( -> :i ) -> OPEN $FFC0 (0 ok, -1 on C=1)
code c64 __c64_open ( -> :i )
  0xCA :i8                      \\   DEX
  0xCA :i8                      \\   DEX
  0x8A :i8                      \\   TXA
  0x48 :i8                      \\   PHA
  0x20 :i8 0xC0 :i8 0xFF :i8    \\   JSR $FFC0
  0x68 :i8                      \\   PLA
  0xAA :i8                      \\   TAX
  0xB0 :i8 0x09 :i8             \\   BCS err
  0xA9 :i8 0x00 :i8             \\   LDA #$00
  0x9D :i8 0 :as                \\   STA STACK+0,X
  0x9D :i8 1 :as                \\   STA STACK+1,X
  0x60 :i8                      \\   RTS
                                \\ err:
  0xA9 :i8 0xFF :i8             \\   LDA #$FF
  0x9D :i8 0 :as                \\   STA STACK+0,X
  0x9D :i8 1 :as                \\   STA STACK+1,X
