  0x85 :i8 0xFC :i8             \\   STA $FC
  0xBD :i8 3 :as                \\   LDA STACK+3,X
  0xA8 :i8                      \\   TAY
  0xE8 :i8                      \\   INX
  0xE8 :i8                      \\   INX
  0xE8 :i8                      \\   INX
  0xE8 :i8                      \\   INX
  0x8A :i8                      \\   TXA
  0x48 :i8                      \\   PHA
  0xA6 :i8 0xFC :i8             \\   LDX $FC
  0xA5 :i8 0xFB :i8             \\   LDA $FB
  0x20 :i8 0xBD :i8 0xFF :i8    \\   JSR $FFBD
