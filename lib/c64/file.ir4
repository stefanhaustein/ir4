\ CBM 1541 DOS reports directory sizes in 254-byte blocks
const fsgranularity 254 :i

extern __c64_readst 0xFFB7 ( -> A :i )
extern __c64_close  0xFFC3 ( A :i )
extern __c64_clrchn 0xFFCC ( )
extern __c64_chrin  0xFFCF ( -> A :i )
