\ __c64_setlfs ( lfn :i dev :i sa :i ) -> SETLFS $FFBA (A=lfn, X=dev, Y=sa)
code c64 __c64_setlfs ( lfn :i dev :i sa :i )
  0xBD :i8 0 :as                \\   LDA STACK+0,X
  0xA8 :i8                      \\   TAY
  0xBD :i8 2 :as                \\   LDA STACK+2,X
  0x85 :i8 0xFC :i8             \\   STA $FC
  0xBD :i8 4 :as                \\   LDA STACK+4,X
  0x85 :i8 0xFB :i8             \\   STA $FB
  0xE8 :i8                      \\   INX
  0xE8 :i8                      \\   INX
  0xE8 :i8                      \\   INX
  0xE8 :i8                      \\   INX
  0xE8 :i8                      \\   INX
  0xE8 :i8                      \\   INX
  0x8A :i8                      \\   TXA
  0x48 :i8                      \\   PHA
  0xA6 :i8 0xFC :i8             \\   LDX $FC
  0xA5 :i8 0xFB :i8             \\   LDA $FB
  0x20 :i8 0xBA :i8 0xFF :i8    \\   JSR $FFBA
  0x68 :i8                      \\   PLA
  0xAA :i8                      \\   TAX
end \\ 76d9

