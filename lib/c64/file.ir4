\ 4 open file slots (LFNs 2..5, SA 2..5) + 1 directory slot (LFN 6, SA 0)
var __c64_fmode   :bytes 4
var __c64_feof    :bytes 4
var __c64_fpos    :bytes 16
var __c64_fsize   :bytes 16
var __c64_diropen :bytes 1
var __c64_cmdopen :bytes 1
var __c64_name    :bytes 64
var __c64_status  :bytes 48

fn __c64_to_petscii ( dst :a src :a len :i )
  0 -> var i :i
  begin i len < while
    src i a+ u8@ -> var c :i
    c 97 >= c 122 <= and if c 32 - -> c then
    c dst i a+ i8!
    1 +-> i
  repeat
end

fn __c64_ensure_cmd ( -> :i )
  __c64_cmdopen u8@ 0 <> if 0 return then
  15 8 15 __c64_setlfs
  0 i>a 0 __c64_setnam
  __c64_open 0 <> if -1 return then
  1 __c64_cmdopen i8!
  0
end

\ Send optional DOS command over persistent LFN 15 and read status code (0..99) or -1;
\ also stores comma-field #3 (e.g. scratch count) into scount if non-NULL
fn __c64_read_dos_status ( cmd :a clen :i scount :a -> :i )
  __c64_ensure_cmd 0 <> if -1 return then
  clen 0 > if
    15 __c64_ckout 0 <> if __c64_clrchn -1 return then
    0 -> var j :i
    begin j clen < while
      cmd j a+ u8@ __c64_chrout
      1 +-> j
    repeat
    13 __c64_chrout
    __c64_clrchn
  then
  15 __c64_chkin 0 <> if __c64_clrchn -1 return then
  0 -> var n :i
  1 -> var running :i
  begin running while
    __c64_chrin -> var ch :i
    __c64_readst -> var st :i
    ch 13 = st 191 and 0 <> or if
      0 -> running
    else
      n 47 < if
        ch __c64_status n a+ i8!
        1 +-> n
      then
      st 64 and 0 <> if 0 -> running then
    then
  repeat
  __c64_clrchn
  n 2 < if -1 return then
  __c64_status u8@ 48 - 10 * __c64_status 1 a+ u8@ 48 - + -> var code :i
  scount 0 i>a a<> if
    0 -> var commas :i
    0 -> var val :i
    0 -> var i :i
    begin i n < while
      __c64_status i a+ u8@ -> var c :i
      c 44 = if
        1 +-> commas
      else commas 2 = c 48 >= and c 57 <= and if
        val 10 * c 48 - + -> val
      then then
      1 +-> i
    repeat
    val scount !
  then
  code
end

fn __c64_dos_ok ( -> :i )
  0 i>a 0 0 i>a __c64_read_dos_status -> var code :i
  code 0 < code 20 >= or if -1 else 0 then
end

fn __c64_dos_cmd ( cmd :a clen :i -> :i )
  cmd clen 0 i>a __c64_read_dos_status -> var code :i
  code 0 < code 20 >= or if -1 else 0 then
end

fn __c64_blocks_to_bytes ( blk :i -> :i32 )
  blk 0 <= if 0 i>i32 return then
  blk i>i32 65535 i>i32 i32and 254 i>i32 i32*
end

\ Parse next CBM "$" directory entry from active CHKIN stream (LFN 6).
\ Returns (namelen, flags, size) or (0, 0, 0) on end or (-1, 0, 0) on error.
fn __c64_dir_next ( buf :a max :i -> :i :i :i32 )
  6 __c64_chkin 0 <> if __c64_clrchn -1 0 0 i>i32 return then
  begin
    -1
  while
    __c64_chrin -> var lo :i
    __c64_readst 131 and 0 <> if __c64_clrchn 0 0 0 i>i32 return then
    __c64_chrin -> var hi :i
    lo 0 = hi 0 = and if __c64_clrchn 0 0 0 i>i32 return then
    __c64_chrin -> var blo :i
    __c64_chrin -> var bhi :i
    blo bhi 8 << + -> var blocks :i
    0 -> var got_quote :i
    0 -> var is_hdr :i
    0 -> var nlen :i
    0 -> var overflow :i
    0 -> var flags :i
    0 -> var state :i
    begin
      __c64_chrin -> var c :i
      __c64_readst 195 and 0 <> c 0 = or -> var eol :i
      c 0 <> if
        state 0 = if
          c 18 = if 1 -> is_hdr then
          c 34 = if 1 -> got_quote 1 -> state then
        else state 1 = if
          c 34 = if
            2 -> state
          else
            nlen max < if
              c buf nlen a+ i8!
              1 +-> nlen
            else
              1 -> overflow
            then
          then
        else state 2 = if
          c 32 <> c 42 <> and if
            c 68 = if flags 1 or -> flags then
            3 -> state
          then
        else
          c 60 = if flags 2 or -> flags then
        then then then
      then
      eol 0 =
    while repeat
    is_hdr 0 = got_quote 0 <> and nlen 0 > and if
      __c64_clrchn
      overflow 0 <> if -1 0 0 i>i32 return then
      0 i>i32 -> var sz :i32
      flags 1 and 0 = if
        blocks __c64_blocks_to_bytes -> sz
      then
      nlen flags sz return
    then
  repeat
  __c64_clrchn
  0 0 0 i>i32
end

\ Look up byte size of single file via "$0:NAME"; returns size or 0 if not listed
fn __c64_lookup_size ( name :a nlen :i -> :i32 )
  nlen 1 < nlen 40 > or if 0 i>i32 return then
  36 __c64_name i8!
  48 __c64_name 1 a+ i8!
  58 __c64_name 2 a+ i8!
  __c64_name 3 a+ name nlen __c64_to_petscii
  7 8 0 __c64_setlfs
  __c64_name nlen 3 + __c64_setnam
  __c64_open 0 <> if 0 i>i32 return then
  7 __c64_chkin 0 <> if __c64_clrchn 7 __c64_close 0 i>i32 return then
  __c64_chrin drop
  __c64_chrin drop
  0 i>i32 -> var found_sz :i32
  begin
    __c64_chrin -> var lo :i
    __c64_readst 131 and 0 <> if
      0
    else
      __c64_chrin -> var hi :i
      lo 0 = hi 0 = and if
        0
      else
        __c64_chrin -> var blo :i
        __c64_chrin -> var bhi :i
        blo bhi 8 << + -> var blocks :i
        0 -> var is_hdr :i
        0 -> var got_q :i
        begin
          __c64_chrin -> var c :i
          c 18 = if 1 -> is_hdr then
          c 34 = if 1 -> got_q then
          c 0 <> __c64_readst 195 and 0 = and
        while repeat
        is_hdr 0 = got_q 0 <> and if
          blocks __c64_blocks_to_bytes -> found_sz
          0
        else
          1
        then
      then
    then
  while repeat
  __c64_clrchn
  7 __c64_close
  found_sz
end

fn __c64_open_lfn ( lfn :i path :a len :i suffix1 :i -> :i )
  len 1 < len 53 > or if -1 return then
  48 __c64_name i8!
  58 __c64_name 1 a+ i8!
  __c64_name 2 a+ path len __c64_to_petscii
