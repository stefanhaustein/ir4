fn fsopen ( path :a len :i mode :i -> :i )
  mode 0 < mode 2 > or len 1 < or len 53 > or if -1 return then
  0 -> var fd :i
  begin
    fd 4 < if __c64_fmode fd a+ u8@ 0 <> else false then
  while
    1 +-> fd
