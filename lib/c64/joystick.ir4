\ lib/c64/joystick.ir4 - Commodore 64 joystick ports (port 0 = CIA1 Port 2 `$DC00`, port 1 = Port 1 `$DC01`, port -1 = keyboard)

fn joycount ( -> :i ) 2 end

fn joystate ( port :i -> :i )
  port 0 = if 0xDC00 i>a u8@ 0x1F and 0x1F xor return then
  port 1 = if 0xDC01 i>a u8@ 0x1F and 0x1F xor return then
  port -1 = if
    0xCB i>a u8@ -> var k :i
    k 64 = if 0 return then
    k 9  = if 1 return then
    k 13 = if 2 return then
    k 10 = if 4 return then
    k 18 = if 8 return then
    k 60 = k 12 = or if 16 return then
    k 23 = if 32 return then
    k 1  = if 128 return then
  then
  0
end
