\ c64/graphics.ir4 - Commodore 64 VIC-II Hires Bitmap (320x200) in VIC Bank 3 (`$C000-$FFFF`)
\
\ Memory layout:
\ - `$0801-$CBFF` (~49 KB): Unbroken Code + BSS + Heap + bfp frame stack (`ram_top = $CC00`)
\ - `$CC00-$CFE7` (1000 B): VIC Character RAM (foreground/background 8x8 color attributes)
\ - `$D000-$DFFF`: VIC / SID / CIA I/O
\ - `$E000-$FF3F` (8000 B): VIC Graphics RAM (underneath KERNAL ROM; CPU writes go to RAM,
\   reads use `__c64_peek_under` with `$01=$35` while IRQs are disabled)
\
\ **Color model:** gfxdepth returns 1 (1 bpp pixel density, so B/W-aware apps like mandel avoid clash),
\ while gfxrgb maps RGB to 8 C64 colors. Calling gfxcolor followed by gfxclear sets the
\ screen background color (`__c64_bg`), clears `$E000-$FF3F` to 0, and fills `$CC00-$CFE7`
\ with that background color in the low nibble. Drawing with gfxcolor = bg clears bitmap
\ bits (revealing the cell background without altering its foreground nibble); drawing with
\ gfxcolor <> bg sets bitmap bits and updates the 8x8 cell's foreground (high) nibble in
\ `$CC00` while preserving its background nibble (ZX Spectrum-style attribute clash).

require "memory.ir4"
require "stdio.ir4"

data __c64_modes
  0 :i16 320 :i16 200 :i16 1 :i16
end

data __c64_gfx_pal
  0 :i8 2 :i8 5 :i8 7 :i8 6 :i8 4 :i8 3 :i8 1 :i8
end

var __c64_col :i
var __c64_bg :i

init
  1 -> __c64_col
end

\ Map RAM underneath KERNAL ROM ($E000-$FFFF) with IRQs disabled
hot code c64 __c64_ram_on ( )
  0x78 :i8 0xA9 :i8 0x35 :i8 0x85 :i8 0x01 :i8
end

hot code c64 __c64_ram_off ( )
  0xA9 :i8 0x36 :i8 0x85 :i8 0x01 :i8 0x58 :i8
end

\ Map Character ROM at $D000-$DFFF with IRQs disabled
hot code c64 __c64_char_on ( )
  0x78 :i8 0xA9 :i8 0x32 :i8 0x85 :i8 0x01 :i8
end

fn gfxmodes ( -> :a :i )
  __c64_modes 1
end

fn gfxwidth ( -> :i ) 320 end
fn gfxheight ( -> :i ) 200 end
fn gfxdepth ( -> :i ) 1 end

fn gfxmode ( mode :i )
  mode drop
  1 -> __c64_col
  0 -> __c64_bg
  \ Select VIC bank 3 ($C000-$FFFF): CIA2 $DD00 bits 0..1 = 0
  56576 i>a u8@ 252 and 56576 i>a i8!
  \ Character RAM at $CC00 ($0C00 in bank), Graphics RAM at $E000 ($2000 in bank): $D018 = $38
  56 53272 i>a i8!
  \ Enable bitmap mode: $D011 = $3B
  59 53265 i>a i8!
end

fn gfxdone ( )
  \ Restore VIC bank 0, screen $0400 / char ROM $1000 ($D018 = $15), text mode ($D011 = $1B)
  56576 i>a u8@ 252 and 3 or 56576 i>a i8!
  21 53272 i>a i8!
  27 53265 i>a i8!
end

hot fn gfxvsync ( )
  begin 0xD011 i>a u8@ 128 and 0 <> while repeat
  begin 0xD011 i>a u8@ 128 and 0 = while repeat
end

hot fn gfxticks ( -> :i )
  0xA1 i>a u8@ 8 << 0xA2 i>a u8@ or
end

fn gfxrgb ( r :i g :i b :i -> :i )
  0 -> var idx :i
  r 128 >= if idx 1 or -> idx then
  g 128 >= if idx 2 or -> idx then
  b 128 >= if idx 4 or -> idx then
  idx 7 = r 224 < and g 224 < and b 224 < and if 15 return then
  __c64_gfx_pal idx a+ u8@
end

hot fn gfxcolor ( c :i )
  c 15 and -> __c64_col
end

fn gfxborder ( c :i )
  c 15 and 0xD020 i>a i8!
end

fn gfxclear ( )
  0xE000 i>a 8000 0 memfill
  __c64_col 15 and -> __c64_bg
  0xCC00 i>a 1000 __c64_bg memfill
end

\ Clear cnt interior 8-pixel horizontal cells (*8 bytes apart) starting at p; returns updated p.
\ Preserves X; uses ZP $02..$03, $06.
code c64 __c64_hline_bg ( p :a cnt :i -> :a )
  0xBD :i8 1 :as 0x30 :i8 0x37 :i8   \ LDA 1,X; BMI pop_done
  0xD0 :i8 0x35 :i8                   \ BNE pop_done
  0xBD :i8 0 :as 0xF0 :i8 0x30 :i8    \ LDA 0,X; BEQ pop_done
  0x85 :i8 0x06 :i8                   \ STA $06 (cnt)
  0xE8 :i8 0xE8 :i8                   \ INX; INX
  0xBD :i8 0 :as 0x85 :i8 0x02 :i8    \ LDA 0,X; STA $02 (p_lo)
  0xBD :i8 1 :as 0x85 :i8 0x03 :i8    \ LDA 1,X; STA $03 (p_hi)
  0xA0 :i8 0x00 :i8                   \ LDY #0
  0xA9 :i8 0x00 :i8                   \ loop: LDA #0
  0x91 :i8 0x02 :i8                   \ STA ($02),Y
  0x98 :i8 0x18 :i8 0x69 :i8 0x08 :i8 \ TYA; CLC; ADC #8
  0xA8 :i8 0x90 :i8 0x02 :i8          \ TAY; BCC +2
  0xE6 :i8 0x03 :i8                   \ INC $03
  0xC6 :i8 0x06 :i8 0xD0 :i8 0xEF :i8 \ DEC $06; BNE loop
  0x18 :i8 0x98 :i8 0x65 :i8 0x02 :i8 \ CLC; TYA; ADC $02
  0x9D :i8 0 :as                      \ STA 0,X
  0xA5 :i8 0x03 :i8 0x69 :i8 0x00 :i8 \ LDA $03; ADC #0
  0x9D :i8 1 :as 0x60 :i8             \ STA 1,X; RTS
  0xE8 :i8 0xE8 :i8                   \ pop_done: INX; INX
end

\ Fill cnt interior 8-pixel horizontal cells ($FF bitmap + high-nibble color RAM); returns updated (p, cell).
\ Preserves X; uses ZP $02..$06, $08.
code c64 __c64_hline_fg ( p :a cell :a cnt :i fgnib :i -> :a :a )
  0xBD :i8 0 :as 0x85 :i8 0x08 :i8    \ LDA 0,X; STA $08 (fgnib)
  0xE8 :i8 0xE8 :i8                   \ INX; INX
  0xBD :i8 1 :as 0x30 :i8 0x57 :i8    \ LDA 1,X; BMI pop_done
  0xD0 :i8 0x55 :i8                   \ BNE pop_done
  0xBD :i8 0 :as 0xF0 :i8 0x50 :i8    \ LDA 0,X; BEQ pop_done
  0x85 :i8 0x06 :i8                   \ STA $06 (cnt)
  0xE8 :i8 0xE8 :i8                   \ INX; INX
  0xBD :i8 0 :as 0x85 :i8 0x04 :i8    \ LDA 0,X; STA $04 (cell_lo)
  0xBD :i8 1 :as 0x85 :i8 0x05 :i8    \ LDA 1,X; STA $05 (cell_hi)
  0xBD :i8 2 :as 0x85 :i8 0x02 :i8    \ LDA 2,X; STA $02 (p_lo)
  0xBD :i8 3 :as 0x85 :i8 0x03 :i8    \ LDA 3,X; STA $03 (p_hi)
  0xA0 :i8 0x00 :i8                   \ LDY #0
  0xA9 :i8 0xFF :i8 0x91 :i8 0x02 :i8 \ loop: LDA #$FF; STA ($02),Y
  0xB1 :i8 0x04 :i8 0x29 :i8 0x0F :i8 \ LDA ($04),Y; AND #$0F
  0x05 :i8 0x08 :i8 0x91 :i8 0x04 :i8 \ ORA $08; STA ($04),Y
  0x18 :i8 0xA5 :i8 0x02 :i8          \ CLC; LDA $02
  0x69 :i8 0x08 :i8 0x85 :i8 0x02 :i8 \ ADC #8; STA $02
  0x90 :i8 0x02 :i8 0xE6 :i8 0x03 :i8 \ BCC +2; INC $03
  0xE6 :i8 0x04 :i8 0xD0 :i8 0x02 :i8 \ INC $04; BNE +2
  0xE6 :i8 0x05 :i8                   \ INC $05
  0xC6 :i8 0x06 :i8 0xD0 :i8 0xDF :i8 \ DEC $06; BNE loop
  0xA5 :i8 0x04 :i8 0x9D :i8 0 :as    \ LDA $04; STA 0,X
  0xA5 :i8 0x05 :i8 0x9D :i8 1 :as    \ LDA $05; STA 1,X
  0xA5 :i8 0x02 :i8 0x9D :i8 2 :as    \ LDA $02; STA 2,X
  0xA5 :i8 0x03 :i8 0x9D :i8 3 :as    \ LDA $03; STA 3,X
  0x60 :i8                            \ RTS
  0xE8 :i8 0xE8 :i8                   \ pop_done: INX; INX
end

hot fn gfxhline ( x :i y :i w :i )
  y 0 < y 200 >= or if return then
  x 0 < if x +-> w 0 -> x then
  x w + 320 > if 320 x - -> w then
  w 0 <= if return then
  y 3 u>> -> var row :i
  x 3 u>> -> var c0 :i
  x w + 1 - -> var x1 :i
  x1 3 u>> -> var c1 :i
  0xE000 i>a row 8 << row 6 << + c0 3 << + y 7 and + a+ -> var p :a
  255 x 7 and u>> -> var lmask :i
  255 7 x1 7 and - << 255 and -> var rmask :i
  __c64_ram_on
  __c64_col __c64_bg = if
    c0 c1 = if
      p u8@ lmask rmask and invert and p i8!
    else
      p u8@ lmask invert and p i8!
      p 8 a+ c1 c0 - 1 - __c64_hline_bg -> p
      p u8@ rmask invert and p i8!
    then
  else
    0xCC00 i>a row 5 << row 3 << + c0 + a+ -> var cell :a
    __c64_col 4 << -> var fgnib :i
    c0 c1 = if
      p u8@ lmask rmask and or p i8!
      cell u8@ 15 and fgnib or cell i8!
    else
      p u8@ lmask or p i8!
      cell u8@ 15 and fgnib or cell i8!
      p 8 a+ cell 1 a+ c1 c0 - 1 - fgnib __c64_hline_fg -> cell -> p
      p u8@ rmask or p i8!
      cell u8@ 15 and fgnib or cell i8!
    then
  then
  __c64_ram_off
end

hot fn gfxpx ( x :i y :i )
  x 0 < x 320 >= or y 0 < y 200 >= or or if return then
  y 3 u>> -> var row :i
  x 3 u>> -> var col :i
  0xE000 i>a row 8 << row 6 << + col 3 << + y 7 and + a+ -> var p :a
  128 x 7 and u>> -> var mask :i
  __c64_ram_on
  __c64_col __c64_bg = if
    p u8@ mask invert and p i8!
  else
    p u8@ mask or p i8!
    0xCC00 i>a row 5 << row 3 << + col + a+ -> var cell :a
    cell u8@ 15 and __c64_col 4 << or cell i8!
  then
  __c64_ram_off
end

\ Read color index at (*x*, *y*): foreground nibble when bitmap bit is set, cell background nibble when clear; -1 if out of bounds.
hot fn gfxgetpx ( x :i y :i -> :i )
  x 0 < x 320 >= or y 0 < y 200 >= or or if -1 return then
  y 3 u>> -> var row :i
  x 3 u>> -> var col :i
  0xE000 i>a row 8 << row 6 << + col 3 << + y 7 and + a+ -> var p :a
  128 x 7 and u>> -> var mask :i
  __c64_ram_on
  p u8@ mask and -> var on :i
  0xCC00 i>a row 5 << row 3 << + col + a+ u8@ -> var attr :i
  __c64_ram_off
  on 0 <> if attr 4 u>> else attr 15 and then
end

\ Clear h vertical pixels starting at p with inverted bitmask nmask.
\ Preserves X; uses ZP $02..$04, $06, $08.
code c64 __c64_vline_bg ( p :a h :i nmask :i )
  0xBD :i8 0 :as 0x85 :i8 0x08 :i8    \ LDA 0,X; STA $08 (nmask)
  0xBD :i8 2 :as 0x85 :i8 0x06 :i8    \ LDA 2,X; STA $06 (h_lo)
  0xBD :i8 3 :as 0x85 :i8 0x03 :i8    \ LDA 3,X; STA $03 (h_hi)
  0xBD :i8 4 :as 0x85 :i8 0x02 :i8    \ LDA 4,X; STA $02 (p_lo)
  0xBD :i8 5 :as 0x85 :i8 0x04 :i8    \ LDA 5,X; STA $04 (p_hi)
  0x8A :i8 0x18 :i8 0x69 :i8 0x06 :i8 \ TXA; CLC; ADC #6
  0xAA :i8                            \ TAX
  0xA5 :i8 0x03 :i8 0x30 :i8 0x35 :i8 \ LDA $03; BMI done
  0xD0 :i8 0x33 :i8                   \ BNE done
  0xA5 :i8 0x06 :i8 0xF0 :i8 0x2F :i8 \ LDA $06; BEQ done
  0xA5 :i8 0x02 :i8 0x29 :i8 0x07 :i8 \ LDA $02; AND #$07
  0xA8 :i8                            \ TAY (y & 7)
  0xA5 :i8 0x02 :i8 0x29 :i8 0xF8 :i8 \ LDA $02; AND #$F8
  0x85 :i8 0x02 :i8                   \ STA $02 (cell bitmap base lo)
  0xA5 :i8 0x04 :i8 0x85 :i8 0x03 :i8 \ LDA $04; STA $03 (p_hi)
  0xB1 :i8 0x02 :i8 0x25 :i8 0x08 :i8 \ loop: LDA ($02),Y; AND $08
  0x91 :i8 0x02 :i8                   \ STA ($02),Y
  0xC6 :i8 0x06 :i8 0xF0 :i8 0x16 :i8 \ DEC $06; BEQ done
  0xC8 :i8 0xC0 :i8 0x08 :i8          \ INY; CPY #8
  0xD0 :i8 0xF1 :i8                   \ BNE loop
  0xA0 :i8 0x00 :i8                   \ LDY #0
  0x18 :i8 0xA5 :i8 0x02 :i8          \ CLC; LDA $02
  0x69 :i8 0x40 :i8 0x85 :i8 0x02 :i8 \ ADC #$40; STA $02
  0xA5 :i8 0x03 :i8 0x69 :i8 0x01 :i8 \ LDA $03; ADC #$01
  0x85 :i8 0x03 :i8 0xD0 :i8 0xE0 :i8 \ STA $03; BNE loop
end

\ Set h vertical pixels with bitmask mask and update color RAM high nibbles via cell.
\ Preserves X; uses ZP $02..$06, $08..$09.
code c64 __c64_vline_fg ( p :a cell :a h :i mask :i fgnib :i )
  0xBD :i8 0 :as 0x85 :i8 0x09 :i8    \ LDA 0,X; STA $09 (fgnib)
  0xBD :i8 2 :as 0x85 :i8 0x08 :i8    \ LDA 2,X; STA $08 (mask)
  0xBD :i8 4 :as 0x85 :i8 0x06 :i8    \ LDA 4,X; STA $06 (h_lo)
  0xBD :i8 5 :as 0x48 :i8             \ LDA 5,X; PHA (h_hi)
  0xBD :i8 6 :as 0x85 :i8 0x04 :i8    \ LDA 6,X; STA $04 (cell_lo)
  0xBD :i8 7 :as 0x85 :i8 0x05 :i8    \ LDA 7,X; STA $05 (cell_hi)
  0xBD :i8 8 :as 0x85 :i8 0x02 :i8    \ LDA 8,X; STA $02 (p_lo)
  0xBD :i8 9 :as 0x85 :i8 0x03 :i8    \ LDA 9,X; STA $03 (p_hi)
  0x8A :i8 0x18 :i8 0x69 :i8 0x0A :i8 \ TXA; CLC; ADC #10
  0xAA :i8 0x68 :i8                   \ TAX; PLA
  0x30 :i8 0x4F :i8 0xD0 :i8 0x4D :i8 \ BMI done; BNE done
  0xA5 :i8 0x06 :i8 0xF0 :i8 0x49 :i8 \ LDA $06; BEQ done
  0xA0 :i8 0x00 :i8                   \ LDY #0
  0xB1 :i8 0x04 :i8 0x29 :i8 0x0F :i8 \ LDA ($04),Y; AND #$0F
  0x05 :i8 0x09 :i8 0x91 :i8 0x04 :i8 \ ORA $09; STA ($04),Y
  0xA5 :i8 0x02 :i8 0x29 :i8 0x07 :i8 \ LDA $02; AND #$07
  0xA8 :i8                            \ TAY (y & 7)
  0xA5 :i8 0x02 :i8 0x29 :i8 0xF8 :i8 \ LDA $02; AND #$F8
  0x85 :i8 0x02 :i8                   \ STA $02 (cell bitmap base lo)
  0xB1 :i8 0x02 :i8 0x05 :i8 0x08 :i8 \ loop: LDA ($02),Y; ORA $08
  0x91 :i8 0x02 :i8                   \ STA ($02),Y
  0xC6 :i8 0x06 :i8 0xF0 :i8 0x2A :i8 \ DEC $06; BEQ done
  0xC8 :i8 0xC0 :i8 0x08 :i8          \ INY; CPY #8
  0xD0 :i8 0xF1 :i8                   \ BNE loop
  0xA0 :i8 0x00 :i8                   \ LDY #0
  0x18 :i8 0xA5 :i8 0x02 :i8          \ CLC; LDA $02
  0x69 :i8 0x40 :i8 0x85 :i8 0x02 :i8 \ ADC #$40; STA $02
  0xA5 :i8 0x03 :i8 0x69 :i8 0x01 :i8 \ LDA $03; ADC #$01
  0x85 :i8 0x03 :i8                   \ STA $03
  0x18 :i8 0xA5 :i8 0x04 :i8          \ CLC; LDA $04
  0x69 :i8 0x28 :i8 0x85 :i8 0x04 :i8 \ ADC #40; STA $04
  0x90 :i8 0x02 :i8 0xE6 :i8 0x05 :i8 \ BCC +2; INC $05
  0xB1 :i8 0x04 :i8 0x29 :i8 0x0F :i8 \ LDA ($04),Y; AND #$0F
  0x05 :i8 0x09 :i8 0x91 :i8 0x04 :i8 \ ORA $09; STA ($04),Y
  0xB8 :i8 0x50 :i8 0xCC :i8          \ CLV; BVC loop
end

hot fn gfxvline ( x :i y :i h :i )
  x 0 < x 320 >= or if return then
  y 0 < if y +-> h 0 -> y then
  y h + 200 > if 200 y - -> h then
  h 0 <= if return then
  y 3 u>> -> var row :i
  x 3 u>> -> var col :i
  0xE000 i>a row 8 << row 6 << + col 3 << + y 7 and + a+ -> var p :a
  128 x 7 and u>> -> var mask :i
  __c64_ram_on
  __c64_col __c64_bg = if
    p h mask invert __c64_vline_bg
  else
    0xCC00 i>a row 5 << row 3 << + col + a+ -> var cell :a
    p cell h mask __c64_col 4 << __c64_vline_fg
  then
  __c64_ram_off
end

\ Render 8 horizontal pixels (bits MSB..LSB) at arbitrary (x, y) in current gfxcolor
hot fn __c64_put8 ( x :i y :i bits :i )
  y 0 < y 200 >= or x -7 < or x 320 >= or bits 0 = or if return then
  y 3 u>> -> var row :i
  x 3 >> -> var col :i
  x 7 and -> var sh :i
  0xE000 i>a row 8 << row 6 << + y 7 and + a+ -> var pbase :a
  0xCC00 i>a row 5 << row 3 << + a+ -> var cbase :a
  bits sh u>> -> var b0 :i
  sh 0 > if bits 8 sh - << 255 and else 0 then -> var b1 :i
  __c64_ram_on
  __c64_col __c64_bg = if
    col 0 >= col 40 < and b0 0 <> and if
      pbase col 3 << a+ -> var p :a
      p u8@ b0 invert and p i8!
    then
    col 1 + -> col
    col 0 >= col 40 < and b1 0 <> and if
      pbase col 3 << a+ -> p
      p u8@ b1 invert and p i8!
    then
  else
    __c64_col 4 << -> var fgnib :i
    col 0 >= col 40 < and b0 0 <> and if
      pbase col 3 << a+ -> p
      p u8@ b0 or p i8!
      cbase col a+ -> var cell :a
      cell u8@ 15 and fgnib or cell i8!
    then
    col 1 + -> col
    col 0 >= col 40 < and b1 0 <> and if
      pbase col 3 << a+ -> p
      p u8@ b1 or p i8!
      cbase col a+ -> cell
      cell u8@ 15 and fgnib or cell i8!
    then
  then
  __c64_ram_off
end

fn gfxcharw ( -> :i ) 8 end
fn gfxcharh ( -> :i ) 8 end

fn __c64_ascii_to_sc ( c :i -> :i )
  c __c64_xlat -> var p :i
  p 64 < if p return then
  p 96 < if p 64 - return then
  p 160 >= p 192 < and if p 64 - return then
  p 192 >= p 224 < and if p 128 - return then
  p 31 and
end

\ Pixel-positioned 8x8 text from C64 Char ROM ($D800) using `xemit` ASCII mapping.
fn gfxtext ( x :i y :i s :a len :i )
  var buf :bytes 8
  begin
    len 0 >
  while
    s u8@ __c64_ascii_to_sc -> var sc :i
    0xD800 sc 3 << + -> var rom :i
    __c64_char_on
    0 -> var r :i
    begin r 8 < while
      rom r + i>a u8@ buf r a+ i8!
      1 +-> r
    repeat
    __c64_ram_off
    0 -> r
    begin r 8 < while
      x y r + buf r a+ u8@ __c64_put8
      1 +-> r
    repeat
    8 +-> x
    1 +-> s
    -1 +-> len
  repeat
end
