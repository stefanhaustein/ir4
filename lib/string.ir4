\ string.ir4 - String operations

\ Return length in bytes of NUL-terminated string *s0*
default fn strlen0 ( s0 :a -> :i )
  s0 -> var p :a
  begin p u8@ 0 <> while p 1 a+ -> p repeat
  p s0 adiff
end

\ Compare NUL-terminated strings *a0* and *b0*; returns first nonzero (*a0*[i] - *b0*[i]) or 0
default fn strcmp0 ( a0 :a b0 :a -> :i )
  var ca :i
  var cb :i
  begin
    a0 u8@ -> ca
    b0 u8@ -> cb
    ca 0 <> ca cb = and
  while
    a0 1 a+ -> a0
    b0 1 a+ -> b0
  repeat
  ca cb -
end

\ Unpack NUL-terminated string *s0* to (addr, len)
fn str0>str ( s0 :a -> :a :i )
  s0 s0 strlen0
end
