\ lib/sprite.ir4 - Hardware sprites (optional override per platform)

require "gfx.ir4"

\ Number of hardware sprite slots (0 = hardware sprites unsupported)
default const sprcount 0

\ Sprite color depth in bits per pixel (default: 0)
default const sprdepth 0

\ Maximum sprite width in pixels (default: 0)
default const sprmaxw 0

\ Maximum sprite height in pixels (default: 0)
default const sprmaxh 0

\ Define sprite image/frame *img* of screen size *w* x *h*.
\ *data* holds *w* * *h* unsigned bytes (0 = transparent, 1..*ncolors* = 1-based palette index).
\ *pal* holds *ncolors* unsigned bytes (color values returned by gfxrgb).
\ Returns -1 on success, 0 if unsupported or out of sprite resources.
default fn sprimg ( img :i w :i h :i data :a pal :a ncolors :i -> :i ) 0 end

\ Bind image *img* to hardware sprite *id* (sprite 0 has highest priority / renders in front; default: no-op).
default fn sprset ( id :i img :i ) end

\ Move sprite *id* to screen position (*x*, *y*) (default: no-op)
default fn sprpos ( id :i x :i y :i ) end

\ Show (*on* <> 0) or hide (*on* = 0) sprite *id* (default: no-op)
default fn sprshow ( id :i on :i ) end
