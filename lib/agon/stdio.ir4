\ agon/stdio.ir4 - Agon MOS console I/O (RST $10 = print char in A)
\ ADL mode: POP DE (ret), POP HL (c), PUSH DE, LD A, L, RST $10, RET

code agon emit ( c :i )
  0xD1 :i8 0xE1 :i8 0xD5 :i8 0x7D :i8 0x5B :i8 0xD7 :i8
end

\ Non-blocking read of next key event; returns (vkeycode << 8) | keyascii, or 0 if none.
\ Clears sysvar_vkeydown so each keypress is consumed once.
code agon inkey ( -> :i )
  0x3E :i8 0x08 :i8 0x5B :i8 0xCF :i8
  0xDD :i8 0x7E :i8 0x18 :i8
  0xB7 :i8 0x20 :i8 0x06 :i8
  0x21 :i8 0x00 :i8 0x00 :i8 0x00 :i8
  0x18 :i8 0x0E :i8
  0x21 :i8 0x00 :i8 0x00 :i8 0x00 :i8
  0xDD :i8 0x66 :i8 0x17 :i8
  0xDD :i8 0x6E :i8 0x05 :i8
  0xAF :i8
  0xDD :i8 0x77 :i8 0x18 :i8
  0xD1 :i8 0xE5 :i8 0xD5 :i8
end

\ Blocking read of next native key event: (vkeycode << 8) | keyascii.
fn key ( -> :i )
  0 -> var k :i
  begin
    inkey -> k
    k 0 =
  while repeat
  k
end

\ Non-blocking read of next key mapped to normalized ASCII (sysvar_keyascii; 0 for non-ASCII).
fn xinkey ( -> :i )
  inkey 255 and
end

\ Blocking read using xinkey.
fn xkey ( -> :i )
  0 -> var k :i
  begin
    xinkey -> k
    k 0 =
  while repeat
  k
end
