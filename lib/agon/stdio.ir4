\ agon/stdio.ir4 - Agon MOS console I/O (RST $10 = print char in A)
\ ADL mode: POP DE (ret), POP HL (c), PUSH DE, LD A, L, RST $10, RET

code agon emit ( c :i )
  0xD1 :i8 0xE1 :i8 0xD5 :i8 0x7D :i8 0x5B :i8 0xD7 :i8
end

code agon key ( -> :i )
  0xAF :i8 0x5B :i8 0xCF :i8 0xB7 :i8 0x28 :i8 0xFA :i8
  0x21 :i8 0x00 :i8 0x00 :i8 0x00 :i8 0x6F :i8
  0xD1 :i8 0xE5 :i8 0xD5 :i8
end

code agon inkey ( -> :i )
  0x3E :i8 0x08 :i8 0x5B :i8 0xCF :i8
  0xDD :i8 0x7E :i8 0x18 :i8
  0xB7 :i8 0x28 :i8 0x07 :i8
  0xDD :i8 0x7E :i8 0x05 :i8
  0xB7 :i8 0x20 :i8 0x01 :i8 0x3C :i8
  0x21 :i8 0x00 :i8 0x00 :i8 0x00 :i8 0x6F :i8
  0xD1 :i8 0xE5 :i8 0xD5 :i8
end

fn cls ( )
  12 emit
end

fn gotoxy ( x :i y :i )
  31 emit x emit y emit
end

fn fgcolor ( c :i )
  17 emit c emit
end

fn bgcolor ( c :i )
  17 emit c 128 + emit
end
