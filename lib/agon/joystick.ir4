\ lib/agon/joystick.ir4 - Agon Light keyboard-mapped joystick (via MOS $1E mos_getkbmap)

\ MOS $1E (mos_getkbmap) -> IXU = pointer to 32-byte live virtual key bitmap
code agon __agon_kbmap ( -> :a )
  0xDD :i8 0xE5 :i8             \\   PUSH IX
  0x3E :i8 0x1E :i8             \\   LD A, 0x1E
  0x5B :i8 0xCF :i8             \\   RST.LIL 0x08
  0xDD :i8 0xE5 :i8             \\   PUSH IX
  0xE1 :i8                      \\   POP HL
  0xDD :i8 0xE1 :i8             \\   POP IX
  0xD1 :i8                      \\   POP DE
  0xE5 :i8                      \\   PUSH HL
  0xD5 :i8                      \\   PUSH DE
end \\ acb7

fn __agon_key ( km :a vk :i -> :i )
  km vk 3 >> a+ u8@ 1 vk 7 and << and 0 <>
end

fn joycount ( -> :i ) 0 end

fn joystate ( port :i -> :i )
  port -1 <> if 0 return then
  __agon_kbmap -> var km :a
  km 0 i>a a= if 0 return then
  0 -> var st :i
  km 150 __agon_key km 44 __agon_key or km 70 __agon_key or if st 1 or -> st then
  km 152 __agon_key km 40 __agon_key or km 66 __agon_key or if st 2 or -> st then
  km 154 __agon_key km 22 __agon_key or km 48 __agon_key or if st 4 or -> st then
  km 156 __agon_key km 25 __agon_key or km 51 __agon_key or if st 8 or -> st then
  km 1 __agon_key km 47 __agon_key or km 73 __agon_key or if st 16 or -> st then
  km 45 __agon_key km 71 __agon_key or if st 32 or -> st then
  km 143 __agon_key km 144 __agon_key or if st 128 or -> st then
  st
end
