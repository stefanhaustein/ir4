\ agon/graphics.ir4 - Agon VDP stateful graphics

require "stdio.ir4"

data __agon_gfx_modes
  8  :i16 320 :i16 240 :i16 6 :i16
  9  :i16 320 :i16 240 :i16 4 :i16
  10 :i16 320 :i16 240 :i16 2 :i16
  11 :i16 320 :i16 240 :i16 1 :i16
  1  :i16 512 :i16 384 :i16 4 :i16
  2  :i16 512 :i16 384 :i16 2 :i16
  0  :i16 640 :i16 480 :i16 4 :i16
  4  :i16 640 :i16 480 :i16 1 :i16
  12 :i16 320 :i16 200 :i16 6 :i16
  16 :i16 640 :i16 240 :i16 6 :i16
end

var __gw :i
var __gh :i
var __gd :i
var __agon_spr_active :i

fn __vdu16 ( v :i )
  v 255 and emit
  v 8 >> 255 and emit
end

fn __vdu_plot ( m :i x :i y :i )
  25 emit m emit x __vdu16 y __vdu16
end

fn gfxmodes ( -> :a :i )
  __agon_gfx_modes 10
end

fn gfxwidth ( -> :i ) __gw end
fn gfxheight ( -> :i ) __gh end
fn gfxdepth ( -> :i ) __gd end

fn gfxmode ( mode :i )
  320 -> __gw
  240 -> __gh
  6 -> __gd
  __agon_gfx_modes -> var p :a
  10 -> var n :i
  begin n 0 > while
    p i16@ mode = if
      p 2 a+ i16@ -> __gw
      p 4 a+ i16@ -> __gh
      p 6 a+ i16@ -> __gd
      0 -> n
    else
      8 +-> p
      -1 +-> n
    then
  repeat
  22 emit mode emit
  23 emit 0 emit 192 emit 0 emit
  23 emit 1 emit 0 emit
end

fn gfxdone ( )
  22 emit 0 emit
  23 emit 1 emit 1 emit
end

code agon gfxticks ( -> :i )
  0x3E :i8 0x08 :i8 0x5B :i8 0xCF :i8
  0x21 :i8 0x00 :i8 0x00 :i8 0x00 :i8
  0xDD :i8 0x6E :i8 0x00 :i8
  0xDD :i8 0x66 :i8 0x01 :i8
  0xCB :i8 0x3C :i8 0xCB :i8 0x1D :i8
  0xD1 :i8 0xE5 :i8 0xD5 :i8
end

fn gfxvsync ( )
  23 emit 0 emit 195 emit
  __agon_spr_active 0 <> if 23 emit 27 emit 15 emit then
  gfxticks -> var t :i
  begin gfxticks t = while repeat
end

fn gfxcolor ( c :i )
  18 emit 0 emit c emit
end

\ Map 8-bit RGB (0..255) to Agon default palette (1-bpp, 2-bpp, or 16-color VGA 0..15)
fn gfxrgb ( r :i g :i b :i -> :i )
  __gd 1 = if
    r 128 >= g 128 >= or b 128 >= or if 1 else 0 then return
  then
  __gd 2 = if
    r g + b + 3 / -> var mx :i
    mx 64 < if 0 else mx 160 < if 1 else mx 224 < if 2 else 3 then then then return
  then
  r -> mx  g mx > if g -> mx then  b mx > if b -> mx then
  r -> var mn :i  g mn < if g -> mn then  b mn < if b -> mn then
  mx mn - 40 < if
    mx 32 < if 0 return then
    mx 96 < if 8 return then
    mx 224 < if 7 return then
    15 return
  then
  0 -> var c :i
  r 96 >= if c 1 or -> c then
  g 96 >= if c 2 or -> c then
  b 96 >= if c 4 or -> c then
  mx 192 >= if c 8 or -> c then
  c
end

fn gfxpx ( x :i y :i )
  69 x y __vdu_plot
end

\ __agon_gfx_sysvars ( -> :a )  MOS $08: returns IX -> HLU
code agon __agon_gfx_sysvars ( -> :a )
  0x3E :i8 0x08 :i8 0x5B :i8 0xCF :i8
  0xDD :i8 0xE5 :i8 0xE1 :i8
  0xD1 :i8 0xE5 :i8 0xD5 :i8
end

\ Read pixel color index at (*x*, *y*) via VDP `VDU 23, 0, $84`; returns -1 if out of bounds or unsupported.
fn gfxgetpx ( x :i y :i -> :i )
  x 0 < x __gw >= or y 0 < y __gh >= or or if -1 return then
  __agon_gfx_sysvars -> var sv :a
  sv 4 a+ -> var pf :a
  pf u8@ 251 and pf i8!
  23 emit 0 emit 0x84 emit
  x __vdu16
  y __vdu16
  20000 -> var spin :i
  begin spin 0 > pf u8@ 4 and 0 = and while
    -1 +-> spin
  repeat
  pf u8@ 4 and 0 = if -1 return then
  sv 0x16 a+ u8@
end

fn gfxhline ( x :i y :i w :i )
  w 0 <= if return then
  4 x y __vdu_plot
  5 x w + 1 - y __vdu_plot
end

fn gfxvline ( x :i y :i h :i )
  h 0 <= if return then
  4 x y __vdu_plot
  5 x y h + 1 - __vdu_plot
end

fn gfxline ( x1 :i y1 :i x2 :i y2 :i )
  4 x1 y1 __vdu_plot
  5 x2 y2 __vdu_plot
end

fn gfxfillrect ( x :i y :i w :i h :i )
  w 0 <= h 0 <= or if return then
  4 x y __vdu_plot
  101 x w + 1 - y h + 1 - __vdu_plot
end

fn gfxclear ( )
  0 0 __gw __gh gfxfillrect
end

\ Native VDP scanline flood fill (`VDU 25, $85`) until non-background pixel
fn gfxfill ( x :i y :i )
  x 0 < x __gw >= or y 0 < y __gh >= or or if return then
  0x85 x y __vdu_plot
end

fn gfxcharw ( -> :i ) 8 end
fn gfxcharh ( -> :i ) 8 end

\ Pixel-positioned 8x8 text via VDP `VDU 5` at the graphics cursor.
fn gfxtext ( x :i y :i s :a len :i )
  4 x y __vdu_plot
  5 emit
  s len type
  4 emit
end
