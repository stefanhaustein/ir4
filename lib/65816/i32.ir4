fn u32/ ( a :i32 b :i32 -> :i32 )
  0 i>i32 -> var q :i32
  0 i>i32 -> var rem :i32
  32 -> var i :i
  begin i 0 > while
    rem 1 i32<< -> rem
    a 31 u32>> 1 i>i32 i32and rem i32or -> rem
    a 1 i32<< -> a
    q 1 i32<< -> q
    rem b u32< 0 = if
      rem b i32- -> rem
      q 1 i>i32 i32or -> q
    then
    -1 +-> i
  repeat
  q
end

fn u32mod ( a :i32 b :i32 -> :i32 )
  0 i>i32 -> var rem :i32
  32 -> var i :i
  begin i 0 > while
    rem 1 i32<< -> rem
    a 31 u32>> 1 i>i32 i32and rem i32or -> rem
    a 1 i32<< -> a
    rem b u32< 0 = if
      rem b i32- -> rem
    then
    -1 +-> i
  repeat
  rem
end

default fn i32/ ( a :i32 b :i32 -> :i32 )
  0 -> var neg :i
  a 0 i>i32 i32< if 0 i>i32 a i32- neg 1 xor -> neg else a then -> var ua :i32
  b 0 i>i32 i32< if 0 i>i32 b i32- neg 1 xor -> neg else b then -> var ub :i32
  ua ub u32/ -> var q :i32
  neg if 0 i>i32 q i32- return then
  q
end

default fn i32mod ( a :i32 b :i32 -> :i32 )
  0 -> var neg :i
  a 0 i>i32 i32< if 1 -> neg 0 i>i32 a i32- else a then -> var ua :i32
  b 0 i>i32 i32< if 0 i>i32 b i32- else b then -> var ub :i32
  ua ub u32mod -> var r :i32
  neg if 0 i>i32 r i32- return then
  r
end
