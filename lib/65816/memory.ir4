  0xA5 :i8 0x0C :i8            \ 49: bk_words: LDA $0C
  0x29 :i8 0xFE :i8 0xFF :i8   \ 4B: AND #$FFFE
  0xF0 :i8 0x30 :i8            \ 4E: BEQ done (80)
  0x3A :i8                     \ 50: DEC A
