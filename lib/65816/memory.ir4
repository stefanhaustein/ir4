  0xA8 :i8                     \ 52: TAY
  0xB7 :i8 0x04 :i8            \ 53: bk_wloop: LDA [$04],Y
  0x97 :i8 0x00 :i8            \ 55: STA [$00],Y
  0x88 :i8                     \ 57: DEY
  0x88 :i8                     \ 58: DEY
  0x10 :i8 0xF8 :i8            \ 59: BPL bk_wloop (53)
  0x80 :i8 0x23 :i8            \ 5B: BRA done (80)
