  0x4A :i8                     \ 75: LSR A
  0x90 :i8 0x08 :i8            \ 76: BCC done (80)
  0xE2 :i8 0x20 :i8            \ 78: SEP #$20
  0xB7 :i8 0x04 :i8            \ 7A: LDA [$04],Y
  0x97 :i8 0x00 :i8            \ 7C: STA [$00],Y
  0xC2 :i8 0x20 :i8            \ 7E: REP #$20
                               \ 80: done:
end

