\ lib/65816/memory.ir4 - Native W65C816 16-bit word memory operations
\ Uses 24-bit [dp],Y addressing (hardware bank-carry safe across 64 KB banks).
\ Preserves X (data stack), D, DBR, M=0, X=0; uses scratch DP $00..$0D.

code 65816 memfill ( dst :a len :i val :i )
  0xBD :i8 0x00 :i8 0x02 :i8   \ 00: LDA $0200,X (val)
  0x29 :i8 0xFF :i8 0x00 :i8   \ 03: AND #$00FF
  0x85 :i8 0x08 :i8            \ 06: STA $08
  0xEB :i8                     \ 08: XBA
  0x05 :i8 0x08 :i8            \ 09: ORA $08
  0x85 :i8 0x08 :i8            \ 0B: STA $08 ((val << 8) | val)
  0xBD :i8 0x04 :i8 0x02 :i8   \ 0D: LDA $0204,X (dst lo/hi)
  0x85 :i8 0x00 :i8            \ 10: STA $00
  0xBD :i8 0x06 :i8 0x02 :i8   \ 12: LDA $0206,X (dst bank)
  0x85 :i8 0x02 :i8            \ 15: STA $02
  0xBD :i8 0x02 :i8 0x02 :i8   \ 17: LDA $0202,X (len)
  0x85 :i8 0x0C :i8            \ 1A: STA $0C
  0x8A :i8                     \ 1C: TXA
  0x18 :i8                     \ 1D: CLC
  0x69 :i8 0x07 :i8 0x00 :i8   \ 1E: ADC #$0007
  0xAA :i8                     \ 21: TAX
  0xA5 :i8 0x0C :i8            \ 22: LDA $0C
  0x30 :i8 0x23 :i8            \ 24: BMI done (49)
  0xF0 :i8 0x21 :i8            \ 26: BEQ done (49)
  0xA0 :i8 0x00 :i8 0x00 :i8   \ 28: LDY #$0000
  0x29 :i8 0xFE :i8 0xFF :i8   \ 2B: AND #$FFFE
  0xF0 :i8 0x0C :i8            \ 2E: BEQ tail (3C)
  0x85 :i8 0x04 :i8            \ 30: STA $04
  0xA5 :i8 0x08 :i8            \ 32: LDA $08
  0x97 :i8 0x00 :i8            \ 34: wloop: STA [$00],Y
  0xC8 :i8                     \ 36: INY
  0xC8 :i8                     \ 37: INY
  0xC4 :i8 0x04 :i8            \ 38: CPY $04
  0xD0 :i8 0xF8 :i8            \ 3A: BNE wloop (34)
  0xA5 :i8 0x0C :i8            \ 3C: tail: LDA $0C
  0x4A :i8                     \ 3E: LSR A
  0x90 :i8 0x08 :i8            \ 3F: BCC done (49)
  0xE2 :i8 0x20 :i8            \ 41: SEP #$20
  0xA5 :i8 0x08 :i8            \ 43: LDA $08
  0x97 :i8 0x00 :i8            \ 45: STA [$00],Y
  0xC2 :i8 0x20 :i8            \ 47: REP #$20
                               \ 49: done:
end

