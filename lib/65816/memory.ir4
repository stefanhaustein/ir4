\ lib/65816/memory.ir4 - Native W65C816 16-bit word memory operations
\ Uses 24-bit [dp],Y addressing (hardware bank-carry safe across 64 KB banks).
\ Preserves X (data stack), D, DBR, M=0, X=0; uses scratch DP $00..$0D.

code 65816 memfill ( dst :a len :i val :i )
  0xBD :i8 0x00 :i8 0x02 :i8    \\ LDA $0200,X         ; val
  0x29 :i8 0xFF :i8 0x00 :i8    \\ AND #$00FF
  0x85 :i8 0x08 :i8             \\ STA $08
  0xEB :i8                      \\ XBA
  0x05 :i8 0x08 :i8             \\ ORA $08
  0x85 :i8 0x08 :i8             \\ STA $08             ; (val << 8) | val
  0xBD :i8 0x04 :i8 0x02 :i8    \\ LDA $0204,X         ; dst lo/hi
  0x85 :i8 0x00 :i8             \\ STA $00
  0xBD :i8 0x06 :i8 0x02 :i8    \\ LDA $0206,X         ; dst bank
  0x85 :i8 0x02 :i8             \\ STA $02
  0xBD :i8 0x02 :i8 0x02 :i8    \\ LDA $0202,X         ; len
  0x85 :i8 0x0C :i8             \\ STA $0C
  0x8A :i8                      \\ TXA
  0x18 :i8                      \\ CLC
  0x69 :i8 0x07 :i8 0x00 :i8    \\ ADC #$0007
  0xAA :i8                      \\ TAX
  0xA5 :i8 0x0C :i8             \\ LDA $0C
  0x30 :i8 0x23 :i8             \\ BMI done
  0xF0 :i8 0x21 :i8             \\ BEQ done
  0xA0 :i8 0x00 :i8 0x00 :i8    \\ LDY #$0000
  0x29 :i8 0xFE :i8 0xFF :i8    \\ AND #$FFFE
  0xF0 :i8 0x0C :i8             \\ BEQ tail
  0x85 :i8 0x04 :i8             \\ STA $04
  0xA5 :i8 0x08 :i8             \\ LDA $08
                                \\ wloop:
  0x97 :i8 0x00 :i8             \\ STA [$00],Y
  0xC8 :i8                      \\ INY
  0xC8 :i8                      \\ INY
  0xC4 :i8 0x04 :i8             \\ CPY $04
  0xD0 :i8 0xF8 :i8             \\ BNE wloop
                                \\ tail:
  0xA5 :i8 0x0C :i8             \\ LDA $0C
  0x4A :i8                      \\ LSR A
  0x90 :i8 0x08 :i8             \\ BCC done
  0xE2 :i8 0x20 :i8             \\ SEP #$20
  0xA5 :i8 0x08 :i8             \\ LDA $08
  0x97 :i8 0x00 :i8             \\ STA [$00],Y
  0xC2 :i8 0x20 :i8             \\ REP #$20
                                \\ done:
end \\ 698e

code 65816 memcpy ( dst :a src :a len :i )
  0xBD :i8 0x00 :i8 0x02 :i8    \\ LDA $0200,X         ; len
  0x85 :i8 0x0C :i8             \\ STA $0C
  0xBD :i8 0x02 :i8 0x02 :i8    \\ LDA $0202,X         ; src lo/hi
  0x85 :i8 0x04 :i8             \\ STA $04
  0xBD :i8 0x04 :i8 0x02 :i8    \\ LDA $0204,X         ; src bank
  0x29 :i8 0xFF :i8 0x00 :i8    \\ AND #$00FF
  0x85 :i8 0x06 :i8             \\ STA $06
  0xBD :i8 0x05 :i8 0x02 :i8    \\ LDA $0205,X         ; dst lo/hi
  0x85 :i8 0x00 :i8             \\ STA $00
  0xBD :i8 0x07 :i8 0x02 :i8    \\ LDA $0207,X         ; dst bank
  0x29 :i8 0xFF :i8 0x00 :i8    \\ AND #$00FF
  0x85 :i8 0x02 :i8             \\ STA $02
  0x8A :i8                      \\ TXA
  0x18 :i8                      \\ CLC
  0x69 :i8 0x08 :i8 0x00 :i8    \\ ADC #$0008
  0xAA :i8                      \\ TAX
  0xA5 :i8 0x0C :i8             \\ LDA $0C
  0x30 :i8 0x57 :i8             \\ BMI done
  0xF0 :i8 0x55 :i8             \\ BEQ done
  0xA5 :i8 0x02 :i8             \\ LDA $02             ; dst bank
  0xC5 :i8 0x06 :i8             \\ CMP $06             ; src bank
  0xD0 :i8 0x06 :i8             \\ BNE hi_diff
  0xA5 :i8 0x00 :i8             \\ LDA $00             ; dst lo/hi
  0xC5 :i8 0x04 :i8             \\ CMP $04             ; src lo/hi
  0xF0 :i8 0x49 :i8             \\ BEQ done
                                \\ hi_diff:
  0x90 :i8 0x24 :i8             \\ BCC copy_fwd
  0xA5 :i8 0x0C :i8             \\ LDA $0C             ; backward: dst > src
  0x4A :i8                      \\ LSR A
  0x90 :i8 0x0B :i8             \\ BCC bk_words
  0xA4 :i8 0x0C :i8             \\ LDY $0C
  0x88 :i8                      \\ DEY
  0xE2 :i8 0x20 :i8             \\ SEP #$20
  0xB7 :i8 0x04 :i8             \\ LDA [$04],Y
  0x97 :i8 0x00 :i8             \\ STA [$00],Y
  0xC2 :i8 0x20 :i8             \\ REP #$20
                                \\ bk_words:
  0xA5 :i8 0x0C :i8             \\ LDA $0C
  0x29 :i8 0xFE :i8 0xFF :i8    \\ AND #$FFFE
  0xF0 :i8 0x30 :i8             \\ BEQ done
  0x3A :i8                      \\ DEC A
  0x3A :i8                      \\ DEC A
  0xA8 :i8                      \\ TAY
                                \\ bk_wloop:
  0xB7 :i8 0x04 :i8             \\ LDA [$04],Y
  0x97 :i8 0x00 :i8             \\ STA [$00],Y
  0x88 :i8                      \\ DEY
  0x88 :i8                      \\ DEY
  0x10 :i8 0xF8 :i8             \\ BPL bk_wloop
  0x80 :i8 0x23 :i8             \\ BRA done
                                \\ copy_fwd:
  0xA0 :i8 0x00 :i8 0x00 :i8    \\ LDY #$0000
  0xA5 :i8 0x0C :i8             \\ LDA $0C
  0x29 :i8 0xFE :i8 0xFF :i8    \\ AND #$FFFE
  0xF0 :i8 0x0C :i8             \\ BEQ fwd_tail
  0x85 :i8 0x08 :i8             \\ STA $08
                                \\ fwd_wloop:
  0xB7 :i8 0x04 :i8             \\ LDA [$04],Y
  0x97 :i8 0x00 :i8             \\ STA [$00],Y
  0xC8 :i8                      \\ INY
  0xC8 :i8                      \\ INY
  0xC4 :i8 0x08 :i8             \\ CPY $08
  0xD0 :i8 0xF6 :i8             \\ BNE fwd_wloop
                                \\ fwd_tail:
  0xA5 :i8 0x0C :i8             \\ LDA $0C
  0x4A :i8                      \\ LSR A
  0x90 :i8 0x08 :i8             \\ BCC done
  0xE2 :i8 0x20 :i8             \\ SEP #$20
  0xB7 :i8 0x04 :i8             \\ LDA [$04],Y
  0x97 :i8 0x00 :i8             \\ STA [$00],Y
  0xC2 :i8 0x20 :i8             \\ REP #$20
                                \\ done:
end \\ 1751

code 65816 memcmp ( a :a b :a len :i -> :i )
  0xBD :i8 0x00 :i8 0x02 :i8    \\ LDA $0200,X         ; len
  0x85 :i8 0x0C :i8             \\ STA $0C
  0xBD :i8 0x02 :i8 0x02 :i8    \\ LDA $0202,X         ; b lo/hi
  0x85 :i8 0x04 :i8             \\ STA $04
  0xBD :i8 0x04 :i8 0x02 :i8    \\ LDA $0204,X         ; b bank
  0x85 :i8 0x06 :i8             \\ STA $06
  0xBD :i8 0x05 :i8 0x02 :i8    \\ LDA $0205,X         ; a lo/hi
  0x85 :i8 0x00 :i8             \\ STA $00
  0xBD :i8 0x07 :i8 0x02 :i8    \\ LDA $0207,X         ; a bank
  0x85 :i8 0x02 :i8             \\ STA $02
  0x8A :i8                      \\ TXA
  0x18 :i8                      \\ CLC
  0x69 :i8 0x06 :i8 0x00 :i8    \\ ADC #$0006
  0xAA :i8                      \\ TAX
  0xA5 :i8 0x0C :i8             \\ LDA $0C
  0x30 :i8 0x27 :i8             \\ BMI cmp_zero
  0xF0 :i8 0x25 :i8             \\ BEQ cmp_zero
  0xA0 :i8 0x00 :i8 0x00 :i8    \\ LDY #$0000
  0x29 :i8 0xFE :i8 0xFF :i8    \\ AND #$FFFE
  0xF0 :i8 0x0E :i8             \\ BEQ cmp_tail
  0x85 :i8 0x08 :i8             \\ STA $08
                                \\ cmp_wloop:
  0xB7 :i8 0x00 :i8             \\ LDA [$00],Y
  0xD7 :i8 0x04 :i8             \\ CMP [$04],Y
  0xD0 :i8 0x1A :i8             \\ BNE word_diff
  0xC8 :i8                      \\ INY
  0xC8 :i8                      \\ INY
  0xC4 :i8 0x08 :i8             \\ CPY $08
  0xD0 :i8 0xF4 :i8             \\ BNE cmp_wloop
                                \\ cmp_tail:
  0xA5 :i8 0x0C :i8             \\ LDA $0C
  0x4A :i8                      \\ LSR A
  0x90 :i8 0x0A :i8             \\ BCC cmp_zero
  0xE2 :i8 0x20 :i8             \\ SEP #$20
  0xB7 :i8 0x00 :i8             \\ LDA [$00],Y
  0xD7 :i8 0x04 :i8             \\ CMP [$04],Y
  0xD0 :i8 0x12 :i8             \\ BNE byte_diff_a
  0xC2 :i8 0x20 :i8             \\ REP #$20
                                \\ cmp_zero:
  0x9E :i8 0x00 :i8 0x02 :i8    \\ STZ $0200,X
  0x80 :i8 0x1A :i8             \\ BRA done
                                \\ word_diff:
  0xE2 :i8 0x20 :i8             \\ SEP #$20
  0xB7 :i8 0x00 :i8             \\ LDA [$00],Y
  0xD7 :i8 0x04 :i8             \\ CMP [$04],Y
  0xD0 :i8 0x03 :i8             \\ BNE byte_diff_a
  0xC8 :i8                      \\ INY
  0xB7 :i8 0x00 :i8             \\ LDA [$00],Y
                                \\ byte_diff_a:
  0x38 :i8                      \\ SEC
  0xF7 :i8 0x04 :i8             \\ SBC [$04],Y
  0x9D :i8 0x00 :i8 0x02 :i8    \\ STA $0200,X
  0xA9 :i8 0x00 :i8             \\ LDA #$00
  0xE9 :i8 0x00 :i8             \\ SBC #$00
  0x9D :i8 0x01 :i8 0x02 :i8    \\ STA $0201,X
  0xC2 :i8 0x20 :i8             \\ REP #$20
                                \\ done:
end \\ 4ad8
