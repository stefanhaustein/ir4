  0xA5 :i8 0x0C :i8            \ 60: LDA $0C
  0x29 :i8 0xFE :i8 0xFF :i8   \ 62: AND #$FFFE
  0xF0 :i8 0x0C :i8            \ 65: BEQ fwd_tail (73)
  0x85 :i8 0x08 :i8            \ 67: STA $08
  0xB7 :i8 0x04 :i8            \ 69: fwd_wloop: LDA [$04],Y
  0x97 :i8 0x00 :i8            \ 6B: STA [$00],Y
