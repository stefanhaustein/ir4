\ stdio.ir4 - Console I/O, formatting, and screen control
\ Platform overrides implement raw `emit` (and optionally the `default fn` entries below).

\ Native boot/symbol-oriented character set (`setcharset`/`getcharset`)
const charset_native 0 :i
\ Text-oriented character set with lowercase support (`setcharset`/`getcharset`)
const charset_text   1 :i

\ Emit character *c* with platform text mapping (defaults to raw emit; PETSCII on C64)
default fn xemit ( c :i )
  c emit
end

\ Emit a newline
fn cr ( )
  10 xemit
end

\ Print *len* bytes starting at *s*
fn type ( s :a len :i )
  begin
    len 0 >
  while
    s u8@ xemit
    1 +-> s
    -1 +-> len
  repeat
end

\ Print NUL-terminated string at *s*
fn type0 ( s :a )
  begin
    s u8@ -> var c :i
    c 0 <>
  while
    c xemit
    1 +-> s
  repeat
end

\ Print *n* as minimal unsigned decimal
fn typeu ( n :i )
  var buf :bytes 20
  0 -> var len :i
  n 0 = if 48 xemit return then
  begin
    n 0 <>
  while
    n 10 umod 48 + buf len a+ i8!
    n 10 u/ -> n
    1 +-> len
  repeat
  begin
    len 0 >
  while
    -1 +-> len
    buf len a+ u8@ xemit
  repeat
end

\ Print *n* as signed decimal
fn typei ( n :i )
  n 0 < if
    45 xemit
    0 n - typeu
    return
  then
  n typeu
end

\ Print *n* as signed decimal, right-aligned with spaces to width *w*
fn typeiw ( n :i w :i )
  0 -> var d :i
  n -> var t :i
  t 0 < if
    1 -> d
    0 t - -> t
  then
  t 0 = if
    1 +-> d
  else
    begin
      t 0 <>
    while
      1 +-> d
      t 10 u/ -> t
    repeat
  then
  begin
    w d >
  while
    32 xemit
    -1 +-> w
  repeat
  n typei
end

\ Print *n* as *w* zero-padded uppercase hex digits
fn typehw ( n :i w :i )
  begin
    w 0 >
  while
    -1 +-> w
    n w 2 << u>> 15 and -> var d :i
    d 10 < if
      d 48 + xemit
    else
      d 55 + xemit
    then
  repeat
end

\ Print *n* as minimal uppercase hex
fn typeh ( n :i )
  n -> var t :i
  1 -> var w :i
  begin
    t 15 u>
  while
    t 4 u>> -> t
    1 +-> w
  repeat
  n w typehw
end

\ Print *n* as *w* zero-padded binary digits
fn typebw ( n :i w :i )
  begin
    w 0 >
  while
    -1 +-> w
    n w u>> 1 and 48 + xemit
  repeat
end

\ Print *n* as minimal binary
fn typeb ( n :i )
  n -> var t :i
  1 -> var w :i
  begin
    t 1 u>
  while
    t 1 u>> -> t
    1 +-> w
  repeat
  n w typebw
end

\ Clear screen (using active background color where supported) and home cursor (ANSI default)
default fn cls ( )
  27 emit 91 emit 50 emit 74 emit
  27 emit 91 emit 72 emit
end

\ Move text cursor to 0-based column *x*, row *y* (ANSI default)
default fn gotoxy ( x :i y :i )
  27 emit 91 emit
  y 1 + typeu
  59 emit
  x 1 + typeu
  72 emit
end

\ Return terminal width in columns (default: 80)
default fn termwidth ( -> :i )
  80
end

\ Return terminal height in rows (default: 24)
default fn termheight ( -> :i )
  24
end

\ Non-blocking read of next buffered character; returns and consumes char code or 0 if none ready; default: 0
default fn inkey ( -> :i )
  0
end

\ Wait for and return the next character from the input buffer (blocking except when unsupported; defaults to 0 in that case)
default fn key ( -> :i )
  0
end

\ Non-blocking read of next key mapped to normalized ASCII (defaults to raw inkey)
default fn xinkey ( -> :i )
  inkey
end

\ Blocking read of next key mapped to normalized ASCII (defaults to raw key)
default fn xkey ( -> :i )
  key
end

\ Set foreground text color *c* using ANSI color index (0..7, 8..15 bright; ANSI default)
default fn fgcolor ( c :i )
  27 emit 91 emit
  c 8 < if 30 c + else 82 c + then typeu
  109 emit
end

\ Set background text color *c* using ANSI color index (0..7, 8..15 bright; ANSI default)
default fn bgcolor ( c :i )
  27 emit 91 emit
  c 8 < if 40 c + else 92 c + then typeu
  109 emit
end

\ Select text character set (`charset_native` or `charset_text`; no-op where fixed)
default fn setcharset ( mode :i )
  mode drop
end

\ Return active effective character set (`charset_text` when lowercase is supported, `charset_native` otherwise)
default fn getcharset ( -> :i )
  charset_text
end
