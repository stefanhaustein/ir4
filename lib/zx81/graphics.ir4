\ lib/zx81/graphics.ir4 - Sinclair ZX81 64x48 block-mosaic pixel graphics in D_FILE

require "terminal.ir4"

var __zx81_col :i

data __zx81_modes
  0 :i16 64 :i16 48 :i16 1 :i16
end

fn gfxmodes ( -> :a :i )
  __zx81_modes 1
end

fn gfxwidth ( -> :i ) 64 end
fn gfxheight ( -> :i ) 48 end
fn gfxdepth ( -> :i ) 1 end

fn gfxmode ( mode :i )
  1 -> __zx81_col
  termclear
end

fn gfxdone ( )
end

fn gfxvsync ( )
end

fn gfxrgb ( r :i g :i b :i -> :i )
  r g + b + 382 >= if 1 else 0 then
end

fn gfxcolor ( c :i )
  c 0 <> if 1 else 0 then -> __zx81_col
end

fn gfxclear ( )
  0x400C i>a a@ -> var df :a
  0 -> var r :i
  begin r 24 < while
    0 -> var c :i
    begin c 32 < while
      0 df 1 r 33 * + c + a+ i8!
      1 +-> c
    repeat
    1 +-> r
  repeat
end

fn gfxpx ( x :i y :i )
  x 0 < x 64 >= or y 0 < y 48 >= or or if return then
  0x400C i>a a@ -> var df :a
  df 1 y 1 u>> 33 * + x 1 u>> + a+ -> var p :a
  p u8@ -> var ch :i
  0 -> var bits :i
  ch 8 < if
    ch -> bits
  else
    ch 0x80 >= ch 0x87 <= and if
      0x8F ch - -> bits
    then
  then
  1 x 1 and + y 1 and 0 <> if 2 << then -> var mask :i
  __zx81_col 0 <> if
    bits mask or -> bits
  else
    bits mask 15 xor and -> bits
  then
  bits 8 < if
    bits p i8!
  else
    0x8F bits - p i8!
  then
end

fn gfxcharw ( -> :i ) 2 end
fn gfxcharh ( -> :i ) 2 end

\ Snaps (*x*, *y*) to the nearest 2x2 cell (`x/2, y/2`) in `D_FILE` via `type`.
fn gfxtext ( x :i y :i s :a len :i )
  x 1 u>> y 1 u>> termgoto
  s len type
end
