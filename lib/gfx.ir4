\ gfx.ir4 - Pixel graphics (default: ANSI 8-color UTF-8 half-block backend)
\ Platform overrides implement the `default fn` entries below.

require "stdio.ir4"
require "mem.ir4"

var __gfx_def_modes :bytes 8
var __gfx_w :i
var __gfx_h :i
var __gfx_col :i
var __gfx_fb :a

\ Returns (addr, count) of :i16 4-tuples: (mode, width, height, depth_bpp)
default fn gfxmodes ( -> :a :i )
  0 __gfx_def_modes i16!
  termwidth __gfx_def_modes 2 a+ i16!
  termheight 1 << __gfx_def_modes 4 a+ i16!
  3 __gfx_def_modes 6 a+ i16!
  __gfx_def_modes 1
end

\ Current graphics screen width in pixels
default fn gfxwidth ( -> :i ) __gfx_w end

\ Current graphics screen height in pixels
default fn gfxheight ( -> :i ) __gfx_h end

\ Per-pixel color depth in bits (1 on attribute-cell targets like C64/Spectrum, where gfxrgb may still return palette colors per cell)
default fn gfxdepth ( -> :i ) 3 end

\ Wait for vertical blank / next frame sync (default: no-op)
default fn gfxvsync ( ) end

\ Return platform tick counter (wraps monotonically; default: 0)
default fn gfxticks ( -> :i ) 0 end

\ Switch to graphics mode index *mode* (default: ANSI half-block buffer)
default fn gfxmode ( mode :i )
  mode drop
  termwidth -> __gfx_w
  termheight 1 << -> __gfx_h
  __gfx_fb 0 i>a a<> if __gfx_fb heap_free then
  __gfx_w termheight * heap_alloc -> __gfx_fb
  __gfx_fb __gfx_w termheight * 0 fillchar
  7 -> __gfx_col
  cls
end

\ Restore text mode and release graphics resources
default fn gfxdone ( )
  __gfx_fb 0 i>a a<> if
    __gfx_fb heap_free
    0 i>a -> __gfx_fb
  then
  27 emit 91 emit 48 emit 109 emit
  0 termheight 1 - gotoxy
  cr
end

\ Enter best-matching mode from gfxmodes for (*w*, *h*, *depth*); (0, 0, 0) selects entry 0
default fn gfxinit ( w :i h :i depth :i )
  gfxmodes -> var cnt :i -> var tbl :a
  cnt 0 <= if 0 gfxmode return then
  tbl i16@ -> var best_mode :i
  w 0 = h 0 = and depth 0 = and if best_mode gfxmode return then
  32767 -> var best_score :i
  tbl -> var p :a
  begin cnt 0 > while
    p 2 a+ i16@ -> var mw :i
    p 4 a+ i16@ -> var mh :i
    p 6 a+ i16@ -> var md :i
    mw w - -> var dw :i  dw 0 < if 0 dw - -> dw then
    mh h - -> var dh :i  dh 0 < if 0 dh - -> dh then
    md depth - -> var dd :i  dd 0 < if 0 dd - -> dd then
    dw dh + dd 5 << + -> var score :i
    score best_score < if
      score -> best_score
      p i16@ -> best_mode
    then
    8 +-> p
    -1 +-> cnt
  repeat
  best_mode gfxmode
end

\ Map 8-bit RGB (*r*, *g*, *b* in 0..255) to the platform's native color value for gfxcolor.
\ On attribute-cell targets (gfxdepth = 1), non-zero colors may still set per-cell attributes.
default fn gfxrgb ( r :i g :i b :i -> :i )
  0 -> var c :i
  r 128 >= if c 1 or -> c then
  g 128 >= if c 2 or -> c then
  b 128 >= if c 4 or -> c then
  c
end

\ Set current drawing color *c* (value returned by gfxrgb)
default fn gfxcolor ( c :i )
  c 7 and -> __gfx_col
end

\ Set hardware border/overscan color *c* (value returned by gfxrgb; no-op if unsupported)
default fn gfxborder ( c :i ) end

fn __gfx_emit_cell ( cx :i cy :i val :i )
  cx cy gotoxy
  val 4 u>> fgcolor
  val 15 and bgcolor
  226 emit 150 emit 128 emit
end

\ Plot a pixel at (*x*, *y*) in the current drawing color
default fn gfxpx ( x :i y :i )
  x 0 < x __gfx_w >= or y 0 < y __gfx_h >= or or if return then
  __gfx_fb y 1 u>> __gfx_w * x + a+ -> var cell :a
  cell u8@ -> var old :i
  0 -> var val :i
  y 1 and 0 = if
    old 15 and __gfx_col 4 << or -> val
  else
    old 240 and __gfx_col or -> val
  then
  val cell i8!
  x y 1 u>> val __gfx_emit_cell
end

\ Draw a horizontal line of width *w* starting at (*x*, *y*) (default: gfxpx loop)
default fn gfxhline ( x :i y :i w :i )
  begin w 0 > while
    x y gfxpx
    1 +-> x
    -1 +-> w
  repeat
end

\ Draw a vertical line of height *h* starting at (*x*, *y*) (default: gfxpx loop)
default fn gfxvline ( x :i y :i h :i )
  begin h 0 > while
    x y gfxpx
    1 +-> y
    -1 +-> h
  repeat
end

\ Draw a line from (*x1*, *y1*) to (*x2*, *y2*) (default: Bresenham via gfxhline/gfxvline/gfxpx)
default fn gfxline ( x1 :i y1 :i x2 :i y2 :i )
  y1 y2 = if
    x1 x2 > if x2 y1 x1 x2 - 1 + else x1 y1 x2 x1 - 1 + then gfxhline return
  then
  x1 x2 = if
    y1 y2 > if x1 y2 y1 y2 - 1 + else x1 y1 y2 y1 - 1 + then gfxvline return
  then
  x2 x1 - -> var dx :i
  dx 0 < if 0 dx - -> dx then
  y2 y1 - -> var dy :i
  dy 0 < if 0 dy - -> dy then
  dx dy >= if
    x1 x2 > if
      x1 -> var tmp :i x2 -> x1 tmp -> x2
      y1 -> tmp y2 -> y1 tmp -> y2
    then
    y2 y1 < if -1 else 1 then -> var s :i
    dx 1 >> -> var err :i
    x1 -> var r :i
    x1 -> var p :i
    begin p x2 <= while
      err dy - -> err
      err 0 < if
        r y1 p r - 1 + gfxhline
        p 1 + -> r
        s +-> y1
        dx +-> err
      then
      1 +-> p
    repeat
    r x2 <= if r y1 x2 r - 1 + gfxhline then
  else
    y1 y2 > if
      x1 -> tmp x2 -> x1 tmp -> x2
      y1 -> tmp y2 -> y1 tmp -> y2
    then
    x2 x1 < if -1 else 1 then -> s
    dy 1 >> -> err
    y1 -> r
    y1 -> p
    begin p y2 <= while
      err dx - -> err
      err 0 < if
        x1 r p r - 1 + gfxvline
        p 1 + -> r
        s +-> x1
        dy +-> err
      then
      1 +-> p
    repeat
    r y2 <= if x1 r y2 r - 1 + gfxvline then
  then
end

\ Draw a rectangle outline at (*x*, *y*) with size *w* x *h*
default fn gfxrect ( x :i y :i w :i h :i )
  w 0 <= h 0 <= or if return then
  x y w gfxhline
  x y h + 1 - w gfxhline
  x y h gfxvline
  x w + 1 - y h gfxvline
end

\ Draw a filled rectangle at (*x*, *y*) with size *w* x *h* (default: gfxhline loop)
default fn gfxfillrect ( x :i y :i w :i h :i )
  w 0 <= h 0 <= or if return then
  y h + -> var ye :i
  begin y ye < while
    x y w gfxhline
    1 +-> y
  repeat
end

\ Clear the graphics screen to the current drawing color
default fn gfxclear ( )
  __gfx_fb __gfx_w termheight * __gfx_col 4 << __gfx_col or fillchar
  __gfx_col bgcolor
  cls
end

\ Draw a circle outline of radius *r* centered at (*cx*, *cy*) using the midpoint algorithm
default fn gfxcircle ( cx :i cy :i r :i )
  r 0 < if return then
  r -> var x :i
  0 -> var y :i
  1 r - -> var err :i
  begin x y >= while
    cx x + cy y + gfxpx
    cx y + cy x + gfxpx
    cx y - cy x + gfxpx
    cx x - cy y + gfxpx
    cx x - cy y - gfxpx
    cx y - cy x - gfxpx
    cx y + cy x - gfxpx
    cx x + cy y - gfxpx
    1 +-> y
    err 0 < if
      err y 1 << + 1 + -> err
    else
      -1 +-> x
      err y x - 1 << + 1 + -> err
    then
  repeat
end

\ Character cell width in pixels (default: 1 in ANSI half-block mode)
default fn gfxcharw ( -> :i ) 1 end

\ Character cell height in pixels (default: 2 in ANSI half-block mode)
default fn gfxcharh ( -> :i ) 2 end

\ Draw *len* normalized-ASCII bytes starting at *s* with top-left at pixel (*x*, *y*) in the current drawing color.
\ Text-cell targets snap (*x*, *y*) to the nearest character cell (default: ANSI `x, y/2`).
default fn gfxtext ( x :i y :i s :a len :i )
  __gfx_col fgcolor
  x y 1 u>> gotoxy
  s len type
end
