\ lib/x16/sound.ir4 - Commander X16 VERA PSG sound effects (16 channels at VRAM $1F9C0)

var __x16_sfx_tmr :bytes 32

init
  0 -> var ch :i
  begin ch 16 < while
    0 __x16_sfx_tmr ch 1 << a+ i16!
    1 +-> ch
  repeat
end

data __x16_sfx_waves
  0x3F :i8 0x7F :i8 0xBF :i8 0xFF :i8
end

fn sfxcount ( -> :i ) 16 end

fn sfxplay ( ch :i freq :i vol :i wave :i dur_ms :i )
  ch 0 < ch 15 > or if return then
  vol 0 < if 0 -> vol then
  vol 15 > if 15 -> vol then
  freq 1 << dup 3 / + -> var vf :i
  0 0x9F25 i>a i8!
  0xC0 ch 2 << + 0x9F20 i>a i8!
  0xF9 0x9F21 i>a i8!
  0x11 0x9F22 i>a i8!
  vf 255 and 0x9F23 i>a i8!
  vf 8 u>> 255 and 0x9F23 i>a i8!
  vol 0 = if 0 else 0xC0 vol 2 << or vol 2 u>> or then 0x9F23 i>a i8!
  __x16_sfx_waves wave 3 and a+ u8@ 0x9F23 i>a i8!
  0 -> var ticks :i
  dur_ms 0 > if
    dur_ms 4 u>> -> ticks
    ticks 1 < if 1 -> ticks then
  then
  ticks __x16_sfx_tmr ch 1 << a+ i16!
end

fn sfxstop ( ch :i )
  ch 0 < ch 15 > or if return then
  0 0x9F25 i>a i8!
  0xC2 ch 2 << + 0x9F20 i>a i8!
  0xF9 0x9F21 i>a i8!
  0x01 0x9F22 i>a i8!
  0 0x9F23 i>a i8!
  0 __x16_sfx_tmr ch 1 << a+ i16!
end

fn sfxtick ( )
  0 -> var ch :i
  begin ch 16 < while
    __x16_sfx_tmr ch 1 << a+ -> var p :a
    p i16@ -> var t :i
    t 0 > if
      -1 +-> t
      t p i16!
      t 0 = if ch sfxstop then
    then
    1 +-> ch
  repeat
end
