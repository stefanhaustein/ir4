  __x16_chrin drop
  __x16_chrin drop
  __x16_clrchn
  1 __x16_diropen i8!
  used_cd __x16_dircd i8!
  0
end

fn fsdirread ( dd :i buf :a max :i -> :i :i :i )
  dd 0 <> __x16_diropen u8@ 0 = or max 0 < or if -1 0 0 return then
  buf max __x16_dir_next
end

fn fsdirclose ( dd :i -> :i )
  dd 0 <> __x16_diropen u8@ 0 = or if -1 return then
  __x16_clrchn
  6 __x16_close
  0 __x16_diropen i8!
  __x16_dircd u8@ 0 <> if
    0 __x16_dircd i8!
    __x16_restore_cwd
  then
  0
end

fn fsmkdir ( path :a len :i -> :i )
  len 1 < len 80 > or if -1 return then
  77 __x16_name i8!
  68 __x16_name 1 a+ i8!
  58 __x16_name 2 a+ i8!
  __x16_name 3 a+ path len __x16_copy_name
  __x16_name len 3 + __x16_dos_cmd
end

fn fsrmdir ( path :a len :i -> :i )
  len 1 < len 80 > or if -1 return then
  82 __x16_name i8!
  68 __x16_name 1 a+ i8!
  58 __x16_name 2 a+ i8!
  __x16_name 3 a+ path len __x16_copy_name
  __x16_name len 3 + __x16_dos_cmd
end
