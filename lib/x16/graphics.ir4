\ x16/graphics.ir4 - Commander X16 VERA 8bpp bitmap modes (320x240 and 160x120 via Mode $80)

require "stdio.ir4"

data __x16_modes
  128 :i16 320 :i16 240 :i16 8 :i16
  1   :i16 160 :i16 120 :i16 8 :i16
end

var __x16_col :i
var __x16_w :i
var __x16_h :i

init
  15 -> __x16_col
end

code x16 __x16_mode_gfx ( )
  0xA9 :i8 0x80 :i8             \\   LDA #$80
  0x18 :i8                      \\   CLC
  0x4C :i8 0x5F :i8 0xFF :i8    \\   JMP $FF5F           ; SCREEN_MODE (tail call)
end \\ a6c2

code x16 __x16_mode_txt ( )
  0xA9 :i8 0x00 :i8             \\   LDA #$00
  0x18 :i8                      \\   CLC
  0x4C :i8 0x5F :i8 0xFF :i8    \\   JMP $FF5F           ; SCREEN_MODE (tail call)
end \\ 86e3

extern __x16_set_charset 0xFF62 ( A :i )

fn gfxmodes ( -> :a :i )
  __x16_modes 2
end

fn gfxwidth ( -> :i ) __x16_w end
fn gfxheight ( -> :i ) __x16_h end
fn gfxdepth ( -> :i ) 8 end

fn __x16_init_pal ( )
  \ VERA palette indices 16..231 at VRAM $1FA20 (auto-inc +1 => ADDR_H = $11)
  0 0x9F25 i>a i8!
  0x20 0x9F20 i>a i8!
  0xFA 0x9F21 i>a i8!
  0x11 0x9F22 i>a i8!
  0 -> var r :i
  begin r 6 < while
    0 -> var g :i
    begin g 6 < while
      0 -> var b :i
      begin b 6 < while
        g 3 * 4 << b 3 * or 0x9F23 i>a i8!
        r 3 * 0x9F23 i>a i8!
        1 +-> b
      repeat
      1 +-> g
    repeat
    1 +-> r
  repeat
end

fn gfxmode ( mode :i )
  15 -> __x16_col
  __x16_mode_gfx
  1 __x16_set_charset
  __x16_init_pal
  mode 1 = if
    160 -> __x16_w
    120 -> __x16_h
    0 0x9F25 i>a i8!
    32 0x9F2A i>a i8!
    32 0x9F2B i>a i8!
  else
    320 -> __x16_w
    240 -> __x16_h
  then
end

fn gfxdone ( )
  0 0x9F25 i>a i8!
  0x9F29 i>a u8@ 0xBF and 0x9F29 i>a i8!
  __x16_mode_txt
  getcharset charset_text = if 1 else 2 then __x16_set_charset
end

extern __x16_rdtim 0xFFDE ( -> A :i )

fn gfxvsync ( )
  __x16_rdtim -> var t :i
  begin __x16_rdtim t = while repeat
end

fn gfxticks ( -> :i )
  __x16_rdtim
end

\ Map 8-bit RGB to X16 default 6x6x6 palette cube (indices 16..231)
fn gfxrgb ( r :i g :i b :i -> :i )
  r 6 * 8 u>> 36 *
  g 6 * 8 u>> 6 * +
  b 6 * 8 u>> +
  16 +
end

fn gfxborder ( c :i )
  0 0x9F25 i>a i8!
  c 0x9F2C i>a i8!
end

hot fn gfxcolor ( c :i )
  c 255 and -> __x16_col
end

hot fn __x16_set_addr ( x :i y :i inc :i )
  0 0x9F25 i>a i8!
  x 255 and y 3 and 6 << + -> var lo :i
  x 8 u>> y + y 2 u>> + -> var mid :i
  lo 255 > if
    lo 255 and -> lo
    1 +-> mid
  then
  lo 0x9F20 i>a i8!
  mid 255 and 0x9F21 i>a i8!
  mid 8 u>> inc or 0x9F22 i>a i8!
end

hot fn gfxpx ( x :i y :i )
  x 0 < x __x16_w >= or y 0 < y __x16_h >= or or if return then
  x y 0 __x16_set_addr
  __x16_col 0x9F23 i>a i8!
end

hot fn gfxgetpx ( x :i y :i -> :i )
  x 0 < x __x16_w >= or y 0 < y __x16_h >= or or if -1 return then
  x y 0 __x16_set_addr
  0x9F23 i>a u8@
end

hot fn gfxhline ( x :i y :i w :i )
  y 0 < y __x16_h >= or if return then
  x 0 < if x +-> w 0 -> x then
  x w + __x16_w > if __x16_w x - -> w then
  w 0 <= if return then
  x y 0x10 __x16_set_addr
  begin w 0 > while
    __x16_col 0x9F23 i>a i8!
    -1 +-> w
  repeat
end

hot fn gfxvline ( x :i y :i h :i )
  x 0 < x __x16_w >= or if return then
  y 0 < if y +-> h 0 -> y then
  y h + __x16_h > if __x16_h y - -> h then
  h 0 <= if return then
  x y 0xE0 __x16_set_addr
  begin h 0 > while
    __x16_col 0x9F23 i>a i8!
    -1 +-> h
  repeat
end

hot fn gfxclear ( )
  0 0 0x10 __x16_set_addr
  0x9F23 i>a -> var d0 :a
  __x16_col -> var c :i
  __x16_h -> var row :i
  begin row 0 > while
    40 -> var blk :i
    begin blk 0 > while
      c d0 i8! c d0 i8! c d0 i8! c d0 i8!
      c d0 i8! c d0 i8! c d0 i8! c d0 i8!
      -1 +-> blk
    repeat
    -1 +-> row
  repeat
end

fn gfxcharw ( -> :i ) 8 end
fn gfxcharh ( -> :i ) 8 end

\ Pixel-positioned 8x8 text from VERA VRAM ($1F000) using ISO ASCII font loaded by `gfxmode`.
fn gfxtext ( x :i y :i s :a len :i )
  var buf :bytes 8
  begin
    len 0 >
  while
    s u8@ -> var sc :i
    0 0x9F25 i>a i8!
    sc 3 << 255 and 0x9F20 i>a i8!
    0xF0 sc 5 u>> + 0x9F21 i>a i8!
    0x11 0x9F22 i>a i8!
    0 -> var r :i
    begin r 8 < while
      0x9F23 i>a u8@ buf r a+ i8!
      1 +-> r
    repeat
    0 -> r
    begin r 8 < while
      buf r a+ u8@ -> var bits :i
      bits 0 <> if
        0 -> var c :i
        begin c 8 < while
          bits 128 c u>> and if x c + y r + gfxpx then
          1 +-> c
        repeat
      then
      1 +-> r
    repeat
    8 +-> x
    1 +-> s
    -1 +-> len
  repeat
end
