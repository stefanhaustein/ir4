\ lib/x16/stdio.ir4 - Commander X16 KERNAL console I/O (`$FFD2` / `$FFE4` / `$FFF0`)

extern emit 0xFFD2 ( A :i )
extern __x16_inkey 0xFFE4 ( -> A :i )

fn inkey ( -> :i ) __x16_inkey end

fn key ( -> :i )
  0 -> var c :i
  begin
    inkey -> c
    c 0 =
  while repeat
  c
end

var __x16_charset :i

\ Maps key input to normalized ASCII (direct pass-through in ISO `charset_text`; PETSCII case swap in `charset_native`).
fn xinkey ( -> :i )
  inkey -> var c :i
  c 0 = if 0 return then
  c 20 = if 8 return then
  __x16_charset 1 = if c return then
  c 65 >= c 90 <= and if c 32 + return then
  c 193 >= c 218 <= and if c 128 - return then
  c
end

\ Blocking read using xinkey.
fn xkey ( -> :i )
  0 -> var c :i
  begin
    xinkey -> c
    c 0 =
  while repeat
  c
end

\ Switch between `charset_native` (`0`, `143 emit 142 emit`) and `charset_text` (`1`, `15 emit` ISO-8859-15).
fn setcharset ( mode :i )
  mode 1 = if
    1 -> __x16_charset
    15 emit
  else
    0 -> __x16_charset
    143 emit 142 emit
  then
end

fn getcharset ( -> :i )
  __x16_charset
end

\ Map normalized ASCII to PETSCII (Lowercase/Uppercase mode: A-Z, a-z, _, |).
fn __x16_xlat ( c :i -> :i )
  c 65 >= c 90 <= and if c 128 + return then
  c 97 >= c 122 <= and if c 32 - return then
  c 0x5F = if 0xA4 return then
  c 0x7C = if 0xDD return then
  c
end

\ Maps ASCII to ISO (`charset_text`) or uppercase PETSCII (`charset_native`); uses `$80` verbatim mode for `"` so quote mode never triggers.
fn xemit ( c :i )
  c 10 = c 13 = or if 13 emit return then
  c 8 = if 20 emit return then
  c 34 = if 128 emit 34 emit return then
  c 32 < c 126 > or if return then
  __x16_charset 1 = if
    c emit
    return
  then
  c 65 >= c 90 <= and if
    c emit
  else
    c __x16_xlat emit
  then
end

fn cls ( ) 147 emit end

\ Set KERNAL cursor via PLOT ($FFF0, C=0: X=row, Y=col).
code x16 __x16_plot ( x :i y :i )
  0xBD :i8 0 :as 0x85 :i8 0x02 :i8
  0xBD :i8 2 :as 0xA8 :i8
  0xE8 :i8 0xE8 :i8 0xE8 :i8 0xE8 :i8
  0x8A :i8 0x48 :i8
  0xA6 :i8 0x02 :i8
  0x18 :i8 0x20 :i8 0xF0 :i8 0xFF :i8
  0x68 :i8 0xAA :i8
end

fn gotoxy ( x :i y :i )
  x 0 < if 0 -> x then
  y 0 < if 0 -> y then
  x y __x16_plot
end

fn termwidth ( -> :i ) 80 end
fn termheight ( -> :i ) 60 end

\ ANSI 0..7 -> PETSCII color control bytes (black, red, green, yellow, blue, purple, cyan, white)
data __x16_fg_codes
  144 :i8 28 :i8 30 :i8 158 :i8 31 :i8 156 :i8 159 :i8 5 :i8
end

fn fgcolor ( c :i )
  __x16_fg_codes c 7 and a+ u8@ emit
end

fn bgcolor ( c :i )
  1 emit
  c fgcolor
  1 emit
end
