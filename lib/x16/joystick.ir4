\ lib/x16/joystick.ir4 - Commander X16 KERNAL joystick (ports 0..4) + KEYHDL keyboard-as-joystick (port -1)

data __x16_bit_tbl
  1 :i8 2 :i8 4 :i8 8 :i8 16 :i8 32 :i8 64 :i8 128 :i8
end

var __x16_keys :bytes 16

\ Interrupt-safe KEYHDL ($032E) handler updating __x16_keys bitmap.
code x16 __x16_keyhdl ( )
  0x48 :i8                    \ PHA (orig A)
  0x8A :i8 0x48 :i8           \ TXA; PHA
  0x98 :i8 0x48 :i8           \ TYA; PHA
  0xBA :i8                    \ TSX
  0xBD :i8 0x03 :i8 0x01 :i8  \ LDA $0103,X (orig A)
  0x29 :i8 0x7F :i8           \ AND #$7F
  0x4A :i8 0x4A :i8 0x4A :i8  \ LSR A x3 (byte idx 0..15)
  0xA8 :i8                    \ TAY
  0xBD :i8 0x03 :i8 0x01 :i8  \ LDA $0103,X (orig A)
  0x30 :i8 0x0E :i8           \ BMI key_up (+14)
  \ key_down:
  0x29 :i8 0x07 :i8           \ AND #$07
  0xAA :i8                    \ TAX
  0xBD :i8 & __x16_bit_tbl    \ LDA __x16_bit_tbl,X
  0x19 :i8 & __x16_keys       \ ORA __x16_keys,Y
  0x99 :i8 & __x16_keys       \ STA __x16_keys,Y
  0x80 :i8 0x0E :i8           \ BRA done (+14)
  \ key_up:
  0x29 :i8 0x07 :i8           \ AND #$07
  0xAA :i8                    \ TAX
  0xBD :i8 & __x16_bit_tbl    \ LDA __x16_bit_tbl,X
  0x49 :i8 0xFF :i8           \ EOR #$FF
  0x39 :i8 & __x16_keys       \ AND __x16_keys,Y
  0x99 :i8 & __x16_keys       \ STA __x16_keys,Y
  \ done:
  0x68 :i8 0xA8 :i8           \ PLA; TAY
  0x68 :i8 0xAA :i8           \ PLA; TAX
  0x68 :i8                    \ PLA
end

init
  & __x16_keyhdl 0x032E i>a a!
end

\ Calls KERNAL JOYSTICK_GET ($FF56).
\ Returns active-high (byte1 << 8) | byte0, or 0 if not present.
code x16 __x16_joy_get ( port :i -> :i )
  0x8A :i8                  \ TXA
  0x48 :i8                  \ PHA (save data stack pointer on HW stack)
  0xBD :i8 0 :as            \ LDA 0,X (port)
  0x20 :i8 0x56 :i8 0xFF :i8 \ JSR $FF56 (JOYSTICK_GET)
  0x85 :i8 0x02 :i8         \ STA $02 (save byte0)
  0x86 :i8 0x03 :i8         \ STX $03 (save byte1)
  0x68 :i8                  \ PLA
  0xAA :i8                  \ TAX (restore data stack pointer)
  0xC0 :i8 0xFF :i8         \ CPY #$FF (absent?)
  0xD0 :i8 0x09 :i8         \ BNE +9
  0xA9 :i8 0x00 :i8         \ LDA #$00
  0x9D :i8 0 :as            \ STA 0,X
  0x9D :i8 1 :as            \ STA 1,X
  0x60 :i8                  \ RTS
  0xA5 :i8 0x02 :i8         \ LDA $02 (byte0)
  0x49 :i8 0xFF :i8         \ EOR #$FF (invert byte0)
  0x9D :i8 0 :as            \ STA 0,X
  0xA5 :i8 0x03 :i8         \ LDA $03 (byte1)
  0x49 :i8 0xFF :i8         \ EOR #$FF (invert byte1)
  0x9D :i8 1 :as            \ STA 1,X
end

fn joycount ( -> :i ) 5 end

data __x16_dpad_tbl
  0 :i8 8 :i8 4 :i8 12 :i8 2 :i8 10 :i8 6 :i8 14 :i8
  1 :i8 9 :i8 5 :i8 13 :i8 3 :i8 11 :i8 7 :i8 15 :i8
end

data __x16_btn_tbl
  0  :i8 128 :i8 64 :i8 192 :i8 0  :i8 128 :i8 64 :i8 192 :i8
  16 :i8 144 :i8 80 :i8 208 :i8 16 :i8 144 :i8 80 :i8 208 :i8
end

data __x16_joy_keys
  0x53 :i8  1 :i8  0x12 :i8  1 :i8
  0x54 :i8  2 :i8  0x20 :i8  2 :i8
  0x4F :i8  4 :i8  0x1F :i8  4 :i8
  0x59 :i8  8 :i8  0x21 :i8  8 :i8
  0x3D :i8 16 :i8
end

fn joystate ( port :i -> :i )
  port -1 = if
    0 -> var out :i
    0 -> var i :i
    begin i 18 < while
      __x16_joy_keys i a+ u8@ -> var k :i
      __x16_keys k 3 u>> a+ u8@ __x16_bit_tbl k 7 and a+ u8@ and if
        out __x16_joy_keys i 1 + a+ u8@ or -> out
      then
      2 +-> i
    repeat
    out return
  then
  port 0 < port 4 > or if 0 return then
  port __x16_joy_get -> var raw :i
  __x16_dpad_tbl raw 15 and a+ u8@
  __x16_btn_tbl raw 4 u>> 15 and a+ u8@ or
  raw 0 < if 32 or then
end
