\ System & Input Diagnostics — prints all queryable capabilities, charset, colors, and live state

require "stdio.ir4"
require "terminal.ir4"
require "graphics.ir4"
require "sprite.ir4"
require "sound.ir4"
require "joystick.ir4"

data s_title  "IR4th Diagnostics (" 0 :i8 end
data s_quit   ":quit)" 0 :i8 end
data s_sfx    "Sfx:  " 0 :i8 end
data s_joy    "  Joy: " 0 :i8 end
data s_spr    "Spr:  " 0 :i8 end
data s_slots  " slots " 0 :i8 end
data s_bpp    "bpp" 0 :i8 end
data s_modes  "Gfx Modes (" 0 :i8 end
data s_rpar   "):" 0 :i8 end
data s_hash   "  #" 0 :i8 end
data s_colon  ": " 0 :i8 end
data s_mid    "b (" 0 :i8 end
data s_tick   "Tick: " 0 :i8 end
data s_hexp   " ($" 0 :i8 end
data s_pad4   ")    " 0 :i8 end
data s_inkey  "Inkey:  $" 0 :i8 end
data s_xinkey "XInkey: $" 0 :i8 end
data s_cnt    " cnt=" 0 :i8 end
data s_sp4    "    " 0 :i8 end
data s_jkbd   "Joy Kbd: " 0 :i8 end
data s_jhw    "Joy #" 0 :i8 end
data s_jcol   " : " 0 :i8 end
data s_jhdr   "         4321RLDU" 0 :i8 end
data s_chdr   "   0123456789ABCDEF 0123456789ABCDEF" 0 :i8 end
data s_chdr_n "0123456789ABCDEF0123456789ABCDEF" 0 :i8 end
data s_raw    ":raw  " 0 :i8 end
data s_xplat  ":xplat" 0 :i8 end
data s_nat    ":nat" 0 :i8 end
data s_txt    ":txt" 0 :i8 end
data s_colk   ":" 0 :i8 end

fn print_key ( ch :i )
  3 termfg ch xemit 7 termfg
end

fn draw_charset ( r0 :i use_x :i fg :i cb :i sb :i bd :i )
  termwidth 36 < -> var narrow :i
  7 termfg sb termbg
  0 2 termgoto
  termwidth typei 120 xemit termheight typei 32 emit
  70 print_key s_colk type0 6 termfg fg 2 typehw 7 termfg 32 emit
  66 print_key s_colk type0 6 termfg cb 2 typehw 7 termfg 32 emit
  83 print_key s_colk type0 6 termfg sb 2 typehw 7 termfg 32 emit
  79 print_key s_colk type0 6 termfg bd 2 typehw 7 termfg 32 emit
  67 print_key 6 termfg
  getcharset charset_text = if s_txt else s_nat then type0
  7 termfg 32 emit
  88 print_key
  6 termfg
  use_x if s_xplat else s_raw then type0
  7 termfg
  0 r0 termgoto
  narrow if s_chdr_n else s_chdr then type0
  0 -> var row_i :i
  0x20 -> var base :i
  begin row_i 3 < while
    0 r0 1 + row_i + termgoto
    7 termfg sb termbg
    narrow 0 = if base 2 typehw 58 emit then
    fg termfg cb termbg
    0 -> var col :i
    begin col 32 < while
      narrow 0 = col 16 = and if 32 emit then
      base col + -> var ch :i
      ch 127 < if
        use_x if ch xemit else ch emit then
      then
      1 +-> col
    repeat
    32 +-> base
    1 +-> row_i
    13 emit
    7 termfg sb termbg
  repeat
  7 termfg sb termbg
end

fn draw_static ( use_x :i fg :i cb :i sb :i bd :i -> :i )
  bd gfxborder
  7 termfg sb termbg
  termclear
  0 0 termgoto
  s_title type0 81 print_key s_quit type0

  4 use_x fg cb sb bd draw_charset

  0 10 termgoto
  s_sfx type0 sfxcount typei
  s_joy type0 joycount typei

  0 11 termgoto
  s_spr type0 sprcount typei s_slots type0
  sprmaxw typei 120 xemit sprmaxh typei 32 emit
  sprdepth typei s_bpp type0

  gfxmodes -> var nmodes :i -> var mptr :a
  0 13 termgoto
  s_modes type0 nmodes typei s_rpar type0
  14 -> var row :i
  0 -> var i :i
  begin i nmodes < i 4 < and while
    0 row termgoto
    s_hash type0 i typei s_colon type0
    mptr i 3 << a+ -> var ent :a
    ent 2 a+ i16@ typei 120 xemit
    ent 4 a+ i16@ typei 32 emit
    ent 6 a+ i16@ typei s_mid type0
    ent i16@ typei 41 emit
    1 +-> row
    1 +-> i
  repeat

  row 1 + -> var r_joy :i
  0 r_joy termgoto
  7 termfg
  s_jhdr type0
  r_joy
end

fn print_joy_bits ( mask :i )
  mask 1   and if 85  else 46 then emit   \ 'U'
  mask 2   and if 68  else 46 then emit   \ 'D'
  mask 4   and if 76  else 46 then emit   \ 'L'
  mask 8   and if 82  else 46 then emit   \ 'R'
  mask 16  and if 49  else 46 then emit   \ '1'
  mask 32  and if 50  else 46 then emit   \ '2'
  mask 64  and if 83  else 46 then emit   \ 'S'
  mask 128 and if 84  else 46 then emit   \ 'T'
end

fn main ( )
  0 -> var use_x :i
  7 -> var fg :i
  0 -> var cb :i
  0 -> var sb :i
  0 -> var bd :i
  use_x fg cb sb bd draw_static -> var r_joy :i

  0 -> var last_k :i
  0 -> var prev_k :i
  0 -> var key_cnt :i
  joycount -> var jc :i
  jc 5 > if 5 -> jc then

  begin 1 while
    gfxticks -> var t :i
    16 10 termgoto
    7 termfg s_tick type0 6 termfg t typei 7 termfg

    use_x if xinkey else inkey then -> var k :i
    k 0 <> k prev_k <> and if
      k 113 = k 81 = or if
        0 r_joy jc 2 + + termgoto
        return
      then
      k 120 = k 88 = or if
        1 use_x xor -> use_x
        4 use_x fg cb sb bd draw_charset
      then
      k 99 = k 67 = or if
        getcharset charset_text = if charset_native else charset_text then setcharset
        use_x fg cb sb bd draw_static -> r_joy
      then
      k 102 = k 70 = or if
        fg 1 + 15 and -> fg
        4 use_x fg cb sb bd draw_charset
      then
      k 98 = k 66 = or if
        cb 1 + 15 and -> cb
        4 use_x fg cb sb bd draw_charset
      then
      k 115 = k 83 = or if
        sb 1 + 15 and -> sb
        use_x fg cb sb bd draw_static -> r_joy
      then
      k 111 = k 79 = or if
        bd 1 + 15 and -> bd
        bd gfxborder
        4 use_x fg cb sb bd draw_charset
      then
      k -> last_k
      1 +-> key_cnt
    then
    k -> prev_k
    0 9 termgoto
    use_x if s_xinkey else s_inkey then type0
    6 termfg last_k 2 typehw 32 emit 40 emit
    last_k 32 >= last_k 126 <= and if last_k xemit else 46 emit then
    41 emit s_cnt type0 key_cnt typei
    13 emit
    7 termfg

    -1 -> var p :i
    begin p jc < while
      0 r_joy p 2 + + termgoto
      p -1 = if
        s_jkbd type0
      else
        s_jhw type0 p typei s_jcol type0
      then
      p joystate -> var j :i
      6 termfg
      j 8 typebw s_hexp type0 j 2 typehw 41 emit
      7 termfg
      1 +-> p
    repeat

    gfxvsync
  repeat
end
