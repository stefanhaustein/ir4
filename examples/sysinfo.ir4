\ System & Input Diagnostics — prints all queryable capabilities, charset, colors, and live state

require "stdio.ir4"
require "gfx.ir4"
require "sprite.ir4"
require "sfx.ir4"
require "joy.ir4"

data s_title  "IR4th Diagnostics (" 0 :i8 end
data s_quit   ":quit)" 0 :i8 end
data s_term   "Term: " 0 :i8 end
data s_sfx    "Sfx:  " 0 :i8 end
data s_joy    "  Joy: " 0 :i8 end
data s_spr    "Spr:  " 0 :i8 end
data s_slots  " slots " 0 :i8 end
data s_bpp    "bpp" 0 :i8 end
data s_modes  "Gfx Modes (" 0 :i8 end
data s_rpar   "):" 0 :i8 end
data s_hash   "  #" 0 :i8 end
data s_colon  ": " 0 :i8 end
data s_mid    "b (" 0 :i8 end
data s_tick   "Tick: " 0 :i8 end
data s_hexp   " ($" 0 :i8 end
data s_pad4   ")    " 0 :i8 end
data s_inkey  "Inkey:  $" 0 :i8 end
data s_xinkey "XInkey: $" 0 :i8 end
data s_cnt    " cnt=" 0 :i8 end
data s_sp4    "    " 0 :i8 end
data s_jkbd   "Joy Kbd: " 0 :i8 end
data s_jhw    "Joy #" 0 :i8 end
data s_jcol   " : " 0 :i8 end
data s_jhdr   "         4321RLDU" 0 :i8 end
data s_chdr   "   0123456789ABCDEF 0123456789ABCDEF" 0 :i8 end
data s_chdr_n "0123456789ABCDEF0123456789ABCDEF" 0 :i8 end
data s_emit   ":emit " 0 :i8 end
data s_xemit  ":xemit" 0 :i8 end
data s_colk   ":" 0 :i8 end

fn print_key ( ch :i )
  3 fgcolor ch xemit 7 fgcolor
end

fn draw_charset ( r0 :i use_x :i fg :i bg :i )
  termwidth 36 < -> var narrow :i
  7 fgcolor 0 bgcolor
  0 2 gotoxy
  s_term type0 termwidth typei 120 emit termheight typei 32 emit
  narrow 0 = if 32 emit then
  70 print_key s_colk type0 6 fgcolor fg 2 typeh_w 7 fgcolor 32 emit
  narrow 0 = if 32 emit then
  66 print_key s_colk type0 6 fgcolor bg 2 typeh_w 7 fgcolor 32 emit
  narrow 0 = if 32 emit then
  88 print_key
  6 fgcolor
  use_x if s_xemit else s_emit then type0
  7 fgcolor
  0 r0 gotoxy
  narrow if s_chdr_n else s_chdr then type0
  0 -> var row_i :i
  0x20 -> var base :i
  begin row_i 3 < while
    0 r0 1 + row_i + gotoxy
    7 fgcolor 0 bgcolor
    narrow 0 = if base 2 typeh_w 58 emit then
    fg fgcolor bg bgcolor
    0 -> var col :i
    begin col 32 < while
      narrow 0 = col 16 = and if 32 emit then
      base col + -> var ch :i
      ch 127 < if
        use_x if ch xemit else ch emit then
      then
      1 +-> col
    repeat
    32 +-> base
    1 +-> row_i
    13 emit
  repeat
  7 fgcolor 0 bgcolor
end

fn draw_static ( use_x :i fg :i bg :i -> :i )
  cls
  7 fgcolor 0 bgcolor
  0 0 gotoxy
  s_title type0 81 print_key s_quit type0

  4 use_x fg bg draw_charset

  0 10 gotoxy
  s_sfx type0 sfxcount typei
  s_joy type0 joycount typei

  0 11 gotoxy
  s_spr type0 sprcount typei s_slots type0
  sprmaxw typei 120 emit sprmaxh typei 32 emit
  sprdepth typei s_bpp type0

  gfxmodes -> var nmodes :i -> var mptr :a
  0 13 gotoxy
  s_modes type0 nmodes typei s_rpar type0
  14 -> var row :i
  0 -> var i :i
  begin i nmodes < i 4 < and while
    0 row gotoxy
    s_hash type0 i typei s_colon type0
    mptr i 3 << a+ -> var ent :a
    ent 2 a+ i16@ typei 120 emit
    ent 4 a+ i16@ typei 32 emit
    ent 6 a+ i16@ typei s_mid type0
    ent i16@ typei 41 emit
    1 +-> row
    1 +-> i
  repeat

  row 1 +
end

fn print_joy_bits ( mask :i )
  mask 1   and if 85  else 46 then emit   \ 'U'
  mask 2   and if 68  else 46 then emit   \ 'D'
  mask 4   and if 76  else 46 then emit   \ 'L'
  mask 8   and if 82  else 46 then emit   \ 'R'
  mask 16  and if 49  else 46 then emit   \ '1'
  mask 32  and if 50  else 46 then emit   \ '2'
  mask 64  and if 83  else 46 then emit   \ 'S'
  mask 128 and if 84  else 46 then emit   \ 'T'
end

fn main ( )
  0 -> var use_x :i
  7 -> var fg :i
  0 -> var bg :i
  use_x fg bg draw_static -> var r_joy :i

  0 r_joy gotoxy
  7 fgcolor
  s_jhdr type0

  0 -> var last_k :i
  0 -> var prev_k :i
  0 -> var key_cnt :i
  joycount -> var jc :i
  jc 5 > if 5 -> jc then

  begin 1 while
    gfxticks -> var t :i
    16 10 gotoxy
    7 fgcolor s_tick type0 6 fgcolor t typei 7 fgcolor

    use_x if xinkey else inkey then -> var k :i
    k 0 <> k prev_k <> and if
      k 113 = k 81 = or if
        0 r_joy jc 2 + + gotoxy
        return
      then
      k 120 = k 88 = or if
        1 use_x xor -> use_x
        4 use_x fg bg draw_charset
      then
      k 102 = k 70 = or if
        fg 1 + 15 and -> fg
        4 use_x fg bg draw_charset
      then
      k 98 = k 66 = or if
        bg 1 + 15 and -> bg
        4 use_x fg bg draw_charset
      then
      k -> last_k
      1 +-> key_cnt
    then
    k -> prev_k
    0 9 gotoxy
    use_x if s_xinkey else s_inkey then type0
    6 fgcolor last_k 2 typeh_w 32 emit 40 emit
    last_k 32 >= last_k 126 <= and if last_k xemit else 46 emit then
    41 emit s_cnt type0 key_cnt typei 7 fgcolor
    13 emit

    -1 -> var p :i
    begin p jc < while
      0 r_joy p 2 + + gotoxy
      p -1 = if
        s_jkbd type0
      else
        s_jhw type0 p typei s_jcol type0
      then
      p joystate -> var j :i
      6 fgcolor
      j 8 typeb_w s_hexp type0 j 2 typeh_w 41 emit
      7 fgcolor
      1 +-> p
    repeat

    gfxvsync
  repeat
end
