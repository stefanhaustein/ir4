\ Bouncing Spheres demo using portable graphics.ir4 + sprite.ir4 (C64, X16, Agon)
\ Draws unicolor 21x21 hires spheres (ncolors = 1, 24x21 native on C64) with a separate
\ full-resolution white specular highlight sprite.

require "stdio.ir4"
require "sprite.ir4"
require "sound.ir4"

var spr_buf  :bytes 441
var spec_buf :bytes 25
var pal_buf  :bytes 1
var spec_pal :bytes 1

var bx  :bytes 64
var by8 :bytes 64
var bvx :bytes 64
var bvy :bytes 64
var bbounce :bytes 64
var max_balls :i
var active    :i
var rng_state :i
var ball_off  :i
var hl_off    :i

data sphere_rgb
  255 :i8   0 :i8   0 :i8   \ red
    0 :i8 128 :i8 255 :i8   \ blue
    0 :i8 200 :i8   0 :i8   \ green
  255 :i8 200 :i8   0 :i8   \ yellow
  200 :i8   0 :i8 255 :i8   \ purple
    0 :i8 220 :i8 220 :i8   \ cyan
  255 :i8 128 :i8   0 :i8   \ orange
  255 :i8  85 :i8 170 :i8   \ pink
end

fn rng_next ( -> :i )
  rng_state 25173 * 13849 + -> rng_state
  rng_state 1 u>>
end

fn draw_grid_bg ( )
  0 0 0 gfxrgb gfxcolor
  gfxclear
end

fn draw_h_step ( idx :i )
  0 200 0 gfxrgb gfxcolor
  gfxheight 24 - -> var ybot :i
  ybot 16 - 10 / -> var dy :i
  idx 11 < if
    16 idx dy * + -> var y :i
    40 y 280 y gfxline
    return
  then
  idx 11 = if
    30 ybot 3 + 290 ybot 3 + gfxline
    18 ybot 7 + 302 ybot 7 + gfxline
    4 ybot 12 + 316 ybot 12 + gfxline
  then
end

fn draw_grid_step ( step :i )
  0 200 0 gfxrgb gfxcolor
  gfxheight 24 - -> var ybot :i
  40 step 40 * + -> var x :i
  x 280 <= if
    x 16 x ybot gfxline
    x ybot 160 x 160 - 13 * 10 / + ybot 12 + gfxline
    20 +-> x
    x 280 <= if
      x 16 x ybot gfxline
      x ybot 160 x 160 - 13 * 10 / + ybot 12 + gfxline
    then
  then
end

fn build_sphere_mask ( )
  0 -> var idx :i
  0 -> var py :i
  begin py 21 < while
    py 10 - -> var dy :i
    0 -> var px :i
    begin px 21 < while
      px 10 - -> var dx :i
      dx dx * dy dy * + 105 < if 1 else 0 then spr_buf idx a+ i8!
      1 +-> idx
      1 +-> px
    repeat
    py 1 and 0 = if py 1 >> draw_h_step then
    1 +-> py
  repeat
  11 draw_h_step
end

fn build_spec_sprite ( )
  0 -> var idx :i
  0 -> var py :i
  begin py 5 < while
    py 2 - -> var dy :i
    0 -> var px :i
    begin px 5 < while
      px 2 - -> var dx :i
      dx dx * dy dy * + 5 <= if 1 else 0 then spec_buf idx a+ i8!
      1 +-> idx
      1 +-> px
    repeat
    1 +-> py
  repeat
  255 255 255 gfxrgb spec_pal i8!
  0 5 5 spec_buf spec_pal 1 sprimg drop
end

fn setup_sprites ( )
  sprcount 1 >> -> max_balls
  max_balls 32 > if 32 -> max_balls then
  build_sphere_mask
  build_spec_sprite
  max_balls 8 < if max_balls else 8 then -> var ncols :i
  0 -> var s :i
  0 -> var i :i
  begin i ncols < while
    sphere_rgb i 3 * a+ -> var p :a
    p u8@ p 1 a+ u8@ p 2 a+ u8@ gfxrgb pal_buf i8!
    i 1 + 21 21 spr_buf pal_buf 1 sprimg drop
    i 1 + 3 << -> var target_s :i
    begin s ncols * target_s < while
      s draw_grid_step
      1 +-> s
    repeat
    1 +-> i
  repeat
end

fn add_ball ( )
  active max_balls >= if return then
  active -> var i :i
  i 1 << -> var off :i
  480 rng_next 3520 mod + -> var x8 :i
  x8 bx off a+ i16!
  -672 by8 off a+ i16!
  rng_next 5 mod 7 + rng_next 1 and 0 = if 0 swap - then bvx off a+ i16!
  0 bvy off a+ i16!
  rng_next 12 mod 95 - bbounce off a+ i16!
  i 1 << -> var sid :i
  x8 4 >> -> var sx :i
  -672 5 >> -> var sy :i
  sid ball_off + i 7 and 1 + sprset
  sid hl_off + 0 sprset
  sid ball_off + sx sy sprpos
  sid hl_off + sx 8 + sy 3 + sprpos
  sid 1 sprshow
  sid 1 + 1 sprshow
  1 +-> active
end

hot fn step_balls ( floor8 :i )
  0 -> var i :i
  begin i active < while
    i 1 << -> var off :i
    bx off a+ -> var px :a
    bvx off a+ -> var pv :a
    px i16@ pv i16@ + -> var x8 :i
    x8 384 < if
      384 -> x8 0 pv i16@ - pv i16!
    else
      x8 4352 > if 4352 -> x8 0 pv i16@ - pv i16! then
    then
    x8 px i16!

    bvy off a+ -> var pvy :a
    by8 off a+ -> var py :a
    pvy i16@ 1 + -> var vy :i
    py i16@ vy + -> var y8 :i
    y8 floor8 >= if
      floor8 -> y8
      bbounce off a+ i16@ -> vy
      0 110 i 7 and 12 * + 10 2 65 sfxplay
    then
    vy pvy i16!
    y8 py i16!

    x8 4 >> -> var sx :i
    y8 5 >> -> var sy :i
    sx 100 < if 9 else sx 200 > if 7 else 8 then then -> var hx :i
    ball_off 0 <> if
      off 1 + sx sy sprpos
      off sx hx + sy 3 + sprpos
    else
      off sx sy sprpos
      off 1 + sx hx + sy 3 + sprpos
    then
    1 +-> i
  repeat
end

fn drop_ball ( )
  active 4 <= if return then
  -1 +-> active
  active 1 << -> var sid :i
  sid 0 sprshow
  sid 1 + 0 sprshow
end

hot fn run_loop ( floor8 :i )
  0 -> var elapsed :i
  gfxticks -> var prev_t :i
  0 -> var sum_dt :i
  0 -> var fcnt :i
  0 -> var base_dt :i

  begin inkey 0 = while
    floor8 step_balls
    gfxvsync
    sfxtick
    gfxticks -> var now_t :i
    now_t prev_t - 255 and -> var dt :i
    now_t -> prev_t
    dt +-> elapsed
    dt +-> sum_dt
    1 +-> fcnt
    fcnt 4 >= if
      base_dt 0 = if
        sum_dt -> base_dt
      else
        sum_dt base_dt < if sum_dt -> base_dt then
        sum_dt base_dt 1 + > if
          drop_ball
          0 -> elapsed
        then
      then
      0 -> sum_dt
      0 -> fcnt
    then
    elapsed 240 >= if
      add_ball
      0 -> elapsed
      0 -> sum_dt
      0 -> fcnt
    then
  repeat
end

data err_msg
  "Insufficient sprite size/count (need 21x21, 2 sprites)\n" 0 :i8
end

fn main ( -> :i )
  sprmaxw 21 < sprmaxh 21 < or sprcount 2 < or if
    err_msg type0
    1 return
  then
  1 -> ball_off
  0 -> hl_off
  320 240 6 gfxinit
  draw_grid_bg
  setup_sprites

  12345 -> rng_state
  0 -> active
  gfxheight 39 - 5 << -> var floor8 :i
  add_ball
  floor8 run_loop
  0 sfxstop
  0 -> var i :i
  begin i active 1 << < while
    i 0 sprshow
    1 +-> i
  repeat
  gfxdone
  0
end
