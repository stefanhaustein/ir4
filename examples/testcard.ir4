\ Telefunken FuBK-inspired TV test card using graphics.ir4
\ Centered grid, overlapping outer gfxcircle, 8 EBU bars, 7-step gray,
\ center black bar + frequency grating + amber + pointer, and RGB/gray gradients.

require "stdio.ir4"
require "terminal.ir4"
require "graphics.ir4"

var w :i
var h :i
var cx :i
var cy :i
var step :i
var rw :i
var rh :i
var rx :i
var ry :i
var r :i

var c_black :i
var c_dgray :i
var c_gray :i
var c_lgray :i
var c_white :i
var c_yellow :i
var c_cyan :i
var c_green :i
var c_magenta :i
var c_red :i
var c_blue :i
var c_amber :i

data s_label "IR (4th)" end

fn init_colors ( )
  0 0 0 gfxrgb -> c_black
  64 64 64 gfxrgb -> c_dgray
  128 128 128 gfxrgb -> c_gray
  192 192 192 gfxrgb -> c_lgray
  255 255 255 gfxrgb -> c_white
  255 255 0 gfxrgb -> c_yellow
  0 255 255 gfxrgb -> c_cyan
  0 255 0 gfxrgb -> c_green
  255 0 255 gfxrgb -> c_magenta
  255 0 0 gfxrgb -> c_red
  0 0 255 gfxrgb -> c_blue
  200 140 0 gfxrgb -> c_amber
end

fn ebu_color ( idx :i -> :i )
  idx 0 = if c_lgray return then
  idx 1 = if c_yellow return then
  idx 2 = if c_cyan return then
  idx 3 = if c_green return then
  idx 4 = if c_magenta return then
  idx 5 = if c_red return then
  idx 6 = if c_blue return then
  c_black
end

\ Compute grid step and centered card bounds aligned to (w/termwidth, h/termheight) cells
fn init_geom ( )
  gfxwidth -> w
  gfxheight -> h
  w termwidth / -> var cw :i
  cw 1 < if 1 -> cw then
  h termheight / -> var ch :i
  ch 1 < if 1 -> ch then

  h 16 / cw + 1 - cw / cw * -> step
  step 4 < if 4 -> step then
  step 12 * -> rw
  step 10 * -> rh
  rw w 4 - > if w 4 - -> rw then
  rh h 4 - > if h 4 - -> rh then
  step 20 * 3 / -> r

  w 1 u>> cw / cw * -> cx
  h 1 u>> ch / ch * -> cy
  \ On 2px-tall cell-snapping block modes where bar_h = step < 3 * ch (2 rows),
  \ shift cy by 1px so the black-bar label lands on its own row clear of the cy center line.
  ch 2 = gfxcharh 2 = and step ch 3 * < and if
    cy rh 1 u>> - 0 > if
      -1 +-> cy
    else cy rh 1 u>> + 2 + h <= if
      1 +-> cy
    then then
  then
  cx rw 1 u>> - -> rx
  cy rh 1 u>> - -> ry
end

fn draw_background ( )
  c_white gfxcolor
  gfxclear
  c_dgray gfxcolor
  0 0 w h gfxfillrect

  w 120 < if return then

  c_white gfxcolor
  cx step mod -> var x :i
  begin x w < while
    x 0 h gfxvline
    step +-> x
  repeat
  cy step mod -> var y :i
  begin y h < while
    0 y w gfxhline
    step +-> y
  repeat
end

\ Row 1: 8 EBU color bars
fn draw_ebu_bars ( rx :i ry :i rw :i rh :i )
  0 -> var i :i
  begin i 8 < while
    rx rw i * 8 / + -> var x0 :i
    i 7 = if rx rw + else rx rw i 1 + * 8 / + then -> var x1 :i
    i ebu_color gfxcolor
    x0 ry x1 x0 - rh gfxfillrect
    1 +-> i
  repeat
end

\ Row 2: 5 equal-width grayscale blocks (Black -> White)
fn draw_gray_steps ( rx :i ry :i rw :i rh :i )
  0 -> var i :i
  begin i 5 < while
    rx rw i * 5 / + -> var x0 :i
    i 4 = if rx rw + else rx rw i 1 + * 5 / + then -> var x1 :i
    i 4 = if 255 else i 6 << then -> var v :i
    v v v gfxrgb gfxcolor
    x0 ry x1 x0 - rh gfxfillrect
    1 +-> i
  repeat
end

\ Row 3: White field with black bar, 3-zone frequency grating (1&2 left of cx, 3 right of cx) + amber, and center pointer
fn draw_center_band ( rx :i ry :i rw :i rh :i cx :i step :i )
  c_white gfxcolor
  rx ry rw rh gfxfillrect

  \ Black horizontal bar (top third, aligned to the middle 3 of the 5 gray blocks)
  rh 3 / -> var bar_h :i
  bar_h 2 < if 2 -> bar_h then
  rx rw 5 / + -> var bar_x :i
  rx rw 4 * 5 / + bar_x - -> var bar_w :i
  c_black gfxcolor
  bar_x ry bar_w bar_h gfxfillrect
  bar_h gfxcharh >= if
    c_white gfxcolor
    cx 5 gfxcharw * 1 u>> -
    ry bar_h gfxcharh - 1 u>> +
    s_label 8 gfxtext
  then

  \ Frequency grating on gray background: starts at yellow box (rx + rw/8), blocks 1 & 2 left of cx, block 3 right of cx
  ry bar_h + -> var gr_y :i
  rh 3 / -> var gr_h :i
  gr_h 2 < if 2 -> gr_h then
  rx rw 8 / + -> var gr_x :i
  cx gr_x - 1 u>> -> var b1_w :i
  cx gr_x - b1_w - -> var b2_w :i
  b1_w -> var b3_w :i
  b1_w b2_w + b3_w + -> var gr_w :i

  c_gray gfxcolor
  gr_x gr_y rx rw + gr_x - gr_h gfxfillrect

  \ Block 1 (coarse): [0 .. b1_w)
  3 -> var x :i
  begin x b1_w 2 - < while
    x 6 mod -> var period :i
    period 0 = period 5 = or if c_black else
    period 2 = period 3 = or if c_white else c_gray then then
    gfxcolor
    gr_x x + gr_y gr_h gfxvline
    1 +-> x
  repeat

  \ Block 2 (medium): [b1_w .. b1_w + b2_w), ends at cx
  b1_w 2 + -> x
  begin x b1_w b2_w + 2 - < while
    x 4 mod -> period
    period 0 = if c_black else period 2 = if c_white else c_gray then then
    gfxcolor
    gr_x x + gr_y gr_h gfxvline
    1 +-> x
  repeat

  \ Block 3 (fine): [b1_w + b2_w .. gr_w), symmetric 3 px right of cx
  b1_w b2_w + 3 + -> x
  begin x gr_w 2 - < while
    x 1 and 0 = if c_dgray else c_lgray then
    gfxcolor
    gr_x x + gr_y gr_h gfxvline
    1 +-> x
  repeat

  \ Amber block to the right of Block 3
  step 3 * -> var amb_w :i
  gr_x gr_w + amb_w + rx rw + > if rx rw + gr_x gr_w + - -> amb_w then
  amb_w 0 > if
    c_amber gfxcolor
    gr_x gr_w + gr_y amb_w gr_h gfxfillrect
  then

  \ Small one-sided (right-half) black downward pointer centered around cx
  gr_y gr_h + -> var tri_y :i
  ry rh + tri_y - -> var tri_h :i
  c_black gfxcolor
  0 -> var dy :i
  begin dy tri_h < while
    tri_h dy - 1 + 1 u>> -> var tw :i
    tw 0 > if
      cx tri_h 2 u>> - tri_y dy + tw gfxhline
    then
    1 +-> dy
  repeat

  \ White vertical center line through black bar and gap between blocks 2 & 3 to meet arrow
  c_white gfxcolor
  cx ry bar_h gr_h + gfxvline
end

\ Smooth 6-segment RGB rainbow gradient (16-bit safe)
fn draw_color_grad ( rx :i ry :i rw :i rh :i )
  0 -> var r :i
  0 -> var g :i
  0 -> var b :i
  0 -> var x :i
  begin x rw < while
    x 6 * -> var p :i
    p rw / -> var seg :i
    p rw mod 127 * rw / 1 << -> var up :i
    255 up - -> var dn :i
    seg 0 = if 255 -> r  up -> g  0 -> b else
    seg 1 = if dn -> r  255 -> g  0 -> b else
    seg 2 = if 0 -> r  255 -> g  up -> b else
    seg 3 = if 0 -> r  dn -> g  255 -> b else
    seg 4 = if up -> r  0 -> g  255 -> b else
               255 -> r  0 -> g  dn -> b
    then then then then then
    r g b gfxrgb gfxcolor
    rx x + ry rh gfxvline
    1 +-> x
  repeat
end

\ Smooth 0..254 grayscale gradient (16-bit safe)
fn draw_gray_grad ( rx :i ry :i rw :i rh :i )
  rw 1 - -> var d :i
  d 1 < if 1 -> d then
  0 -> var x :i
  begin x rw < while
    x 127 * d / 1 << -> var v :i
    v v v gfxrgb gfxcolor
    rx x + ry rh gfxvline
    1 +-> x
  repeat
end

fn draw_testcard ( )
  \ Row 1: 8 EBU color bars (3 grid cells)
  step 3 * -> var bh :i
  ry -> var y0 :i
  rx y0 rw bh draw_ebu_bars
  bh +-> y0

  \ Row 2: 5 equal grayscale blocks (2 grid cells) + white center line
  step 1 << -> bh
  rx y0 rw bh draw_gray_steps
  c_white gfxcolor
  cx y0 bh gfxvline
  bh +-> y0

  \ Row 3: Center black bar + frequency grating + amber + pointer (3 grid cells)
  step 3 * -> bh
  rx y0 rw bh cx step draw_center_band
  bh +-> y0

  \ Row 4: Stacked RGB rainbow + smooth grayscale gradients (2 grid cells)
  ry rh + y0 - -> bh
  bh 1 u>> -> var gh :i
  gh 0 > if
    rx y0 rw gh draw_color_grad
    rx y0 gh + rw bh gh - draw_gray_grad
  then

  \ Redraw horizontal center line + frame center rectangle + foreground circle with white
  c_white gfxcolor
  rx cy rw gfxhline
  rx ry rw 1 + rh 1 + gfxrect
  cx cy r gfxcircle
end

fn main ( -> :i )
  320 240 8 gfxinit
  init_geom
  init_colors
  draw_background
  draw_testcard
  key drop
  gfxdone
  0
end
