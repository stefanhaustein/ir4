\ Cross-platform 6-bit fixed-point Mandelbrot set using graphics.ir4
\ 1.0 = 64 (fits safely in 16-bit :i on 6502/Z80 as well as 24/32/64-bit targets)

require "stdio.ir4"
require "graphics.ir4"

var pal :bytes 64

fn init_pal ( )
  gfxdepth -> var d :i
  0 pal i8!
  1 -> var i :i
  begin i 32 < while
    d 1 = if
      i 1 and
    else
      i 3 << 255 and
      i 5 << 255 and
      i 7 << 255 and
      gfxrgb
    then
    pal i a+ i8!
    1 +-> i
  repeat
end

hot fn mandel_px ( cr :i ci :i -> :i )
  0 -> var zr :i
  0 -> var zi :i
  0 -> var it :i
  begin it 32 < while
    zr zr * 6 >> -> var zr2 :i
    zi zi * 6 >> -> var zi2 :i
    zr2 zi2 + 256 > if
      it return
    then
    zr zi * 5 >> ci + -> zi
    zr2 zi2 - cr + -> zr
    1 +-> it
  repeat
  0
end

fn render_mandel ( )
  gfxwidth -> var w :i
  gfxheight -> var h :i
  0 gfxcolor
  gfxclear
  0 -> var py :i
  begin py h < while
    py 36 * h 2 u>> / 72 - -> var ci :i
    0 -> var px :i
    0 -> var x0 :i
    -1 -> var c :i
    begin px w < while
      px 48 * w 2 u>> / 134 - -> var cr :i
      pal cr ci mandel_px a+ u8@ -> var nc :i
      nc c <> if
        c 0 > if
          c gfxcolor
          x0 py px x0 - gfxhline
        then
        px -> x0
        nc -> c
      then
      1 +-> px
    repeat
    c 0 > if
      c gfxcolor
      x0 py w x0 - gfxhline
    then
    1 +-> py
  repeat
end

fn main ( -> :i )
  160 120 8 gfxinit
  init_pal
  render_mandel
  key drop
  gfxdone
  0
end
