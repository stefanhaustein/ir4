\ Amiga Boing Ball demo using portable graphics.ir4 + sprite.ir4 (Agon Light & Commander X16)
\ Procedurally generates 8 rotation frames of a 64x64 tilted checkered sphere
\ using 16-bit integer isqrt + atan LUT, uploads them via sprimg/sprset, and bounces at 60 fps.

require "stdio.ir4"
require "sprite.ir4"
require "sound.ir4"

var ilat_buf :bytes 4096
var ilon_buf :bytes 4096
var spr_buf  :bytes 4096
var num_frames :i
var shadow_spr :i
var ball_spr   :i

data atan_lut
  0 :i8 1 :i8 2 :i8 3 :i8 4 :i8 5 :i8 5 :i8 6 :i8 7 :i8
  8 :i8 9 :i8 9 :i8 10 :i8 10 :i8 11 :i8 12 :i8 12 :i8
end

var ball_pal :bytes 2
var shadow_pal :bytes 1

fn draw_grid_bg ( )
  \ Grey background
  170 170 170 gfxrgb gfxcolor
  gfxclear
end

fn draw_h_step ( py :i )
  170 0 255 gfxrgb gfxcolor
  py 3 and 0 <> if return then
  py 2 >> -> var idx :i
  gfxheight 24 - -> var ybot :i
  ybot 16 - 10 / -> var dy :i
  idx 11 < if
    16 idx dy * + -> var y :i
    40 y 280 y gfxline
    return
  then
  idx 11 = if
    30 ybot 3 + 290 ybot 3 + gfxline
    18 ybot 7 + 302 ybot 7 + gfxline
    4 ybot 12 + 316 ybot 12 + gfxline
  then
end

fn draw_grid_step ( step :i )
  170 0 255 gfxrgb gfxcolor
  gfxheight 24 - -> var ybot :i
  40 step 40 * + -> var x :i
  x 280 <= if
    x 16 x ybot gfxline
    x ybot 160 x 160 - 13 * 10 / + ybot 12 + gfxline
    20 +-> x
    x 280 <= if
      x 16 x ybot gfxline
      x ybot 160 x 160 - 13 * 10 / + ybot 12 + gfxline
    then
  then
end

hot fn isqrt ( n :i -> :i )
  n 0 <= if 0 return then
  0 -> var res :i
  16384 -> var bit :i
  begin bit n > while bit 2 u>> -> bit repeat
  begin bit 0 <> while
    n res bit + >= if
      n res bit + - -> n
      res 1 u>> bit + -> res
    else
      res 1 u>> -> res
    then
    bit 2 u>> -> bit
  repeat
  res
end

hot fn iatan_half ( y :i x :i -> :i )
  y 0 < if 0 y - else y then -> var ay :i
  0 -> var a :i
  x 0 = ay 0 = and if 0 return then
  ay x <= if
    atan_lut ay 4 << x / a+ u8@ -> a
  else
    24 atan_lut x 4 << ay / a+ u8@ - -> a
  then
  y 0 < if 0 a - return then
  a
end

hot fn precompute_sphere ( )
  0 -> var idx :i
  0 -> var py :i
  begin py 64 < while
    py 32 - -> var fy :i
    0 -> var px :i
    begin px 64 < while
      px 32 - -> var fx :i
      fx fx * fy fy * + -> var r2 :i
      r2 1024 >= if
        -1 ilat_buf idx a+ i8!
        0 ilon_buf idx a+ i8!
      else
        1024 r2 - 4 << isqrt -> var fz :i
        fx 24 * fy 7 * - 2 << 25 / -> var tx :i
        fx 7 * fy 24 * + 2 << 25 / -> var ty :i
        16384 ty ty * - isqrt -> var ryz :i
        ty ryz iatan_half 24 + 6 * 49 / ilat_buf idx a+ i8!
        tx fz iatan_half 24 + ilon_buf idx a+ i8!
      then
      1 +-> idx
      1 +-> px
    repeat
    py draw_h_step
    1 +-> py
  repeat
end

hot fn upload_ball_frame ( frame :i )
  0 -> var idx :i
  begin idx 4096 < while
    ilat_buf idx a+ i8@ -> var ilat :i
    ilat 0 < if
      0 spr_buf idx a+ i8!
    else
      ilon_buf idx a+ u8@ frame 1 << + 3 >> -> var ilon :i
      ilat ilon + 1 and 0 = if 2 else 1 then spr_buf idx a+ i8!
    then
    1 +-> idx
  repeat
  frame 1 + 64 64 spr_buf ball_pal 2 sprimg 0 <> if
    1 +-> num_frames
  then
end

hot fn upload_shadow ( )
  0 -> var idx :i
  0 -> var py :i
  begin py 64 < while
    py 32 - -> var y :i
    0 -> var px :i
    begin px 64 < while
      px 32 - -> var x :i
      x x * y y * + 1024 >= px py + 1 and 0 <> or if
        0 spr_buf idx a+ i8!
      else
        1 spr_buf idx a+ i8!
      then
      1 +-> idx
      1 +-> px
    repeat
    1 +-> py
  repeat
  0 64 64 spr_buf shadow_pal 1 sprimg drop
  shadow_spr 0 sprset
end

fn setup_sprites ( )
  0 -> num_frames
  255 255 255 gfxrgb ball_pal i8!
  255 0 0 gfxrgb ball_pal 1 a+ i8!
  0 0 0 gfxrgb shadow_pal i8!
  precompute_sphere
  upload_shadow
  0 draw_grid_step
  0 -> var f :i
  begin f 8 < while
    f upload_ball_frame
    f 1 + draw_grid_step
    1 +-> f
  repeat
end

data err_msg
  "Insufficient sprite size/count (need 64x64, 2 sprites)\n" 0 :i8
end

fn main ( -> :i )
  sprmaxw 64 < sprmaxh 64 < or sprcount 2 < or if
    err_msg type0
    1 return
  then
  1 -> shadow_spr
  0 -> ball_spr
  320 240 6 gfxinit
  draw_grid_bg
  setup_sprites
  40 -> var x :i
  400 -> var y8 :i
  1 -> var vx :i
  0 -> var vy :i
  0 -> var tick :i
  1 -> var f :i
  ball_spr 1 sprset
  shadow_spr x 10 + y8 4 >> 2 - sprpos
  ball_spr x y8 4 >> sprpos
  shadow_spr 1 sprshow
  ball_spr 1 sprshow
  gfxheight 76 - 4 << -> var floor8 :i
  begin inkey 0 = while
    vx +-> x
    x 30 < if 30 -> x 1 -> vx 0 180 10 2 60 sfxplay then
    x 216 > if 216 -> x -1 -> vx 0 180 10 2 60 sfxplay then
    1 +-> vy
    vy +-> y8
    y8 floor8 >= if
      floor8 -> y8
      -54 -> vy
      0 120 14 2 110 sfxplay
    then
    tick 1 and 0 = if
      vx 0 > if
        f 1 = if num_frames -> f else -1 +-> f then
      else
        f num_frames >= if 1 -> f else 1 +-> f then
      then
      ball_spr f sprset
    then
    shadow_spr x 10 + y8 4 >> 2 - sprpos
    ball_spr x y8 4 >> sprpos
    gfxvsync
    sfxtick
    1 +-> tick
  repeat
  0 sfxstop
  shadow_spr 0 sprshow
  ball_spr 0 sprshow
  gfxdone
  0
end
