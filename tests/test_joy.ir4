\ Test lib/joy.ir4 (joycount, joystate, out-of-range ports, keyboard port -1)

require "joy.ir4"

fn main ( -> :i )
  joycount -> var cnt :i
  cnt 0 < if 1 return then

  target_c64 if cnt 2 <> if 2 return then then
  target_x16 if cnt 5 <> if 3 return then then
  target_agon if cnt 0 <> if 4 return then then
  target_c64 target_x16 or target_agon or 0 = if
    cnt 0 <> if 5 return then
  then

  \ Out-of-range ports must return 0 cleanly
  -2 joystate 0 <> if 6 return then
  cnt joystate 0 <> if 7 return then
  99 joystate 0 <> if 8 return then

  \ Keyboard-as-joystick (-1) and valid hardware ports (0..cnt-1)
  -1 joystate -> var kst :i
  kst 0 < if 9 return then
  target_c64 target_x16 or target_agon or 0 = if
    kst 0 <> if 10 return then
  then

  0 -> var p :i
  begin p cnt < while
    p joystate drop
    1 +-> p
  repeat

  \ Repeated poll loop (50x catches stack leaks)
  0 -> var i :i
  begin i 50 < while
    -1 joystate drop
    -2 joystate 0 <> if 11 return then
    cnt joystate 0 <> if 12 return then
    cnt 0 > if 0 joystate drop then
    1 +-> i
  repeat

  0
end
