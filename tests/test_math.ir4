\ math.ir4 - Tests for lib/math.ir4
\ Expected main() return value: 0

require "../lib/math.ir4"

fn assert_near ( got :f expected :f code :i -> :i )
  got expected f- fabs 0.001 f< if 0 return then
  code
end

fn assert_eq ( got :i expected :i code :i -> :i )
  got expected = if 0 return then
  code
end

fn main ( -> :i )
  \ fabs, fint, frac, fround
  -3.25 fabs 3.25 1 assert_near
  dup 0 <> if return then drop
  -3.75 fint -3.0 2 assert_near
  dup 0 <> if return then drop
  100000.75 fint 100000.0 25 assert_near
  dup 0 <> if return then drop
  -100000.75 frac -0.75 26 assert_near
  dup 0 <> if return then drop
  3.25 frac 0.25 3 assert_near
  dup 0 <> if return then drop
  2.6 fround 3 4 assert_eq
  dup 0 <> if return then drop
  -2.6 fround -3 5 assert_eq
  dup 0 <> if return then drop

  \ sqrt
  2.0 sqrt 1.4142135 6 assert_near
  dup 0 <> if return then drop
  9.0 sqrt 3.0 7 assert_near
  dup 0 <> if return then drop
  0.25 sqrt 0.5 8 assert_near
  dup 0 <> if return then drop
  10000.0 sqrt 100.0 9 assert_near
  dup 0 <> if return then drop

  \ sin & cos
  0.0 sin 0.0 10 assert_near
  dup 0 <> if return then drop
  1.5707963 sin 1.0 11 assert_near
  dup 0 <> if return then drop
  0.5235988 sin 0.5 12 assert_near
  dup 0 <> if return then drop
  -1.5707963 sin -1.0 13 assert_near
  dup 0 <> if return then drop
  0.0 cos 1.0 14 assert_near
  dup 0 <> if return then drop
  3.1415926 cos -1.0 15 assert_near
  dup 0 <> if return then drop

  \ arctan
  0.2 arctan 0.1973956 35 assert_near
  dup 0 <> if return then drop
  0.5 arctan 0.4636476 36 assert_near
  dup 0 <> if return then drop
  1.0 arctan 0.7853982 16 assert_near
  dup 0 <> if return then drop
  -1.0 arctan -0.7853982 17 assert_near
  dup 0 <> if return then drop
  2.0 arctan 1.1071487 18 assert_near
  dup 0 <> if return then drop

  \ atan2
  1.0 1.0 atan2 0.7853982 27 assert_near
  dup 0 <> if return then drop
  1.0 -1.0 atan2 2.3561945 28 assert_near
  dup 0 <> if return then drop
  -1.0 -1.0 atan2 -2.3561945 29 assert_near
  dup 0 <> if return then drop
  -1.0 1.0 atan2 -0.7853982 30 assert_near
  dup 0 <> if return then drop
  1.0 0.0 atan2 1.5707963 31 assert_near
  dup 0 <> if return then drop
  -1.0 0.0 atan2 -1.5707963 32 assert_near
  dup 0 <> if return then drop
  0.0 -1.0 atan2 3.1415927 33 assert_near
  dup 0 <> if return then drop
  0.0 0.0 atan2 0.0 34 assert_near
  dup 0 <> if return then drop

  \ exp & ln
  0.0 exp 1.0 19 assert_near
  dup 0 <> if return then drop
  1.0 exp 2.7182818 20 assert_near
  dup 0 <> if return then drop
  -1.0 exp 0.3678794 21 assert_near
  dup 0 <> if return then drop
  1.0 ln 0.0 22 assert_near
  dup 0 <> if return then drop
  2.7182818 ln 1.0 23 assert_near
  dup 0 <> if return then drop
  10.0 ln 2.3025851 24 assert_near
end
