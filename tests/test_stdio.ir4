\ Test lib/stdio.ir4 (stream output, formatting, charset, non-blocking input; skips blocking key/xkey)

require "stdio.ir4"

data s_abc "ABC" 0 :i8 end
data s_hi "Hi" end

fn main ( -> :i )
  \ Non-blocking input calls must return cleanly without blocking
  inkey drop
  xinkey drop

  \ Charset selection & query
  charset_native setcharset
  target_c64 target_x16 or target_zx81 or if
    getcharset charset_native <> if 10 return then
  else
    getcharset charset_text <> if 10 return then
  then
  charset_text setcharset
  target_zx81 if
    getcharset charset_native <> if 11 return then
  else
    getcharset charset_text <> if 11 return then
  then

  \ String and numeric formatting
  s_hi 2 type
  s_abc type0
  0 typeu
  65535 typeu
  -123 typei
  42 5 typeiw
  0x1A typeh
  0x0F 4 typehw
  5 typeb
  5 8 typebw
  65 emit
  66 xemit
  34 xemit
  cr

  \ Repeated formatting loop (50x catches stack leaks on 6502 ZP stack)
  0 -> var i :i
  begin i 50 < while
    s_abc type0
    i 2 typehw
    i 8 typebw
    i typei
    41 emit
    1 +-> i
  repeat

  cr
  0
end
