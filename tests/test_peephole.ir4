\ Test that peephole lookahead fusions do not cross branch targets

data d_a 0x11 :i8 0x22 :i8 0x33 :i8 0x44 :i8 end
data d_b 0x55 :i8 0x66 :i8 0x77 :i8 0x88 :i8 end
var gbuf :bytes 8

\ 1. local_add_imm: if <imm> else <imm> then +-> local (hot & cold)
hot fn hot_ladd ( x :i c :i -> :i )
  c 0 <> if 313 else 1 then +-> x
  x
end

fn cold_ladd ( x :i c :i -> :i )
  c 0 <> if 313 else 1 then +-> x
  x
end

hot fn hot_aadd ( p :a c :i -> :a )
  c 0 <> if 313 else 1 then +-> p
  p
end

\ 2. add_imm / sub_imm / aadd / asub across branch target
hot fn test_add_imm ( x :i c :i -> :i )
  x c 0 <> if 10 else 20 then +
end

hot fn test_sub_imm ( x :i c :i -> :i )
  x c 0 <> if 10 else 20 then -
end

hot fn test_aadd_imm ( c :i -> :i )
  d_a c 0 <> if 2 else 1 then a+ u8@
end

hot fn test_asub_imm ( c :i -> :i )
  d_a 3 a+ c 0 <> if 2 else 1 then a- u8@
end

\ 3. cmp_imm, shift_imm, bit_imm across branch target
hot fn test_cmp_imm ( x :i c :i -> :i )
  x c 0 <> if 5 else 3 then = if 1 else 0 then
end

hot fn test_shift_imm ( x :i c :i -> :i )
  x c 0 <> if 2 else 1 then <<
end

hot fn test_ushift_imm ( x :i c :i -> :i )
  x c 0 <> if 2 else 1 then u>>
end

hot fn test_bit_imm ( x :i c :i -> :i )
  x c 0 <> if 0x05 else 0x03 then and
end

\ 4. mem_imm (store & fetch) across branch target
hot fn test_mem_imm ( c :i -> :i )
  0xAA gbuf 1 a+ i8!
  0xBB gbuf 3 a+ i8!
  0xCC gbuf c 0 <> if 3 else 1 then a+ i8!
  gbuf c 0 <> if 3 else 1 then a+ u8@
end

\ 5. data_mem (IR_PUSH_DATA + u8@) across branch target
hot fn test_data_mem ( c :i -> :i )
  c 0 <> if d_a else d_b then u8@
end

\ 6. local_mem (LOCAL_ADDR + u8@ / a+ u8@) across branch target
hot fn test_local_mem ( c :i -> :i )
  var loc_a :bytes 4
  var loc_b :bytes 4
  0x42 loc_a i8!
  0x99 loc_b i8!
  0x77 loc_a 2 a+ i8!
  0x88 loc_a 1 a+ i8!
  c 0 <> if loc_a else loc_b then u8@
  loc_a c 0 <> if 2 else 1 then a+ u8@ +
end

\ 7. Backend peep_fence: push before branch, consume (dup/drop/swap/+) after then
hot fn test_peep_fence_hot ( c :i -> :i )
  10
  c 0 <> if 20 else 30 then
  swap drop
  c 0 <> if 1 + then
  dup +
end

fn test_peep_fence_cold ( c :i -> :i )
  10
  c 0 <> if 20 else 30 then
  swap drop
  c 0 <> if 1 + then
  dup +
end

\ 8. 24-bit+ pointer bank-crossing tests (static +->, recursive +->, variable +->, imm a+/a-)
fn rec_step_a ( p :a n :i d :i -> :a )
  n 0 <= if p return then
  d 0 > if
    1 +-> p
  else
    -1 +-> p
  then
  p n 1 - d rec_step_a
end

fn test_bank_cross ( -> :i )
  var base_buf :bytes 4
  var bndry :a
  var p :a
  var lo :i
  var rem :i
  var one :i
  var neg1 :i
  size_a 3 < if 0 return then
  base_buf a>i -> lo
  0 lo - 0x7FFF and -> rem
  lo 0x8000 and 0 = if
    base_buf 32767 a+ 1 a+ rem a+ -> bndry
  else
    base_buf rem a+ -> bndry
  then
  \ Static local_add_imm across $xx:FFFF <-> $(xx+1):0000
  bndry 2 a- -> p
  1 +-> p
  p bndry a< 0 = if 40 return then
  1 +-> p
  p bndry a= 0 = if 41 return then
  1 +-> p
  p bndry 1 a+ a= 0 = if 42 return then
  -1 +-> p
  p bndry a= 0 = if 43 return then
  -1 +-> p
  p bndry 1 a- a= 0 = if 44 return then
  \ Recursive local_add_imm across boundary
  bndry 2 a- 3 1 rec_step_a bndry 1 a+ a= 0 = if 45 return then
  bndry 1 a+ 3 -1 rec_step_a bndry 2 a- a= 0 = if 46 return then
  \ Variable LOCAL_ADD across boundary
  1 -> one
  -1 -> neg1
  bndry 1 a- -> p
  one +-> p
  p bndry a= 0 = if 47 return then
  neg1 +-> p
  p bndry 1 a- a= 0 = if 48 return then
  \ Constant add_imm across boundary (including -32768)
  bndry 1 a- 1 a+ bndry a= 0 = if 49 return then
  bndry 1 a- 1 a+ bndry a<> if 50 return then
  bndry -32768 a+ 32767 a+ 1 a+ bndry a= 0 = if 51 return then
  0
end

\ 9. local_deref (LOCAL_GET :a + [const a+/a-] + @/!) static & recursive
fn static_deref_ops ( p :a -> :i )
  var q :a
  p 2 a+ -> q
  1234 p i16!
  -5678 q i16!
  -42 p 4 a+ i8!
  0xAB q 3 a+ i8!
  777 p 8 a+ !
  p i16@ q i16@ + p 4 a+ i8@ + q 3 a+ u8@ + q 2 a- i16@ + p 8 a+ @ +
end

fn rec_deref_ops ( p :a depth :i -> :i )
  var q :a
  depth 0 > if p depth 1 - rec_deref_ops return then
  p 2 a+ -> q
  2000 p i16!
  -500 q i16!
  -10 p 4 a+ i8!
  0xCD q 3 a+ i8!
  333 p 8 a+ !
  p i16@ q i16@ + p 4 a+ i8@ + q 3 a+ u8@ + q 2 a- i16@ + p 8 a+ @ +
end

fn main ( -> :i )
  10 1 hot_ladd 323 <> if 1 return then
  10 0 hot_ladd 11 <> if 2 return then
  10 1 cold_ladd 323 <> if 3 return then
  10 0 cold_ladd 11 <> if 4 return then
  d_a 1 hot_aadd d_a adiff 313 <> if 5 return then
  d_a 0 hot_aadd d_a adiff 1 <> if 6 return then

  100 1 test_add_imm 110 <> if 7 return then
  100 0 test_add_imm 120 <> if 8 return then
  100 1 test_sub_imm 90 <> if 9 return then
  100 0 test_sub_imm 80 <> if 10 return then
  1 test_aadd_imm 0x33 <> if 11 return then
  0 test_aadd_imm 0x22 <> if 12 return then
  1 test_asub_imm 0x22 <> if 13 return then
  0 test_asub_imm 0x33 <> if 14 return then

  5 1 test_cmp_imm 1 <> if 15 return then
  3 1 test_cmp_imm 0 <> if 16 return then
  3 0 test_cmp_imm 1 <> if 17 return then
  3 1 test_shift_imm 12 <> if 18 return then
  3 0 test_shift_imm 6 <> if 19 return then
  16 1 test_ushift_imm 4 <> if 20 return then
  16 0 test_ushift_imm 8 <> if 21 return then
  0x0F 1 test_bit_imm 0x05 <> if 22 return then
  0x0F 0 test_bit_imm 0x03 <> if 23 return then

  1 test_mem_imm 0xCC <> if 24 return then
  0 test_mem_imm 0xCC <> if 25 return then
  1 test_data_mem 0x11 <> if 26 return then
  0 test_data_mem 0x55 <> if 27 return then
  1 test_local_mem 0x42 0x77 + <> if 28 return then
  0 test_local_mem 0x99 0x88 + <> if 29 return then

  1 test_peep_fence_hot 42 <> if 30 return then
  0 test_peep_fence_hot 60 <> if 31 return then
  1 test_peep_fence_cold 42 <> if 32 return then
  0 test_peep_fence_cold 60 <> if 33 return then

  test_bank_cross -> var bc_err :i
  bc_err 0 <> if bc_err return then

  var dbuf :bytes 16
  dbuf static_deref_ops -2304 <> if 52 return then
  dbuf 2 rec_deref_ops 4028 <> if 53 return then

  0
end
