\ test_rtl.ir4 - Portable RTL tests (stdio.ir4, memory.ir4, heap.ir4)
\ Expected main() output ends with 0 (return code)

require "stdio.ir4"
require "memory.ir4"
require "heap.ir4"
require "string.ir4"

data s_exp "HiWorld" 0 :i8 end
data s_short "Hi" 0 :i8 end
data s_hi 0xFF :i8 0 :i8 end
data s_lo 0x01 :i8 0 :i8 end
data s_empty 0 :i8 end
data c_msg "RTL:" 0 :i8 end

var buf1 :bytes 16
var buf2 :bytes 16

fn assert_eq ( got :i expected :i code :i -> :i )
  got expected = if 0 return then
  code
end

fn test_rtl_bank_cross ( -> :i )
  var base :a
  var bndry :a
  var lo :i
  var rem :i
  target_65816 0 = if 0 return then
  __heap_start 256 a+ -> base
  base a>i -> lo
  0 lo - 0x7FFF and -> rem
  lo 0x8000 and 0 = if
    base 32767 a+ 1 a+ rem a+ -> bndry
  else
    base rem a+ -> bndry
  then
  \ memfill odd length straddling $xx:FFFF <-> $(xx+1):0000
  bndry 5 a- 11 0x5A memfill
  bndry 5 a- u8@ 0x5A 40 assert_eq
  dup 0 <> if return then drop
  bndry 1 a- u8@ 0x5A 41 assert_eq
  dup 0 <> if return then drop
  bndry u8@ 0x5A 42 assert_eq
  dup 0 <> if return then drop
  bndry 5 a+ u8@ 0x5A 43 assert_eq
  dup 0 <> if return then drop
  \ memcpy forward + memcmp across boundary
  bndry 3 a- s_exp 8 memcpy
  bndry 3 a- s_exp 8 memcmp 0 44 assert_eq
  dup 0 <> if return then drop
  \ strlen0 + strcmp0 across boundary ("HiWorld\0" starts at bndry-3, crosses bndry)
  bndry 3 a- strlen0 7 45 assert_eq
  dup 0 <> if return then drop
  bndry 3 a- s_exp strcmp0 0 46 assert_eq
  dup 0 <> if return then drop
  bndry 3 a- s_short strcmp0 0 > -1 47 assert_eq
  dup 0 <> if return then drop
  \ backward overlapping memcpy (+1 shift of 7 bytes across boundary)
  bndry 2 a- bndry 3 a- 7 memcpy
  bndry 2 a- s_exp 7 memcmp 0 48 assert_eq
  dup 0 <> if return then drop
  \ forward overlapping memcpy (-1 shift back across boundary)
  bndry 3 a- bndry 2 a- 7 memcpy
  bndry 3 a- s_exp 7 memcmp 0 49 assert_eq
  dup 0 <> if return then drop
  0
end

fn mutate_copy ( b :bytes 16 -> :i )
  99 b i8!
  b u8@
end

fn main ( -> :i )
  var p1 :a
  var p2 :a
  \ stdio formatting smoke test
  c_msg type0
  -42 typei
  32 emit
  65535 typeu
  32 emit
  7 4 typeiw
  32 emit
  0xBEEF 4 typehw
  32 emit

  \ memory.ir4: memfill, memcpy, memcmp
  buf1 8 65 memfill
  buf1 u8@ 65 1 assert_eq
  dup 0 <> if return then drop
  buf1 7 a+ u8@ 65 2 assert_eq
  dup 0 <> if return then drop

  buf2 buf1 8 memcpy
  buf1 buf2 8 memcmp 0 3 assert_eq
  dup 0 <> if return then drop

  66 buf2 3 a+ i8!
  buf1 buf2 8 memcmp 0 < -1 4 assert_eq
  dup 0 <> if return then drop

  \ overlapping memcpy (dst > src, e.g. shifting "HiWorld" right by 2 and by 1)
  buf2 s_exp 7 memcpy
  buf2 2 a+ buf2 7 memcpy
  buf2 2 a+ u8@ 72 15 assert_eq
  dup 0 <> if return then drop
  buf2 6 a+ u8@ 114 16 assert_eq
  dup 0 <> if return then drop
  buf2 s_exp 7 memcpy
  buf2 1 a+ buf2 7 memcpy
  buf2 1 a+ s_exp 7 memcmp 0 25 assert_eq
  dup 0 <> if return then drop
  \ overlapping memcpy (dst < src, shifting left by 1) + self copy + len <= 0
  buf2 buf2 1 a+ 7 memcpy
  buf2 s_exp 7 memcmp 0 26 assert_eq
  dup 0 <> if return then drop
  buf2 buf2 7 memcpy
  buf2 s_exp 7 memcmp 0 27 assert_eq
  dup 0 <> if return then drop
  buf2 0 99 memfill
  buf2 -3 99 memfill
  buf2 u8@ 72 28 assert_eq
  dup 0 <> if return then drop
  \ memcmp odd tail & unsigned high-bit bytes (0xFF vs 0x01)
  buf1 s_exp 7 memcpy
  buf2 s_exp 7 memcpy
  buf1 buf2 7 memcmp 0 29 assert_eq
  dup 0 <> if return then drop
  0xFF buf1 6 a+ i8!
  0x01 buf2 6 a+ i8!
  buf1 buf2 7 memcmp 0 > -1 30 assert_eq
  dup 0 <> if return then drop
  buf2 buf1 7 memcmp 0 < -1 31 assert_eq
  dup 0 <> if return then drop
  buf1 buf2 0 memcmp 0 32 assert_eq
  dup 0 <> if return then drop
  buf1 buf2 -2 memcmp 0 33 assert_eq
  dup 0 <> if return then drop

  \ heap.ir4: heapalloc / heapfree (with coalescing) / heapreset
  10 heapalloc -> p1
  4 heapalloc -> p2
  p2 p1 adiff 24 5 assert_eq
  dup 0 <> if return then drop
  p1 __heap_start 8 a+ a= -1 6 assert_eq
  dup 0 <> if return then drop
  p1 heapfree
  p2 heapfree
  32 heapalloc p1 a= -1 7 assert_eq
  dup 0 <> if return then drop
  heapreset
  8 heapalloc p1 a= -1 14 assert_eq
  dup 0 <> if return then drop

  cr

  \ :bytes parameter (copy-by-value into callee frame)
  2 buf1 i8!
  buf1 mutate_copy 99 17 assert_eq
  dup 0 <> if return then drop
  buf1 u8@ 2 18 assert_eq
  dup 0 <> if return then drop

  \ string.ir4: strlen0, str0>str
  s_exp strlen0 7 19 assert_eq
  dup 0 <> if return then drop
  s_empty strlen0 0 20 assert_eq
  dup 0 <> if return then drop
  s_exp str0>str -> var slen :i -> p1
  slen 7 21 assert_eq
  dup 0 <> if return then drop
  p1 s_exp a= -1 22 assert_eq
  dup 0 <> if return then drop
  s_empty str0>str -> slen -> p1
  slen 0 23 assert_eq
  dup 0 <> if return then drop
  p1 s_empty a= -1 24 assert_eq
  dup 0 <> if return then drop
  s_exp s_exp strcmp0 0 34 assert_eq
  dup 0 <> if return then drop
  s_short s_exp strcmp0 0 < -1 35 assert_eq
  dup 0 <> if return then drop
  s_exp s_short strcmp0 0 > -1 36 assert_eq
  dup 0 <> if return then drop
  s_hi s_lo strcmp0 0 > -1 37 assert_eq
  dup 0 <> if return then drop
  s_lo s_hi strcmp0 0 < -1 38 assert_eq
  dup 0 <> if return then drop
  test_rtl_bank_cross -> var berr :i
  berr 0 <> if berr return then
  0
end
