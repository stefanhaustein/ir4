\ fib.ir4 - Recursive and iterative Fibonacci in IR4th

fn fib_rec ( n :i -> :i )
  n 2 < if
    n return
  then
  n 1 - fib_rec
  n 2 - fib_rec
  +
end

fn fib_iter ( n :i -> :i )
  var a :i
  var b :i
  var tmp :i
  var i :i
  0 -> a
  1 -> b
  0 -> i
  begin
    i n <
  while
    a b + -> tmp
    b -> a
    tmp -> b
    i 1 + -> i
  repeat
  a
end

\ Entry point called by --run (checks fib_rec(10) = 55 and fib_iter(10) = 55; returns 0 on pass)
fn main ( -> :i )
  10 fib_rec 55 <> if 1 return then
  10 fib_iter 55 <> if 2 return then
  0
end
