\ test_core.ir4 - Core language, control-flow, ALU, comparison, and address tests
\ Expected main() return value: 0 (all checks pass)

fn assert_eq ( got :i expected :i code :i -> :i )
  got expected = if
    0 return
  then
  code
end

fn test_stack ( -> :i )
  \ dup, drop, swap
  10 dup + 20 1 assert_eq
  dup 0 <> if return then drop
  10 20 drop 10 2 assert_eq
  dup 0 <> if return then drop
  10 20 swap - 10 3 assert_eq
end

fn test_alu ( -> :i )
  0x0F 0x33 and 0x03 10 assert_eq
  dup 0 <> if return then drop
  0x0F 0x30 or 0x3F 11 assert_eq
  dup 0 <> if return then drop
  0xFF 0x0F xor 0xF0 12 assert_eq
  dup 0 <> if return then drop
  0 invert -1 13 assert_eq
  dup 0 <> if return then drop
  -1 invert 0 14 assert_eq
  dup 0 <> if return then drop
  3 4 << 48 15 assert_eq
  dup 0 <> if return then drop
  0x1230 4 u>> 0x0123 16 assert_eq
  dup 0 <> if return then drop
  -16 2 >> -4 17 assert_eq
  dup 0 <> if return then drop
  0xFF sext -1 18 assert_eq
  dup 0 <> if return then drop
  0x7F sext 127 19 assert_eq
end

fn test_cmp ( -> :i )
  5 5 = -1 20 assert_eq
  dup 0 <> if return then drop
  5 6 <> -1 21 assert_eq
  dup 0 <> if return then drop
  -5 3 < -1 22 assert_eq
  dup 0 <> if return then drop
  3 -5 > -1 23 assert_eq
  dup 0 <> if return then drop
  -5 -5 <= -1 24 assert_eq
  dup 0 <> if return then drop
  5 5 >= -1 25 assert_eq
  dup 0 <> if return then drop
  1 -1 u< -1 26 assert_eq
  dup 0 <> if return then drop
  -1 1 u> -1 27 assert_eq
  dup 0 <> if return then drop
  1 1 u<= -1 28 assert_eq
  dup 0 <> if return then drop
  -1 -1 u>= -1 29 assert_eq
end

fn test_addr ( -> :i )
  var p :a
  var q :a
  0x1000 i>a -> p
  p 16 a+ 4 a- -> q
  q p adiff 12 30 assert_eq
  dup 0 <> if return then drop
  p q a< -1 31 assert_eq
  dup 0 <> if return then drop
  q p a> -1 32 assert_eq
  dup 0 <> if return then drop
  p p a= -1 33 assert_eq
  dup 0 <> if return then drop
  p q a<> -1 34 assert_eq
  dup 0 <> if return then drop
  q a>i 0x100C 35 assert_eq
end

fn test_ctrl ( x :i -> :i )
  var acc :i
  \ if ... else ... then
  x 0 > if
    100
  else
    200
  then
  -> acc

  \ begin ... while ... repeat (sum 1..5 = 15)
  0 -> x
  begin
    x 5 <
  while
    x 1 + -> x
    acc x + -> acc
  repeat
  acc
end

fn pair_swap ( a :i b :i -> :i :i )
  b a
end

fwd is_odd ( n :i -> :i )

fn is_even ( n :i -> :i )
  n 0 = if 1 return then
  n 1 - is_odd
end

fn is_odd ( n :i -> :i )
  n 0 = if 0 return then
  n 1 - is_even
end

fn test_labels ( n :i -> :i )
  var acc :i
  var i :i
  \ Forward jz + jmp skipping block
  0 -> acc
  0 -> i
  n 0 = jz nonzero
  100 -> acc
  jmp loop
  :: nonzero
  200 -> acc
  :: loop
  i 5 < jz done
  i 1 + -> i
  acc i + -> acc
  jmp loop
  :: done
  \ Backward jz (post-test loop: add 1..3 = 6)
  0 -> i
  :: post
  i 1 + -> i
  acc i + -> acc
  i 3 = jz post
  acc
end

\ Exercise >4KB forward (if) and backward (jz) conditional branches on RV32
