fn test_inline_var ( n :i -> :i )
  10 20 + -> var base :i
  0 -> var acc :i
  0 -> var i :i
  begin
    i n <
  while
    i 2 * -> var doubled :i
    acc doubled + -> acc
    i 1 + -> i
  repeat
  base acc +
end

const CORE_C1 10 :i
const CORE_C2 32 :i
const CORE_C3 0x0100 :i
const CORE_ADDR 0x1234 :a
const CORE_I32 100000 :i32
const CORE_F1 2.5 :f
const CORE_F2 2 :f

fn test_jtab ( x :i -> :i )
  var res :i
  0 -> res
  x jtab jt_0 jt_1 jt_1 jt_2 end
  :: jt_0
    10 -> res
    jmp jt_done
  :: jt_1
    20 -> res
    \ intentional fallthrough
  :: jt_2
    res 5 + -> res
  :: jt_done
  res
end

fn ret4 ( a :i b :i c :i d :i -> :i :i :i :i )
  var sum :i
  a b + c + d + -> sum
  d c b sum
end

