fn test_inline_var ( n :i -> :i )
  10 20 + -> var base :i
  0 -> var acc :i
  0 -> var i :i
  begin
    i n <
  while
    i 2 * -> var doubled :i
    acc doubled + -> acc
    i 1 + -> i
  repeat
  base acc +
end

const CORE_C1 10 :i
const CORE_C2 32 :i
const CORE_C3 0x0100 :i
const CORE_ADDR 0x1234 :a
const CORE_I32 100000 :i32
const CORE_F1 2.5 :f
const CORE_F2 2 :f

fn test_jtab ( x :i -> :i )
  var res :i
  0 -> res
  x jtab jt_0 jt_1 jt_1 jt_2 end
  :: jt_0
    10 -> res
    jmp jt_done
  :: jt_1
    20 -> res
    \ intentional fallthrough
  :: jt_2
    res 5 + -> res
  :: jt_done
  res
end

fn main ( -> :i )
  test_stack
  dup 0 <> if return then drop
  test_alu
  dup 0 <> if return then drop
  test_cmp
  dup 0 <> if return then drop
  test_addr
  dup 0 <> if return then drop
  1 test_ctrl 115 40 assert_eq
  dup 0 <> if return then drop
  -1 test_ctrl 215 41 assert_eq
  dup 0 <> if return then drop
  10 20 pair_swap - 10 42 assert_eq
  dup 0 <> if return then drop
  7 is_odd 1 43 assert_eq
  dup 0 <> if return then drop
  8 is_even 1 44 assert_eq
  dup 0 <> if return then drop
  0 test_labels 121 45 assert_eq
  dup 0 <> if return then drop
  1 test_labels 221 46 assert_eq
  dup 0 <> if return then drop
  0 test_long_branch 542 47 assert_eq
  dup 0 <> if return then drop
  1 test_long_branch 500 48 assert_eq
  dup 0 <> if return then drop
  5 test_inline_var 50 49 assert_eq
  dup 0 <> if return then drop
  CORE_C1 CORE_C2 + 42 50 assert_eq
  dup 0 <> if return then drop
  CORE_C3 i>a a>i 256 51 assert_eq
  dup 0 <> if return then drop
  true -1 52 assert_eq
  dup 0 <> if return then drop
  false 0 53 assert_eq
  dup 0 <> if return then drop
  0 test_jtab 10 54 assert_eq
  dup 0 <> if return then drop
  1 test_jtab 25 55 assert_eq
  dup 0 <> if return then drop
  2 test_jtab 25 56 assert_eq
  dup 0 <> if return then drop
  3 test_jtab 5 57 assert_eq
  dup 0 <> if return then drop
  size_i 2 >= true 58 assert_eq
  dup 0 <> if return then drop
  size_a 2 >= true 59 assert_eq
  dup 0 <> if return then drop
  size_f 4 >= true 60 assert_eq
  dup 0 <> if return then drop
  target_z80 target_6502 or target_65816 or target_arm64 or target_rv32 or target_ez80 or target_bc or
  true 61 assert_eq
  dup 0 <> if return then drop
  0b101010 42 62 assert_eq
  dup 0 <> if return then drop
  -0b101 -5 63 assert_eq
  dup 0 <> if return then drop
  CORE_ADDR a>i 0x1234 64 assert_eq
  dup 0 <> if return then drop
  CORE_I32 100000 i>i32 i32= true 65 assert_eq
  dup 0 <> if return then drop
  CORE_F1 CORE_F2 f* 5.0 f= true 66 assert_eq
end
