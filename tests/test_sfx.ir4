\ Test lib/sfx.ir4 (sfxcount, sfxplay, sfxtick, sfxstop, bounds guards)

require "sfx.ir4"

fn main ( -> :i )
  sfxcount -> var cnt :i
  cnt 0 < if 1 return then

  target_c64 if cnt 3 <> if 2 return then then
  target_x16 if cnt 16 <> if 3 return then then
  target_agon if cnt 32 <> if 4 return then then
  target_c64 target_x16 or target_agon or 0 = if
    cnt 0 <> if 5 return then
  then

  \ Out-of-bounds channels must be safe no-ops
  -1 440 15 0 100 sfxplay
  cnt 440 15 0 100 sfxplay
  99 440 15 0 100 sfxplay
  -1 sfxstop
  cnt sfxstop
  99 sfxstop

  \ Clamped volumes, all waveforms, and duration timer countdown
  0 440 -5 0 0 sfxplay
  0 880 99 1 32 sfxplay
  0 220 8 2 16 sfxplay
  0 660 8 3 1 sfxplay
  0 500 8 7 0 sfxplay

  0 -> var i :i
  begin i 20 < while
    sfxtick
    1 +-> i
  repeat

  cnt 0 > if
    0 440 10 0 0 sfxplay
    cnt 1 - 523 10 2 50 sfxplay
    sfxtick
    0 sfxstop
    cnt 1 - sfxstop
  then

  \ Repeated play/tick/stop loop (50x catches stack leaks)
  0 -> i
  begin i 50 < while
    0 440 i 15 and i 3 and 16 sfxplay
    sfxtick
    0 sfxstop
    1 +-> i
  repeat

  0
end
