\ i32.ir4 - 32-bit integer (:i32) tests across all targets
\ Expected main() return value: 0

data g_val
  123456789 :i32
end

var g_buf :bytes 8

fn check32 ( got :i32 expected :i32 code :i -> :i )
  got expected i32= if
    0 return
  then
  code
end

fn checkw ( got :i expected :i code :i -> :i )
  got expected = if
    0 return
  then
  code
end

fn sum_local_i32 ( a :i32 b :i32 -> :i32 )
  var acc :i32
  a b i32+ -> acc
  acc 100000 i>i32 i32+ -> acc
  acc
end

fn main ( -> :i )
