\ Test lib/sys.ir4 (sysargc, sysargv, sysenv, sysenv0, syscwd, sysmillis, syssleep)

require "sys.ir4"

data str_alpha    "ALPHA" end
data str_beta     "BETA"  end
data env_path     "PATH"  end
data env_path0    "PATH"  0 :i8 end
data env_missing  "IR4TH_NO_SUCH_VAR_999" end
data env_missing0 "IR4TH_NO_SUCH_VAR_999" 0 :i8 end

var sysbuf  :bytes 64
var sysbuf2 :bytes 64

fn __sys_streq ( a :a alen :i b :a blen :i -> :i )
  alen blen <> if 0 return then
  0 -> var i :i
  begin i alen < while
    a i a+ u8@ b i a+ u8@ <> if 0 return then
    1 +-> i
  repeat
  1
end

fn main ( -> :i )
  sysargc -> var argc :i
  argc 0 < if 1 return then

  -1 sysbuf 32 sysargv 0 >= if 2 return then
  argc sysbuf 32 sysargv 0 >= if 3 return then
  argc 0 > if
    0 sysbuf 32 sysargv 0 < if 4 return then
  then

  argc 1 > if
    argc 3 < if 5 return then
    1 sysbuf 2 sysargv 2 <> if 6 return then
    sysbuf 2 str_alpha 2 __sys_streq 0 = if 7 return then
    1 sysbuf 32 sysargv -> var a1 :i
    sysbuf a1 str_alpha 5 __sys_streq 0 = if 8 return then
    2 sysbuf 32 sysargv -> var a2 :i
    sysbuf a2 str_beta 4 __sys_streq 0 = if 9 return then
  then

  env_missing 21 sysbuf 32 sysenv 0 >= if 10 return then
  env_missing0 sysbuf 32 sysenv0 0 >= if 11 return then
  env_path -1 sysbuf 32 sysenv 0 >= if 12 return then

  env_path 4 sysbuf 64 sysenv -> var e1 :i
  env_path0 sysbuf2 64 sysenv0 -> var e2 :i
  e1 e2 <> if 13 return then
  e1 0 >= if
    sysbuf e1 sysbuf2 e2 __sys_streq 0 = if 14 return then
    env_path 4 sysbuf 2 sysenv 2 > if 15 return then
    argc 3 <> if 16 return then
    0 sysbuf 64 sysargv 0 <= if 17 return then
    sysbuf 64 syscwd 0 <= if 18 return then
  then

  sysbuf -1 syscwd 0 >= if 19 return then
  sysbuf 64 syscwd -> var clen :i
  clen 0 >= if
    clen 0 = if 20 return then
    sysbuf2 1 syscwd 1 <> if 21 return then
    sysbuf2 u8@ sysbuf u8@ <> if 22 return then
  then

  0 syssleep
  -10 syssleep
  sysmillis -> var t0 :i32
  25 syssleep
  sysmillis -> var t1 :i32
  t1 t0 i32- 0 i>i32 i32< if 23 return then
  e1 0 >= if
    t1 t0 i32- 15 i>i32 i32< if 24 return then
  then

  0
end
